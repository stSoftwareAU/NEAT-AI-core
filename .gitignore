# Ignore invisible
.*
!.github
!.gitignore
!.codespellrc
!.markdownlint-cli2.jsonc

/target/
**/*.rs.bk
.DS_Store

# CI-only artefacts written by upgrade-dependencies.yml / cargo upgrade --dry-run
# and by deno-outdated.yml (Issue #646).
upgrade.log
upgrade-dry-run.txt
deno-outdated.log

# CycloneDX SBOMs are generated in CI (wasm-bundle.yml, Issue #125) and by the
# SBOM bats test; they are Release assets, never committed to the tree.
*.cdx.json

# Bytecode written when the vendored YAML parser is imported (Issue #642).
__pycache__/
*.pyc

# Code-graph cache written into the worktree by the graft tooling (Issue #728) —
# one generated Markdown file per source file, never committed. Listing it here
# rather than in .git/info/exclude is what keeps it out of the markdownlint gate,
# which reads .gitignore only.
/graft/
