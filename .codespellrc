[codespell]
skip = ./target,./.git
# Boolean flags: use `key =` with nothing after `=` (not `= true` — that breaks argparse).
check-filenames =
check-hidden =
# renderD: serde/JSON field name; mape: MAPE (mean absolute percentage error) acronym; indx: variable name from TypeScript code being referenced
ignore-words-list = renderD,mape,indx
