[codespell]
# ./graft — Issue #728: the graft code-graph cache is generated into the
# worktree and never committed, so CI (a fresh checkout) never sees it while a
# local run spell-checks its JSON index and reads the gate red.
skip = ./target,./.git,./graft
# Boolean flags: use `key =` with nothing after `=` (not `= true` — that breaks argparse).
check-filenames =
check-hidden =
# renderD: serde/JSON field name; mape: MAPE (mean absolute percentage error) acronym
# froms: variable name storing "from" versions in bump-deps.sh, intentional plural
# indx: variable name from TypeScript code being referenced
ignore-words-list = renderD,mape,froms,indx
