@@ -36,6 +45,58 @@ env:
   CARGO_TERM_COLOR: always
 
 jobs:
+  sparse-metal-research:
+    name: Scorer Metal supplement
+    if: github.event_name == 'workflow_dispatch' && inputs.sparse_metal
+    runs-on: macos-15
+    timeout-minutes: 35
+    permissions:
+      contents: read
+    env:
+      WGPU_BACKEND: metal
+    steps:
+      - name: Checkout frozen adapter
+        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+        with:
+          persist-credentials: false
+      - name: Install Rust
+        uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable
+        with:
+          toolchain: stable
+      - name: Measure existing scorer Metal backend
+        id: adapter
+        run: bash experiments/sparse_metal/run.sh < /dev/null
+      - name: Preserve Metal supplement including failed cells
+        if: always()
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: sparse-metal-supplement
+          path: sparse-metal-results/
+          if-no-files-found: error
+
+  metal-capability-probe:
+    name: Native Metal capability probe
+    if: github.event_name == 'workflow_dispatch' && inputs.metal_probe
+    runs-on: macos-15
+    timeout-minutes: 10
+    permissions:
+      contents: read
+    steps:
+      - name: Checkout capability probe
+        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6.0.2
+        with:
+          persist-credentials: false
+      - name: Query native Metal devices
+        id: query
+        run: mkdir metal-probe && swift --version > metal-probe/compiler.txt && sysctl -n machdep.cpu.brand_string > metal-probe/cpu.txt && uname -a > metal-probe/kernel.txt && git rev-parse HEAD > metal-probe/revision.txt && swift docs/research/sparse-precision/metal-probe.swift > metal-probe/result.json < /dev/null
+      - name: Preserve capability result
+        if: always()
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: metal-capability
+          path: metal-probe/
+          if-no-files-found: error
+
   version-increment:
     name: Auto-increment Versions
     runs-on: ubuntu-latest
