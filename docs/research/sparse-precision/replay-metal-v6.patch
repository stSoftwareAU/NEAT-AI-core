diff --git a/experiments/sparse_metal/run.sh b/experiments/sparse_metal/run.sh
new file mode 100755
index 0000000000000000000000000000000000000000..a8aad78c78398bc7c11714e0c0f3650aef5db7a4
--- /dev/null
+++ b/experiments/sparse_metal/run.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+TIMEOUT_CMD=""
+for candidate in timeout gtimeout; do
+  if command -v "$candidate" >/dev/null 2>&1; then
+    TIMEOUT_CMD="$candidate"
+    break
+  fi
+done
+bounded() {
+  local seconds="$1"
+  shift
+  if [[ -n "$TIMEOUT_CMD" ]]; then
+    "$TIMEOUT_CMD" "$seconds" "$@"
+  else
+    "$@"
+  fi
+}
+
+if ! git diff --quiet HEAD; then
+  echo "commit the Metal protocol and source before validation" >&2
+  exit 1
+fi
+mkdir sparse-metal-results
+git rev-parse HEAD > sparse-metal-results/revision.txt
+git hash-object experiments/sparse_metal/src/main.rs experiments/sparse_metal/Cargo.lock \
+  neat-core/benches/common/mod.rs neat-core/benches/sparse_precision/mod.rs \
+  docs/research/sparse-precision/manifest-metal-v6.json > sparse-metal-results/source-blobs.txt
+rustc -vV > sparse-metal-results/compiler.txt
+uname -a > sparse-metal-results/kernel.txt
+sysctl -n machdep.cpu.brand_string > sparse-metal-results/cpu.txt
+bounded 900 python3 scripts/sparse_precision_resources.py sparse-metal-results/build-rss.json \
+  cargo build --locked --release --manifest-path experiments/sparse_metal/Cargo.toml \
+  > sparse-metal-results/build-stdout.txt 2> sparse-metal-results/build-stderr.txt < /dev/null
+task_target=$(cargo metadata --locked --no-deps --format-version 1 \
+  --manifest-path experiments/sparse_metal/Cargo.toml | python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')
+bounded 900 python3 scripts/sparse_precision_resources.py sparse-metal-results/run-rss.json \
+  "$task_target/release/sparse-metal-experiment" \
+  docs/research/sparse-precision/manifest-metal-v6.json sparse-metal-results/results.json \
+  > sparse-metal-results/run-stdout.txt 2> sparse-metal-results/run-stderr.txt < /dev/null
diff --git a/experiments/sparse_metal/src/main.rs b/experiments/sparse_metal/src/main.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ef0e0bb432d329def823cec3fbc9baf65175a9fa
--- /dev/null
+++ b/experiments/sparse_metal/src/main.rs
@@ -0,0 +1,519 @@
+//! Opt-in adapter to the scorer's existing f32 Metal loss runner; no GPU kernel.
+#[path = "../../../neat-core/benches/common/mod.rs"]
+#[allow(dead_code)]
+mod common;
+#[path = "../../../neat-core/benches/sparse_precision/mod.rs"]
+// Match the root workspace's existing lint allowances for this frozen harness.
+#[allow(dead_code, clippy::too_many_arguments, clippy::manual_is_multiple_of)]
+mod sparse_precision;
+
+use common::{Lcg, NetSpec, build_network};
+use neat_core::loss::mse_sum_batch_packed;
+use neat_core::network::CompiledNetwork;
+use rust_scorer::cost::CostKind;
+use rust_scorer::gpu::device_loss::catch_gpu_panic;
+use rust_scorer::gpu::forward_mse_batched::BatchedRunner;
+use rust_scorer::gpu::{GpuBackendLabel, select_adapter};
+use serde_json::{Value, json};
+use sparse_precision::execution::flat_records;
+use sparse_precision::*;
+use std::sync::Arc;
+use std::time::Instant;
+
+fn validation_target_seed(m: &Manifest) -> u64 {
+    m.validation_record_seed.wrapping_add(m.calibration_seed)
+}
+
+fn require_metal(backend: Option<GpuBackendLabel>) -> Result<(), String> {
+    match backend {
+        Some(GpuBackendLabel::Metal) => Ok(()),
+        Some(other) => Err(format!(
+            "scorer selected {}, expected metal",
+            other.as_str()
+        )),
+        None => Err("scorer found no compatible GPU adapter".into()),
+    }
+}
+
+fn pack(records: &[f32], targets: &[f32], inputs: usize, outputs: usize) -> Vec<f32> {
+    assert_eq!(records.len() / inputs * outputs, targets.len());
+    records
+        .chunks_exact(inputs)
+        .zip(targets.chunks_exact(outputs))
+        .flat_map(|(r, t)| r.iter().copied().chain(t.iter().copied()))
+        .collect()
+}
+
+fn reference_loss(
+    net: &CompiledNetwork,
+    records: &[f32],
+    targets: &[f32],
+    outputs: usize,
+) -> Result<f64, String> {
+    let mut sum = 0.0;
+    for (record, target) in records
+        .chunks_exact(net.num_inputs())
+        .zip(targets.chunks_exact(outputs))
+    {
+        let predictions = reference_forward_f64(net, record, outputs)?;
+        sum += predictions
+            .iter()
+            .zip(target)
+            .map(|(x, t)| (x - f64::from(*t)).powi(2))
+            .sum::<f64>()
+            / outputs as f64;
+    }
+    Ok(sum)
+}
+
+fn check_loss(got: f64, expected: f64, records: usize, tolerance: f64) -> Result<f64, String> {
+    if !got.is_finite() || !expected.is_finite() {
+        return Err("non-finite loss or reference".into());
+    }
+    let error = (got - expected).abs() / records as f64;
+    if error > tolerance {
+        Err(format!("mean loss error {error} exceeds {tolerance}"))
+    } else {
+        Ok(error)
+    }
+}
+
+fn cpu_scan(
+    net: &mut CompiledNetwork,
+    records: &[f32],
+    inputs: usize,
+    outputs: usize,
+    width: usize,
+) -> f64 {
+    records
+        .chunks(width * (inputs + outputs))
+        .map(|chunk| mse_sum_batch_packed(net, chunk, inputs, outputs, true))
+        .sum()
+}
+
+fn gpu_scan(
+    runner: &mut BatchedRunner,
+    records: &[f32],
+    stride: usize,
+    width: usize,
+) -> Result<f64, String> {
+    let mut sum = 0.0;
+    for chunk in records.chunks(width * stride) {
+        let values = runner.score_chunk(chunk, chunk.len() / stride)?;
+        if values.len() != 1 {
+            return Err(format!(
+                "GPU returned {} creature sums, expected 1",
+                values.len()
+            ));
+        }
+        sum += values[0];
+    }
+    Ok(sum)
+}
+
+fn parts(net: &CompiledNetwork) -> CompiledNetwork {
+    CompiledNetwork::from_parts(
+        net.num_inputs(),
+        net.neurons().to_vec(),
+        net.synapses().to_vec(),
+    )
+    .unwrap()
+}
+
+fn classify(complete: bool, warm: RatioSummary, end: RatioSummary, threshold: f64) -> &'static str {
+    if !complete {
+        "incomplete"
+    } else if warm.ci_high <= threshold && end.ci_high <= threshold {
+        "both_faster"
+    } else {
+        "no_joint_win"
+    }
+}
+
+fn cell(
+    m: &Manifest,
+    graph: usize,
+    shape: &ShapeSpec,
+    fraction: f64,
+    width: usize,
+    ctx: Arc<rust_scorer::gpu::GpuContext>,
+) -> Result<Value, String> {
+    let start = Instant::now();
+    let spec = NetSpec {
+        label: "metal-manifest",
+        num_neurons: shape.num_neurons,
+        num_inputs: shape.num_inputs,
+        num_outputs: shape.num_outputs,
+        fan_in: shape.fan_in()?,
+    };
+    let (ni, no) = (shape.num_inputs, shape.num_outputs);
+    // Calibration uses a different network and records; it cannot select thresholds.
+    let calibration = build_network(&spec, m.calibration_seed.wrapping_add(graph as u64));
+    let cal_records = flat_records(m.calibration_records, ni, m.calibration_seed ^ 0xCA11);
+    let cal_targets = flat_records(m.calibration_records, no, 44004 ^ 0xCA11);
+    let mut cal_runner = BatchedRunner::new(
+        ctx.clone(),
+        std::slice::from_ref(&calibration),
+        ni,
+        no,
+        CostKind::Mse,
+    )
+    .map_err(|e| format!("calibration preparation: {e}"))?;
+    let cal_loss = gpu_scan(
+        &mut cal_runner,
+        &pack(&cal_records, &cal_targets, ni, no),
+        ni + no,
+        width,
+    )
+    .map_err(|e| format!("calibration scan: {e}"))?;
+    check_loss(
+        cal_loss,
+        reference_loss(&calibration, &cal_records, &cal_targets, no)?,
+        m.calibration_records,
+        m.criteria.tolerance_f32,
+    )
+    .map_err(|e| format!("calibration accuracy: {e}"))?;
+    drop(cal_runner);
+    let net = apply_sparsity(
+        &build_network(&spec, m.validation_seed.wrapping_add(graph as u64)),
+        fraction,
+        m.validation_seed
+            .wrapping_add(77)
+            .wrapping_add(graph as u64),
+    );
+    let inputs = flat_records(m.records_per_sample, ni, m.validation_record_seed);
+    let targets = flat_records(m.records_per_sample, no, validation_target_seed(m));
+    let expected = reference_loss(&net, &inputs, &targets, no)?;
+    let records = pack(&inputs, &targets, ni, no);
+    let preparation = Instant::now();
+    let mut gpu = BatchedRunner::new(
+        ctx.clone(),
+        std::slice::from_ref(&net),
+        ni,
+        no,
+        CostKind::Mse,
+    )
+    .map_err(|e| format!("validation preparation: {e}"))?;
+    let gpu_preparation_ns = preparation.elapsed().as_nanos() as u64;
+    let mut cpu = parts(&net);
+    let first = Instant::now();
+    let first_gpu =
+        gpu_scan(&mut gpu, &records, ni + no, width).map_err(|e| format!("first GPU scan: {e}"))?;
+    let first_gpu_ns = first.elapsed().as_nanos() as u64;
+    let gpu_error = check_loss(
+        first_gpu,
+        expected,
+        m.records_per_sample,
+        m.criteria.tolerance_f32,
+    )
+    .map_err(|e| format!("validation GPU accuracy: {e}"))?;
+    let cpu_error = check_loss(
+        cpu_scan(&mut cpu, &records, ni, no, width),
+        expected,
+        m.records_per_sample,
+        m.criteria.tolerance_f32,
+    )
+    .map_err(|e| format!("validation CPU accuracy: {e}"))?;
+    let prep_seconds = start.elapsed().as_secs_f64();
+    let (mut cpu_times, mut gpu_times, mut cpu_end, mut gpu_end) =
+        (Vec::new(), Vec::new(), Vec::new(), Vec::new());
+    for rep in 0..m.reps {
+        let gpu_first = Lcg::new(
+            m.shuffle_seed
+                .wrapping_add(graph as u64 * 1_000_003)
+                .wrapping_add(rep as u64),
+        )
+        .next_below(2)
+            == 1;
+        for is_gpu in if gpu_first {
+            [true, false]
+        } else {
+            [false, true]
+        } {
+            if is_gpu {
+                let t = Instant::now();
+                let got = gpu_scan(&mut gpu, &records, ni + no, width)?;
+                gpu_times.push(t.elapsed().as_nanos() as f64);
+                check_loss(
+                    got,
+                    expected,
+                    m.records_per_sample,
+                    m.criteria.tolerance_f32,
+                )?;
+                let t = Instant::now();
+                let compiled = parts(&net);
+                let mut fresh = BatchedRunner::new(
+                    ctx.clone(),
+                    std::slice::from_ref(&compiled),
+                    ni,
+                    no,
+                    CostKind::Mse,
+                )
+                .map_err(|e| e.to_string())?;
+                let got = gpu_scan(&mut fresh, &records, ni + no, width)?;
+                gpu_end.push(t.elapsed().as_nanos() as f64);
+                check_loss(
+                    got,
+                    expected,
+                    m.records_per_sample,
+                    m.criteria.tolerance_f32,
+                )?;
+            } else {
+                let t = Instant::now();
+                let got = cpu_scan(&mut cpu, &records, ni, no, width);
+                cpu_times.push(t.elapsed().as_nanos() as f64);
+                check_loss(
+                    got,
+                    expected,
+                    m.records_per_sample,
+                    m.criteria.tolerance_f32,
+                )?;
+                let t = Instant::now();
+                let mut fresh = parts(&net);
+                let got = cpu_scan(&mut fresh, &records, ni, no, width);
+                cpu_end.push(t.elapsed().as_nanos() as f64);
+                check_loss(
+                    got,
+                    expected,
+                    m.records_per_sample,
+                    m.criteria.tolerance_f32,
+                )?;
+            }
+        }
+        if start.elapsed().as_secs_f64() > m.max_cell_seconds {
+            break;
+        }
+    }
+    let complete = cpu_times.len() == m.reps;
+    let warm = paired_ratio_ci(
+        &gpu_times,
+        &cpu_times,
+        m.bootstrap_resamples,
+        m.bootstrap_seed,
+    );
+    let end = paired_ratio_ci(&gpu_end, &cpu_end, m.bootstrap_resamples, m.bootstrap_seed);
+    Ok(
+        json!({"shape":shape.label,"inactive_fraction":fraction,"batch_width":width,
+        "network_seed":m.validation_seed.wrapping_add(graph as u64),"record_seed":m.validation_record_seed,
+        "complete":complete,"reps_done":cpu_times.len(),"reps_planned":m.reps,
+        "reference_sum":expected,"gpu_mean_loss_error":gpu_error,"cpu_mean_loss_error":cpu_error,
+        "gpu_preparation_ns":gpu_preparation_ns,"first_gpu_scan_ns":first_gpu_ns,"preparation_seconds":prep_seconds,
+        "cpu_sample_ns":cpu_times,"gpu_sample_ns":gpu_times,"cpu_end_to_end_ns":cpu_end,"gpu_end_to_end_ns":gpu_end,
+        "warm_ratio":warm,"end_to_end_ratio":end,
+        "verdict":classify(complete,warm,end,m.criteria.speed_win_ratio)}),
+    )
+}
+
+fn run(manifest: Manifest) -> Value {
+    let started = Instant::now();
+    let init = catch_gpu_panic(select_adapter)
+        .map_err(|e| e.to_string())
+        .and_then(|r| r.map_err(|e| e.to_string()));
+    let mut result = json!({"schema_version":1,"protocol":"sparse-metal-v6","manifest":manifest,
+        "scorer_revision":"742c5df30fc98ece3afe784be1aca18f925b47b3","core_release":"v0.23.4",
+        "supported_variant":"canonical f32 scorer loss path; independently seeded targets, same batch width on CPU/GPU",
+        "target_seed":validation_target_seed(&manifest),
+        "unsupported":"alternate sparse layouts and bf16/f16 storage are not accepted by the scorer GPU API; v4 whole-scan control is not selected in this supplement",
+        "cells_planned":manifest.shapes.len()*manifest.inactive_fractions.len()*manifest.batch_widths.len(),
+        "cells":[],"failures":[],"not_run":[],
+        "unsupported_combinations":{"count":manifest.shapes.len()*manifest.batch_widths.len()*manifest.inactive_fractions.iter().map(|&f| sparse_precision::execution::variants(f).len()-2).sum::<usize>(),
+            "layouts":["csr_dst","coo_src","blocked4"],"precisions":["f32","bf16","f16"],"edge_modes":"all_edges and active_only where inactive_fraction > 0", "reason":"scorer GPU API accepts canonical f32 networks, not experimental layout or weight-storage types"},
+        "not_selected_controls":{"count":manifest.shapes.len()*manifest.inactive_fractions.len()*manifest.batch_widths.len(),"variant":"current_whole_scan","reason":"supplement chunks both CPU and GPU by requested width"}});
+    let ctx = match init {
+        Ok(ctx) => match require_metal(ctx.as_ref().map(|c| c.backend)) {
+            Ok(()) => Arc::new(ctx.unwrap()),
+            Err(e) => {
+                result["status"] = json!("unavailable");
+                result["initialisation_failure"] = json!(e);
+                return result;
+            }
+        },
+        Err(e) => {
+            result["status"] = json!("unavailable");
+            result["initialisation_failure"] = json!(e);
+            return result;
+        }
+    };
+    result["device_initialisation_ns"] = json!(started.elapsed().as_nanos() as u64);
+    result["backend"] = json!(ctx.backend.as_str());
+    result["max_storage_buffer_binding_size"] =
+        json!(ctx.device.limits().max_storage_buffer_binding_size);
+
+    for (si, shape) in manifest.shapes.iter().enumerate() {
+        for (fi, &fraction) in manifest.inactive_fractions.iter().enumerate() {
+            for &width in &manifest.batch_widths {
+                let id =
+                    json!({"shape":shape.label,"inactive_fraction":fraction,"batch_width":width});
+                if started.elapsed().as_secs_f64() > manifest.max_total_seconds {
+                    result["not_run"].as_array_mut().unwrap().push(id);
+                    continue;
+                }
+                let outcome = catch_gpu_panic(|| {
+                    cell(
+                        &manifest,
+                        si * manifest.inactive_fractions.len() + fi,
+                        shape,
+                        fraction,
+                        width,
+                        ctx.clone(),
+                    )
+                })
+                .map_err(|e| e.to_string())
+                .and_then(|r| r);
+                match outcome {
+                    Ok(value) => result["cells"].as_array_mut().unwrap().push(value),
+                    Err(reason) => result["failures"]
+                        .as_array_mut()
+                        .unwrap()
+                        .push(json!({"cell":id,"reason":reason})),
+                }
+            }
+        }
+    }
+    let incomplete = result["cells"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .any(|c| c["complete"] != true)
+        || !result["not_run"].as_array().unwrap().is_empty();
+    result["status"] = json!(if incomplete {
+        "incomplete"
+    } else if result["failures"].as_array().unwrap().is_empty() {
+        "complete"
+    } else {
+        "completed_with_failures"
+    });
+    result["wall_seconds"] = json!(started.elapsed().as_secs_f64());
+    result
+}
+
+fn main() -> Result<(), String> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args.len() != 2 {
+        return Err("usage: sparse-metal-experiment <manifest> <out>".into());
+    }
+    let manifest = parse_manifest(&std::fs::read_to_string(&args[0]).map_err(|e| e.to_string())?)?;
+    let result = run(manifest);
+    std::fs::write(&args[1], serde_json::to_string(&result).unwrap() + "\n")
+        .map_err(|e| e.to_string())?;
+    if result["status"] != "complete" {
+        return Err(format!(
+            "[EXPERIMENT_FAILURE] status={}; raw results saved",
+            result["status"]
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use neat_core::network::{NeuronData, SynapseData};
+
+    #[test]
+    fn packed_targets_and_independent_loss_preserve_record_boundaries() {
+        let net = CompiledNetwork::from_parts(
+            1,
+            vec![NeuronData {
+                squash_type: 0,
+                bias: 1.0,
+                start_synapse: 0,
+                num_synapses: 1,
+                is_constant: false,
+            }],
+            vec![SynapseData {
+                weight: 2.0,
+                from_index: 0,
+                synapse_type: 0,
+            }],
+        )
+        .unwrap();
+        // Outputs 3 and -1 against targets 1 and 2: (3-1)^2+(-1-2)^2=13.
+        assert_eq!(
+            pack(&[1.0, -1.0], &[1.0, 2.0], 1, 1),
+            vec![1.0, 1.0, -1.0, 2.0]
+        );
+        assert_eq!(
+            reference_loss(&net, &[1.0, -1.0], &[1.0, 2.0], 1).unwrap(),
+            13.0
+        );
+        assert_eq!(
+            cpu_scan(&mut net.clone(), &[1.0, 1.0, -1.0, 2.0], 1, 1, 1),
+            13.0
+        );
+    }
+
+    #[test]
+    fn gpu_selection_refuses_absence_and_another_backend_without_fallback() {
+        assert_eq!(require_metal(Some(GpuBackendLabel::Metal)), Ok(()));
+        assert_eq!(
+            require_metal(None),
+            Err("scorer found no compatible GPU adapter".into())
+        );
+        assert_eq!(
+            require_metal(Some(GpuBackendLabel::Vulkan)),
+            Err("scorer selected vulkan, expected metal".into())
+        );
+    }
+
+    #[test]
+    fn numerical_refusal_reports_the_error_and_cannot_treat_nan_as_success() {
+        assert_eq!(check_loss(10.0, 10.0, 2, 0.001), Ok(0.0));
+        assert!(
+            check_loss(12.0, 10.0, 2, 0.001)
+                .unwrap_err()
+                .contains("mean loss error 1 exceeds 0.001")
+        );
+        assert!(
+            check_loss(f64::NAN, 10.0, 2, 0.001)
+                .unwrap_err()
+                .contains("non-finite")
+        );
+        assert!(
+            check_loss(10.0, f64::INFINITY, 2, 0.001)
+                .unwrap_err()
+                .contains("non-finite")
+        );
+    }
+
+    #[test]
+    fn partial_samples_cannot_qualify_even_when_both_intervals_win() {
+        let fast = RatioSummary {
+            median_ratio: 0.5,
+            ci_low: 0.4,
+            ci_high: 0.6,
+        };
+        let uncertain = RatioSummary {
+            median_ratio: 0.8,
+            ci_low: 0.7,
+            ci_high: 0.95,
+        };
+        assert_eq!(classify(false, fast, fast, 0.9), "incomplete");
+        assert_eq!(classify(true, fast, fast, 0.9), "both_faster");
+        assert_eq!(classify(true, fast, uncertain, 0.9), "no_joint_win");
+        assert_eq!(classify(true, uncertain, fast, 0.9), "no_joint_win");
+    }
+    #[test]
+    fn v6_uses_fresh_inputs_targets_and_graphs_without_changing_acceptance() {
+        let before = parse_manifest(include_str!(
+            "../../../docs/research/sparse-precision/manifest-metal-v5.json"
+        ))
+        .unwrap();
+        let mut after = parse_manifest(include_str!(
+            "../../../docs/research/sparse-precision/manifest-metal-v6.json"
+        ))
+        .unwrap();
+        assert_ne!(before.validation_seed, after.validation_seed);
+        assert_ne!(before.validation_record_seed, after.validation_record_seed);
+        assert_eq!(validation_target_seed(&before), 44004);
+        assert_eq!(validation_target_seed(&after), 54004);
+        after.validation_seed = before.validation_seed;
+        after.validation_record_seed = before.validation_record_seed;
+        after.max_cell_seconds = before.max_cell_seconds;
+        after.max_total_seconds = before.max_total_seconds;
+        assert_eq!(
+            serde_json::to_value(after).unwrap(),
+            serde_json::to_value(before).unwrap()
+        );
+    }
+}
