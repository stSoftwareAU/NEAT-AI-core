+links the immutable tested replay revision, manifests, raw paired distributions,
+process/conversion memory evidence and reproduction commands. Ordinary benchmark
+commands and production behaviour are unchanged.
diff --git a/neat-core/benches/sparse_precision/execution.rs b/neat-core/benches/sparse_precision/execution.rs
new file mode 100644
index 0000000000000000000000000000000000000000..15cd23aa4e1a5fa7e4b7e8d169a32d32ef33cdb0
--- /dev/null
+++ b/neat-core/benches/sparse_precision/execution.rs
@@ -0,0 +1,140 @@
+//! Execution shared by the timing and separate allocation probes.
+
+use super::*;
+use crate::common::build_inputs;
+
+/// One variant of a cell: the baseline or a converted sparse network.
+pub(crate) enum Exec {
+    Current(Box<CompiledNetwork>),
+    CurrentWholeScan(Box<CompiledNetwork>),
+    Sparse(SparseNet, Scratch),
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct VariantSpec {
+    /// `None` is the baseline `current`.
+    pub(crate) config: Option<(Layout, Precision, bool)>,
+    pub(crate) whole_scan: bool,
+}
+
+impl VariantSpec {
+    pub(crate) fn name(&self) -> String {
+        match self.config {
+            None => if self.whole_scan {
+                "current_whole_scan"
+            } else {
+                "current"
+            }
+            .into(),
+            Some((l, p, a)) => format!(
+                "{}/{}/{}",
+                l.name(),
+                p.name(),
+                if a { "active_only" } else { "all_edges" }
+            ),
+        }
+    }
+
+    pub(crate) fn precision(&self) -> Precision {
+        self.config.map_or(Precision::F32, |c| c.1)
+    }
+
+    pub(crate) fn is_baseline(&self) -> bool {
+        self.config.is_none() && !self.whole_scan
+    }
+
+    pub(crate) fn prepare_current(&self, net: CompiledNetwork) -> Exec {
+        if self.whole_scan {
+            Exec::CurrentWholeScan(Box::new(net))
+        } else {
+            Exec::Current(Box::new(net))
+        }
+    }
+
+    pub(crate) fn convert(&self, net: &CompiledNetwork) -> Result<Exec, String> {
+        match self.config {
+            None => Ok(self.prepare_current(net.clone())),
+            Some((l, p, a)) => SparseNet::from_network(net, l, p, a)
+                .map(|s| Exec::Sparse(s, Scratch::default()))
+                .map_err(|e| e.to_string()),
+        }
+    }
+}
+
+impl Exec {
+    pub(crate) fn run(
+        &mut self,
+        records: &[f32],
+        stride: usize,
+        width: usize,
+        no: usize,
+        out: &mut [f32],
+    ) {
+        match self {
+            Exec::Current(net) => {
+                if width == 1 {
+                    for (r, o) in records.chunks(stride).zip(out.chunks_mut(no)) {
+                        net.activate_into(r, o);
+                    }
+                } else {
+                    for (r, o) in records
+                        .chunks(width * stride)
+                        .zip(out.chunks_mut(width * no))
+                    {
+                        net.score_records_flat_into(r, stride, no, o);
+                    }
+                }
+            }
+            Exec::CurrentWholeScan(net) => {
+                if width == 1 {
+                    for (r, o) in records.chunks(stride).zip(out.chunks_mut(no)) {
+                        net.activate_into(r, o);
+                    }
+                } else {
+                    net.score_records_flat_into(records, stride, no, out);
+                }
+            }
+            Exec::Sparse(s, scratch) => s.forward_batch(records, stride, width, scratch, out),
+        }
+    }
+
+    pub(crate) fn memory(&self) -> MemoryBreakdown {
+        match self {
+            Exec::Current(n) | Exec::CurrentWholeScan(n) => current_memory(n),
+            Exec::Sparse(s, _) => s.memory(),
+        }
+    }
+}
+
+pub(crate) fn variants(inactive: f64) -> Vec<VariantSpec> {
+    let mut v = vec![
+        VariantSpec {
+            config: None,
+            whole_scan: false,
+        },
+        VariantSpec {
+            config: None,
+            whole_scan: true,
+        },
+    ];
+    for l in Layout::ALL {
+        for p in Precision::ALL {
+            for a in [false, true] {
+                if a && inactive == 0.0 {
+                    continue; // identical to all_edges when no weight is zero
+                }
+                v.push(VariantSpec {
+                    config: Some((l, p, a)),
+                    whole_scan: false,
+                });
+            }
+        }
+    }
+    v
+}
+
+pub(crate) fn flat_records(count: usize, stride: usize, seed: u64) -> Vec<f32> {
+    (0..count)
+        .flat_map(|i| build_inputs(stride, seed.wrapping_add(i as u64)))
+        .collect()
+}
