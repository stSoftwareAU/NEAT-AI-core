+#!/usr/bin/env bats
+
+setup() {
+  load helpers
+  export REPO_ROOT="${BATS_TEST_DIRNAME}/../.."
+  export METAL_ADAPTER_CHECKER
+  METAL_ADAPTER_CHECKER=$(cat <<'PY'
+import os, yaml
+
+def validate(data):
+    on = data.get("on", data.get(True))
+    assert on["workflow_dispatch"]["inputs"]["sparse_metal"]["default"] is False
+    job = data["jobs"]["sparse-metal-research"]
+    assert job["if"] == "github.event_name == 'workflow_dispatch' && inputs.sparse_metal"
+    assert job["runs-on"] == "macos-15"
+    assert job["env"]["WGPU_BACKEND"] == "metal"
+    steps = job["steps"]
+    run = next(s for s in steps if s.get("id") == "adapter")
+    assert run["run"] == "bash experiments/sparse_metal/run.sh < /dev/null"
+    upload = next(s for s in steps if s.get("uses", "").startswith("actions/upload-artifact@"))
+    assert upload["if"] == "always()"
+    assert upload["with"]["path"] == "sparse-metal-results/"
+    assert upload["with"]["if-no-files-found"] == "error"
+
+with open(os.path.join(os.environ["REPO_ROOT"], ".github/workflows/ci.yml")) as source:
+    data = yaml.safe_load(source)
+validate(data)
+PY
+)
+}
+
+@test "Metal adapter is opt-in and preserves failed research evidence" {
+  run python3 -c "$METAL_ADAPTER_CHECKER"
+  [ "$status" -eq 0 ]
+  run assert_job_least_privilege "${REPO_ROOT}/.github/workflows/ci.yml" sparse-metal-research
+  [ "$status" -eq 0 ]
+}
+
+@test "Metal adapter validator refuses wrong backend, event and evidence settings" {
+  run python3 - <<'PY'
+import copy, os
+exec(os.environ["METAL_ADAPTER_CHECKER"])
+on = data.get("on", data.get(True))
+job = data["jobs"]["sparse-metal-research"]
+upload = next(s for s in job["steps"] if s.get("uses", "").startswith("actions/upload-artifact@"))
+adapter = next(s for s in job["steps"] if s.get("id") == "adapter")
+cases = [(job, "if", "true"), (job, "runs-on", "ubuntu-24.04"),
+         (job["env"], "WGPU_BACKEND", "vulkan"),
+         (on["workflow_dispatch"]["inputs"]["sparse_metal"], "default", True),
+         (adapter, "run", "true"), (upload, "if", "success()"),
+         (upload["with"], "path", "."), (upload["with"], "if-no-files-found", "ignore")]
+for target, key, wrong in cases:
+    original = copy.deepcopy(target[key])
+    target[key] = wrong
+    try:
+        validate(data)
+    except AssertionError:
+        pass
+    else:
+        raise AssertionError(f"accepted incorrect {key}: {wrong!r}")
+    finally:
+        target[key] = original
+PY
+  [ "$status" -eq 0 ]
+}
