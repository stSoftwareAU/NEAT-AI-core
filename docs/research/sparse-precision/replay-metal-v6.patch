+#!/usr/bin/env bats
+
+setup() {
+  load helpers
+  export REPO_ROOT="${BATS_TEST_DIRNAME}/../.."
+  export METAL_WORKFLOW_CHECKER
+  METAL_WORKFLOW_CHECKER=$(cat <<'PY'
+import os, yaml
+
+def validate(data):
+    on = data.get("on", data.get(True))
+    assert on["workflow_dispatch"]["inputs"]["metal_probe"] == {
+        "description": "Query native Metal device availability", "type": "boolean", "default": False}
+    job = data["jobs"]["metal-capability-probe"]
+    assert job["if"] == "github.event_name == 'workflow_dispatch' && inputs.metal_probe"
+    assert job["runs-on"] == "macos-15"
+    assert job["permissions"] == {"contents": "read"}
+    query = next(s for s in job["steps"] if s.get("id") == "query")
+    assert query["run"] == 'mkdir metal-probe && swift --version > metal-probe/compiler.txt && sysctl -n machdep.cpu.brand_string > metal-probe/cpu.txt && uname -a > metal-probe/kernel.txt && git rev-parse HEAD > metal-probe/revision.txt && swift docs/research/sparse-precision/metal-probe.swift > metal-probe/result.json < /dev/null'
+    upload = next(s for s in job["steps"] if s.get("uses", "").startswith("actions/upload-artifact@"))
+    assert upload["if"] == "always()"
+    assert upload["with"]["path"] == "metal-probe/"
+    assert upload["with"]["if-no-files-found"] == "error"
+
+with open(os.path.join(os.environ["REPO_ROOT"], ".github/workflows/ci.yml")) as source:
+    data = yaml.safe_load(source)
+validate(data)
+PY
+)
+}
+
+@test "Metal capability probe is opt-in and preserves the real query result" {
+  run python3 -c "$METAL_WORKFLOW_CHECKER"
+  [ "$status" -eq 0 ]
+}
+
+@test "Metal capability validator refuses incorrect opt-in and artefact settings" {
+  run python3 - <<'PY'
+import copy, os
+exec(os.environ["METAL_WORKFLOW_CHECKER"])
+on = data.get("on", data.get(True))
+job = data["jobs"]["metal-capability-probe"]
+upload = next(s for s in job["steps"] if s.get("uses", "").startswith("actions/upload-artifact@"))
+query = next(s for s in job["steps"] if s.get("id") == "query")
+cases = [(job, "if", "true"), (job, "runs-on", "ubuntu-24.04"),
+         (job, "permissions", {"contents": "write"}),
+         (on["workflow_dispatch"]["inputs"]["metal_probe"], "default", True),
+         (query, "run", "true"), (upload, "if", "success()"),
+         (upload["with"], "path", "."), (upload["with"], "if-no-files-found", "ignore")]
+for target, key, wrong in cases:
+    original = copy.deepcopy(target[key])
+    target[key] = wrong
+    try:
+        validate(data)
+    except AssertionError:
+        pass
+    else:
+        raise AssertionError(f"accepted incorrect {key}: {wrong!r}")
+    finally:
+        target[key] = original
+PY
+  [ "$status" -eq 0 ]
+}
