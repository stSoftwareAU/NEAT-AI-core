index 0000000000000000000000000000000000000000..c174823cd0df6e6aa6a9af42b2980f4d4793baa6
--- /dev/null
+++ b/neat-core/benches/sparse_precision/allocation.rs
@@ -0,0 +1,145 @@
+//! Requested heap bytes, measured only by the separate memory executable.
+
+use serde::Serialize;
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::sync::atomic::{AtomicUsize, Ordering::SeqCst};
+
+#[derive(Default)]
+pub(crate) struct CountingAllocator {
+    live: AtomicUsize,
+    peak: AtomicUsize,
+}
+
+#[derive(Debug, Serialize)]
+pub(crate) struct AllocationPeak {
+    pub live_before_bytes: usize,
+    pub live_after_bytes: usize,
+    pub peak_live_bytes: usize,
+    pub additional_peak_bytes: usize,
+}
+
+impl CountingAllocator {
+    pub const fn new() -> Self {
+        Self {
+            live: AtomicUsize::new(0),
+            peak: AtomicUsize::new(0),
+        }
+    }
+
+    fn add(&self, bytes: usize) {
+        let live = self.live.fetch_add(bytes, SeqCst) + bytes;
+        self.peak.fetch_max(live, SeqCst);
+    }
+
+    /// The probe is single-threaded; callers must not overlap measurement scopes.
+    pub fn measure<T>(&self, f: impl FnOnce() -> T) -> (T, AllocationPeak) {
+        let before = self.live.load(SeqCst);
+        self.peak.store(before, SeqCst);
+        let result = f();
+        let after = self.live.load(SeqCst);
+        let peak = self.peak.load(SeqCst);
+        (
+            result,
+            AllocationPeak {
+                live_before_bytes: before,
+                live_after_bytes: after,
+                peak_live_bytes: peak,
+                additional_peak_bytes: peak.saturating_sub(before),
+            },
+        )
+    }
+}
+
+// SAFETY: every allocation is forwarded unchanged to System; counters never allocate.
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: the caller supplies the valid allocation layout.
+        let ptr = unsafe { System.alloc(layout) };
+        if !ptr.is_null() {
+            self.add(layout.size());
+        }
+        ptr
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        // SAFETY: the caller supplies the valid allocation layout.
+        let ptr = unsafe { System.alloc_zeroed(layout) };
+        if !ptr.is_null() {
+            self.add(layout.size());
+        }
+        ptr
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        self.live.fetch_sub(layout.size(), SeqCst);
+        // SAFETY: the pointer and layout belong to this System-backed allocator.
+        unsafe { System.dealloc(ptr, layout) }
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+        // SAFETY: the caller supplies an owned pointer, its layout and a valid size.
+        let replacement = unsafe { System.realloc(ptr, layout, size) };
+        if !replacement.is_null() {
+            if size >= layout.size() {
+                self.add(size - layout.size());
+            } else {
+                self.live.fetch_sub(layout.size() - size, SeqCst);
+            }
+        }
+        replacement
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn conversion_peak_includes_temporaries_and_preserves_the_parent_allocation() {
+        let allocator = CountingAllocator::default();
+        let parent = Layout::from_size_align(32, 8).unwrap();
+        let temp = Layout::from_size_align(64, 8).unwrap();
+        let result = Layout::from_size_align(16, 8).unwrap();
+        // SAFETY: each successful allocation is freed once with its original layout.
+        unsafe {
+            let p = allocator.alloc(parent);
+            assert!(!p.is_null());
+            let (r, peak) = allocator.measure(|| {
+                let t = allocator.alloc(temp);
+                let r = allocator.alloc_zeroed(result);
+                assert!(!t.is_null() && !r.is_null());
+                allocator.dealloc(t, temp);
+                r
+            });
+            assert_eq!(peak.live_before_bytes, 32);
+            assert_eq!(peak.live_after_bytes, 32 + 16);
+            assert_eq!(peak.peak_live_bytes, 32 + 64 + 16);
+            assert_eq!(peak.additional_peak_bytes, 64 + 16);
+            allocator.dealloc(r, result);
+            allocator.dealloc(p, parent);
+            let (_, empty) = allocator.measure(|| ());
+            assert_eq!(empty.peak_live_bytes, 0);
+        }
+    }
+
+    #[test]
+    fn growing_and_shrinking_an_allocation_updates_live_bytes() {
+        let allocator = CountingAllocator::default();
+        let small = Layout::from_size_align(16, 8).unwrap();
+        let large = Layout::from_size_align(128, 8).unwrap();
+        // SAFETY: reallocations retain alignment; each call uses the current layout.
+        unsafe {
+            let p = allocator.alloc(small);
+            assert!(!p.is_null());
+            let (p, growth) = allocator.measure(|| allocator.realloc(p, small, 128));
+            assert!(!p.is_null());
+            assert_eq!(growth.additional_peak_bytes, 128 - 16);
+            assert_eq!(growth.live_after_bytes, 128);
+            let (p, shrink) = allocator.measure(|| allocator.realloc(p, large, 16));
+            assert!(!p.is_null());
+            assert_eq!(shrink.additional_peak_bytes, 0);
+            assert_eq!(shrink.live_after_bytes, 16);
+            allocator.dealloc(p, small);
+        }
+    }
+}
