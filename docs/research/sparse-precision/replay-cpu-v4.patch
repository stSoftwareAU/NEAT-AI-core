+#[test]
+fn memory_accounting_follows_edge_counts_and_padding() {
+    // 2 inputs; neuron 2 has 5 edges, neuron 3 has 4, neuron 4 has 1 (10 edges).
+    // Blocked4 pads rows to multiples of 4: 5 -> 8 (3), 4 -> 4 (0), 1 -> 4 (3), so
+    // 6 padding slots and 16 slots in total.
+    let syns: Vec<SynapseData> = (0..10)
+        .map(|i| syn(0.1 + i as f32 * 0.01, (i % 2) as u16))
+        .collect();
+    let mut syns = syns;
+    syns[9].from_index = 3; // neuron 4 reads neuron 3 (feed-forward)
+    let net = CompiledNetwork::from_parts(
+        2,
+        vec![
+            neuron(0.0, 0, 5, SquashType::Tanh),
+            neuron(0.0, 5, 4, SquashType::Tanh),
+            neuron(0.0, 9, 1, SquashType::Tanh),
+        ],
+        syns,
+    )
+    .unwrap();
+    let csr = SparseNet::from_network(&net, Layout::CsrDst, Precision::F32, false)
+        .unwrap()
+        .memory();
+    assert_eq!(csr.weight_bytes, 4 * 10);
+    assert_eq!(csr.edges, 10);
+    // row_ptr has 3 + 1 u32 offsets, col has 10 u16.
+    assert_eq!(csr.index_bytes, 4 * 4 + 2 * 10);
+    let bf = SparseNet::from_network(&net, Layout::CsrDst, Precision::Bf16, false)
+        .unwrap()
+        .memory();
+    assert_eq!(bf.weight_bytes, 2 * 10);
+    let blk = SparseNet::from_network(&net, Layout::Blocked4, Precision::F32, false)
+        .unwrap()
+        .memory();
+    assert_eq!(blk.padding_slots, 6);
+    assert_eq!(blk.weight_bytes, 4 * 16);
+    assert_eq!(blk.edges, 10);
+    let coo = SparseNet::from_network(&net, Layout::CooSrc, Precision::F16, false)
+        .unwrap()
+        .memory();
+    assert_eq!(coo.weight_bytes, 2 * 10);
+    assert_eq!(coo.index_bytes, 4 * 10);
+    // Current: 8 B weight-side and 6 B index-side per synapse (see current_memory).
+    let cur = current_memory(&net);
+    assert_eq!((cur.weight_bytes, cur.index_bytes), (8 * 10, 6 * 10));
+}
