new file mode 100644
index 0000000000000000000000000000000000000000..650265fa0d80d714fad40b14485fae2779e0a7e3
--- /dev/null
+++ b/tests/scripts/sparse_precision_workflow.bats
@@ -0,0 +1,50 @@
+#!/usr/bin/env bats
+
+setup() {
+  load helpers
+  export REPO_ROOT="${BATS_TEST_DIRNAME}/../.."
+  export PYTHONPATH="${REPO_ROOT}/tests/scripts/lib${PYTHONPATH:+:${PYTHONPATH}}"
+}
+
+@test "research driver checks platform units and failed research results" {
+  run deno test "${REPO_ROOT}/tests/sparse_precision_runner_test.ts"
+  [ "$status" -eq 0 ]
+}
+
+@test "research workflow is opt-in and preserves both platform artefacts on failure" {
+  run python3 - <<'PYTEST'
+import copy, os, yaml
+from sparse_precision_workflow import validate
+with open(os.path.join(os.environ["REPO_ROOT"], ".github/workflows/ci.yml")) as source:
+    data = yaml.safe_load(source)
+validate(data)
+# Each load-bearing setting is refused when it loses its contract.
+job = data["jobs"]["sparse-precision-research"]
+triggers = data.get("on", data.get(True))
+cases = [
+    (job, "if", "true"),
+    (triggers["workflow_dispatch"]["inputs"]["sparse_precision"], "default", True),
+    (job["strategy"]["matrix"], "runner", ["ubuntu-24.04"]),
+    (job["strategy"], "fail-fast", True),
+    (job, "permissions", {"contents": "write"}),
+    (job, "timeout-minutes", 5),
+    (next(s for s in job["steps"] if s.get("id") == "research"), "run", "true"),
+]
+upload = next(s for s in job["steps"] if s.get("uses", "").startswith("actions/upload-artifact@"))
+cases += [(upload, "if", "success()"), (upload["with"], "path", "."),
+          (upload["with"], "if-no-files-found", "ignore")]
+for target, field, wrong in cases:
+    original = copy.deepcopy(target[field])
+    target[field] = wrong
+    try:
+        validate(data)
+    except AssertionError:
+        pass
+    else:
+        raise AssertionError(f"validator accepted wrong {field}: {wrong!r}")
+    finally:
+        target[field] = original
+validate(data)
+PYTEST
+  [ "$status" -eq 0 ]
+}
