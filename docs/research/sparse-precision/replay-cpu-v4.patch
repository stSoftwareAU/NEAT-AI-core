index 0000000000000000000000000000000000000000..433eb148739584b35e8e7bcbf9d6136d4febca28
--- /dev/null
+++ b/neat-core/benches/sparse_precision/mod.rs
@@ -0,0 +1,1236 @@
+//! Opt-in research harness for Issue #758: do sparse layouts and reduced-precision
+//! weight storage beat the current `CompiledNetwork` forward pass, end to end?
+//!
+//! This is a **measurement** library. It changes no public API of `neat-core` and
+//! no default; it lives in `benches/sparse_precision/` (a subdirectory, so Cargo
+//! does not auto-discover it as a bench target) and is included by
+//! `tests/sparse_precision_experiment.rs`, `examples/sparse_precision_experiment.rs`
+//! and `examples/sparse_precision_memory.rs` through `#[path]`, the same pattern
+//! as `benches/common/mod.rs`. The includers declare `mod common;` at the crate
+//! root, which is where `crate::common` below resolves.
+//!
+//! Scope, stated once:
+//!
+//! - **Feed-forward only.** Every edge must satisfy `from < destination` (global
+//!   indices). A backward or self edge is refused for every layout.
+//! - **Standard weighted-sum neurons only.** Aggregate squashes (Minimum, Maximum,
+//!   If, Hypotenuse, HypotenuseV2, Mean) are refused. A *constant* neuron is
+//!   supported: its squash is never read, so its activation is
+//!   `limit_range(Identity, bias)` whatever squash it declares, and its edges
+//!   (never read by `CompiledNetwork`) are not carried.
+//! - **Reduced precision is weight storage only.** Weights are stored as `u16`
+//!   bit patterns and decoded to `f32` for the multiply; all accumulation, all
+//!   activations and all biases stay `f32`.
+
+#![allow(clippy::needless_range_loop)]
+
+pub(crate) mod execution;
+
+use crate::common::{FanIn, Lcg};
+use neat_core::network::{CompiledNetwork, MAX_NODE_COUNT, SynapseData};
+use neat_core::range::{apply_get_range, apply_limit_range_bounds};
+use neat_core::squash::{SquashType, apply_squash};
+use serde::{Deserialize, Serialize};
+
+// ---------------------------------------------------------------------------
+// Software codecs (stable Rust has no `f16` primitive)
+// ---------------------------------------------------------------------------
+
+/// `f32` to bfloat16, round-to-nearest-even. NaN stays NaN (forced quiet), the
+/// infinities are preserved, and a finite value that rounds past the largest
+/// bfloat16 becomes an infinity.
+pub fn f32_to_bf16(value: f32) -> u16 {
+    let bits = value.to_bits();
+    if value.is_nan() {
+        // Keep the sign and top payload bits, set the quiet bit so a payload that
+        // lived only in the discarded low half cannot truncate to an infinity.
+        return ((bits >> 16) | 0x0040) as u16;
+    }
+    let lsb = (bits >> 16) & 1;
+    // Adding 0x7FFF plus the retained LSB rounds ties to even.
+    (bits.wrapping_add(0x7FFF + lsb) >> 16) as u16
+}
+
+/// bfloat16 to `f32`: exact, the 16 bits are the top half of the `f32`.
+pub fn bf16_to_f32(bits: u16) -> f32 {
+    f32::from_bits((bits as u32) << 16)
+}
+
+/// `f32` to IEEE 754 binary16, round-to-nearest-even, including subnormals.
+/// Overflow becomes an infinity of the same sign; NaN becomes a quiet NaN.
+pub fn f32_to_f16(value: f32) -> u16 {
+    let bits = value.to_bits();
+    let sign = ((bits >> 16) & 0x8000) as u16;
+    let exp = ((bits >> 23) & 0xFF) as i32;
+    let man = bits & 0x007F_FFFF;
+
+    if exp == 0xFF {
+        if man == 0 {
+            return sign | 0x7C00;
+        }
+        return sign | 0x7E00 | (man >> 13) as u16;
+    }
+
+    // Re-bias from 127 to 15.
+    let e = exp - 127 + 15;
+    if e >= 31 {
+        return sign | 0x7C00;
+    }
+    if e <= 0 {
+        // Subnormal result (or zero). The 24-bit significand `m` times
+        // 2^(exp-150), in units of 2^-24, is `m >> (14 - e)`.
+        if e < -10 {
+            return sign;
+        }
+        let m = man | 0x0080_0000;
+        let shift = (14 - e) as u32;
+        let mut q = m >> shift;
+        let rem = m & ((1u32 << shift) - 1);
+        let half = 1u32 << (shift - 1);
+        if rem > half || (rem == half && (q & 1) == 1) {
+            q += 1; // may carry into the smallest normal, which is correct
+        }
+        return sign | q as u16;
+    }
+
+    let mut h = ((e as u32) << 10) | (man >> 13);
+    let rem = man & 0x1FFF;
+    if rem > 0x1000 || (rem == 0x1000 && (h & 1) == 1) {
+        h += 1; // a carry into the exponent (and on to infinity) is correct
+    }
+    sign | h as u16
+}
+
+/// IEEE 754 binary16 to `f32`: exact for normals, subnormals, infinities, NaN.
+pub fn f16_to_f32(bits: u16) -> f32 {
+    let sign = ((bits as u32) & 0x8000) << 16;
+    let exp = ((bits >> 10) & 0x1F) as u32;
+    let man = (bits & 0x03FF) as u32;
+    match exp {
+        0 => {
+            // value = man * 2^-24, exact in f32.
+            let magnitude = man as f32 * (1.0 / 16_777_216.0);
+            f32::from_bits(magnitude.to_bits() | sign)
+        }
+        31 => {
+            if man == 0 {
+                f32::from_bits(sign | 0x7F80_0000)
+            } else {
+                f32::from_bits(sign | 0x7FC0_0000 | (man << 13))
+            }
+        }
+        _ => f32::from_bits(sign | ((exp + 112) << 23) | (man << 13)),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Weight representations (monomorphised, so precision is never a per-weight branch)
+// ---------------------------------------------------------------------------
+
+/// A stored weight that decodes to `f32` for the multiply.
+pub trait WeightRepr: Copy {
+    /// Bytes one stored weight occupies.
+    const BYTES: usize;
+    fn encode(weight: f32) -> Self;
+    fn to_f32(self) -> f32;
+}
+
+impl WeightRepr for f32 {
+    const BYTES: usize = 4;
+    #[inline(always)]
+    fn encode(weight: f32) -> Self {
+        weight
+    }
+    #[inline(always)]
+    fn to_f32(self) -> f32 {
+        self
+    }
+}
+
+/// bfloat16 weight storage.
+#[derive(Clone, Copy)]
+pub struct Bf16(u16);
+
+impl WeightRepr for Bf16 {
+    const BYTES: usize = 2;
+    #[inline(always)]
+    fn encode(weight: f32) -> Self {
+        Bf16(f32_to_bf16(weight))
+    }
+    #[inline(always)]
+    fn to_f32(self) -> f32 {
+        bf16_to_f32(self.0)
+    }
+}
+
+/// IEEE binary16 weight storage.
+#[derive(Clone, Copy)]
+pub struct F16(u16);
+
+impl WeightRepr for F16 {
+    const BYTES: usize = 2;
+    #[inline(always)]
+    fn encode(weight: f32) -> Self {
+        F16(f32_to_f16(weight))
+    }
+    #[inline(always)]
+    fn to_f32(self) -> f32 {
+        f16_to_f32(self.0)
+    }
+}
+
+/// Weight storage precision. Accumulation is always `f32`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+pub enum Precision {
+    F32,
+    Bf16,
+    F16,
+}
+
+impl Precision {
+    pub const ALL: [Precision; 3] = [Precision::F32, Precision::Bf16, Precision::F16];
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Precision::F32 => "f32",
+            Precision::Bf16 => "bf16",
+            Precision::F16 => "f16",
+        }
+    }
+}
+
+/// Sparse edge layout under test (the baseline `current` is the real
+/// `CompiledNetwork`, handled by the runner).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+pub enum Layout {
+    /// Destination-grouped CSR owned by the experiment, plain scalar kernel.
+    /// Same CSR family as current, with different metadata and kernel code.
+    CsrDst,
+    /// Source-sorted COO triples with no offset array; push/scatter forward pass.
+    CooSrc,
+    /// Per-destination rows packed into fixed 4-wide blocks, the last block of a
+    /// row padded with weight 0 and source 0.
+    Blocked4,
+}
+
+impl Layout {
+    pub const ALL: [Layout; 3] = [Layout::CsrDst, Layout::CooSrc, Layout::Blocked4];
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Layout::CsrDst => "csr_dst",
+            Layout::CooSrc => "coo_src",
+            Layout::Blocked4 => "blocked4",
+        }
+    }
+}
+
+/// Block width of [`Layout::Blocked4`].
+pub const BLOCK: usize = 4;
+
+// ---------------------------------------------------------------------------
+// Conversion
+// ---------------------------------------------------------------------------
+
+/// Why a network cannot be represented in the experiment.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ConvertError {
+    /// A non-constant neuron uses an aggregate squash. `neuron` is the **global**
+    /// neuron index (inputs included).
+    AggregateSquash { neuron: usize, squash: u8 },
+    /// An edge does not satisfy `from < to` (global indices).
+    NotFeedForward { from: usize, to: usize },
+    /// A value would be hidden by a saturating activation or range clamp.
+    InvalidNumber { neuron: usize, reason: &'static str },
+}
+
+impl std::fmt::Display for ConvertError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            ConvertError::AggregateSquash { neuron, squash } => write!(
+                f,
+                "neuron {neuron} uses aggregate squash {squash}; the experiment covers standard \
+                 weighted-sum neurons only"
+            ),
+            ConvertError::InvalidNumber { neuron, reason } => {
+                write!(f, "neuron {neuron}: {reason}")
+            }
+            ConvertError::NotFeedForward { from, to } => write!(
+                f,
+                "edge {from} -> {to} is not feed-forward (from must be below the destination)"
+            ),
+        }
+    }
+}
+
+impl std::error::Error for ConvertError {}
+
+/// Per-neuron data the experiment keeps: bias and the squash. A constant neuron
+/// is stored as `Identity` with no edges, which yields `limit_range(Identity,
+/// bias)` exactly as `CompiledNetwork` does.
+#[derive(Clone, Copy)]
+pub struct SparseNeuron {
+    pub bias: f32,
+    pub squash: SquashType,
+}
+
+enum Edges<W> {
+    Csr {
+        row_ptr: Vec<u32>,
+        col: Vec<u16>,
+        w: Vec<W>,
+    },
+    Coo {
+        src: Vec<u16>,
+        dst: Vec<u16>,
+        w: Vec<W>,
+    },
+    Blocked {
+        row_block_ptr: Vec<u32>,
+        cols: Vec<u16>,
+        w: Vec<W>,
+        edges: usize,
+    },
+}
+
+enum EdgeStore {
+    F32(Edges<f32>),
+    Bf16(Edges<Bf16>),
+    F16(Edges<F16>),
+}
+
+/// Reusable working buffers for [`SparseNet::forward_batch`].
+#[derive(Default)]
+pub struct Scratch {
+    act: Vec<f32>,
+    acc: Vec<f32>,
+}
+
+impl Scratch {
+    /// Allocated payload after warm-up, including any retained capacity.
+    pub fn allocated_bytes(&self) -> usize {
+        (self.act.capacity() + self.acc.capacity()) * std::mem::size_of::<f32>()
+    }
+}
+
+/// Memory accounting, computed from vector lengths times element sizes so it is
+/// deterministic. `weight_bytes` includes padding slots; `padding_slots` counts
+/// them; `edges` counts real edges only.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+pub struct MemoryBreakdown {
+    pub weight_bytes: usize,
+    pub index_bytes: usize,
+    pub neuron_bytes: usize,
+    pub padding_slots: usize,
+    pub edges: usize,
+}
+
+impl MemoryBreakdown {
+    pub fn total_bytes(&self) -> usize {
+        self.weight_bytes + self.index_bytes + self.neuron_bytes
+    }
+}
+
+/// Memory of the real `CompiledNetwork`, with n synapses and m non-input neurons.
+///
+/// - the `SynapseData` table is `n * size_of::<SynapseData>()` (8 B each), split
+///   4 B weight / 4 B index (`u16` from + `u8` type + 1 B padding);
+/// - the hot view duplicates `weight` (4 B) and `from` (2 B) per synapse;
+/// - so `weight_bytes = 8n`, `index_bytes = 6n`, `neuron_bytes =
+///   m * size_of::<NeuronData>()`. The hot view is counted because it is what the
+///   batched kernel streams, and it is resident either way.
+pub fn current_memory(net: &CompiledNetwork) -> MemoryBreakdown {
+    let n = net.num_synapses();
+    let aos_weight = std::mem::size_of::<f32>() * n;
+    let aos_index = (std::mem::size_of::<SynapseData>() - std::mem::size_of::<f32>()) * n;
+    let hot_weight = std::mem::size_of::<f32>() * n;
+    let hot_index = std::mem::size_of::<u16>() * n;
+    MemoryBreakdown {
+        weight_bytes: aos_weight + hot_weight,
+        index_bytes: aos_index + hot_index,
+        neuron_bytes: std::mem::size_of_val(net.neurons()),
+        padding_slots: 0,
+        edges: n,
+    }
+}
+
+/// A network converted into one experiment layout and precision.
+pub struct SparseNet {
+    layout: Layout,
+    precision: Precision,
+    num_inputs: usize,
+    neurons: Vec<SparseNeuron>,
+    store: EdgeStore,
+}
+
+impl<W: WeightRepr> Edges<W> {
+    fn build(layout: Layout, num_inputs: usize, rows: &[Vec<(u16, f32)>]) -> Self {
+        match layout {
+            Layout::CsrDst => {
+                let mut row_ptr = Vec::with_capacity(rows.len() + 1);
+                let mut col = Vec::new();
+                let mut w = Vec::new();
+                row_ptr.push(0u32);
+                for row in rows {
+                    for &(s, weight) in row {
+                        col.push(s);
+                        w.push(W::encode(weight));
+                    }
+                    row_ptr.push(col.len() as u32);
+                }
+                Edges::Csr { row_ptr, col, w }
+            }
+            Layout::CooSrc => {
+                let mut triples: Vec<(u16, u16, f32)> = Vec::new();
+                for (n, row) in rows.iter().enumerate() {
+                    let dst = (num_inputs + n) as u16;
+                    for &(s, weight) in row {
+                        triples.push((s, dst, weight));
+                    }
+                }
+                triples.sort_by_key(|&(s, d, _)| (s, d));
+                Edges::Coo {
+                    src: triples.iter().map(|t| t.0).collect(),
+                    dst: triples.iter().map(|t| t.1).collect(),
+                    w: triples.iter().map(|t| W::encode(t.2)).collect(),
+                }
+            }
+            Layout::Blocked4 => {
+                let mut row_block_ptr = Vec::with_capacity(rows.len() + 1);
+                let mut cols = Vec::new();
+                let mut w = Vec::new();
+                let mut edges = 0usize;
+                row_block_ptr.push(0u32);
+                for row in rows {
+                    for chunk in row.chunks(BLOCK) {
+                        for k in 0..BLOCK {
+                            match chunk.get(k) {
+                                Some(&(s, weight)) => {
+                                    cols.push(s);
+                                    w.push(W::encode(weight));
+                                }
+                                None => {
+                                    cols.push(0);
+                                    w.push(W::encode(0.0));
+                                }
+                            }
+                        }
+                    }
+                    edges += row.len();
+                    row_block_ptr.push((cols.len() / BLOCK) as u32);
+                }
+                Edges::Blocked {
+                    row_block_ptr,
+                    cols,
+                    w,
+                    edges,
+                }
+            }
+        }
+    }
+
+    /// `(weight_bytes, index_bytes, padding_slots, edges)`.
+    fn memory_parts(&self) -> (usize, usize, usize, usize) {
+        match self {
+            Edges::Csr { row_ptr, col, w } => (
+                w.len() * W::BYTES,
+                row_ptr.len() * 4 + col.len() * 2,
+                0,
+                col.len(),
+            ),
+            Edges::Coo { src, dst, w } => {
+                (w.len() * W::BYTES, (src.len() + dst.len()) * 2, 0, w.len())
+            }
+            Edges::Blocked {
+                row_block_ptr,
+                cols,
+                w,
+                edges,
+            } => (
+                w.len() * W::BYTES,
+                row_block_ptr.len() * 4 + cols.len() * 2,
+                cols.len() - edges,
+                *edges,
+            ),
+        }
+    }
+
+    #[inline(always)]
+    fn run_group(
+        &self,
+        neurons: &[SparseNeuron],
+        num_inputs: usize,
+        width: usize,
+        act: &mut [f32],
+        acc: &mut [f32],
+    ) {
+        match self {
+            Edges::Csr { row_ptr, col, w } => {
+                run_csr(neurons, num_inputs, row_ptr, col, w, width, act, acc)
+            }
+            Edges::Coo { src, dst, w } => {
+                run_coo(neurons, num_inputs, src, dst, w, width, act, acc)
+            }
+            Edges::Blocked {
+                row_block_ptr,
+                cols,
+                w,
+                ..
+            } => run_blocked(neurons, num_inputs, row_block_ptr, cols, w, width, act, acc),
+        }
+    }
+}
+
+/// `limit_range(squash, squash(sum))` for one lane, with the range already resolved.
+#[inline(always)]
+fn finish(squash: SquashType, low: f32, high: f32, sum: f32) -> f32 {
+    apply_limit_range_bounds(low, high, apply_squash(squash, sum))
+}
+
+#[inline(always)]
+fn run_csr<W: WeightRepr>(
+    neurons: &[SparseNeuron],
+    ni: usize,
+    row_ptr: &[u32],
+    col: &[u16],
+    w: &[W],
+    width: usize,
+    act: &mut [f32],
+    acc: &mut [f32],
+) {
+    let acc = &mut acc[..width];
+    for (n, neuron) in neurons.iter().enumerate() {
+        acc.fill(neuron.bias);
+        for e in row_ptr[n] as usize..row_ptr[n + 1] as usize {
+            let wt = w[e].to_f32();
+            let s = col[e] as usize * width;
+            for (a, x) in acc.iter_mut().zip(&act[s..s + width]) {
+                *a += wt * *x;
+            }
+        }
+        let (low, high) = apply_get_range(neuron.squash);
+        let g = (ni + n) * width;
+        for (d, a) in act[g..g + width].iter_mut().zip(acc.iter()) {
+            *d = finish(neuron.squash, low, high, *a);
+        }
+    }
+}
+
+#[inline(always)]
+fn run_blocked<W: WeightRepr>(
+    neurons: &[SparseNeuron],
+    ni: usize,
+    row_block_ptr: &[u32],
+    cols: &[u16],
+    w: &[W],
+    width: usize,
+    act: &mut [f32],
+    acc: &mut [f32],
+) {
+    let acc = &mut acc[..width];
+    for (n, neuron) in neurons.iter().enumerate() {
+        acc.fill(neuron.bias);
+        for b in row_block_ptr[n] as usize..row_block_ptr[n + 1] as usize {
+            let o = b * BLOCK;
+            let w0 = w[o].to_f32();
+            let w1 = w[o + 1].to_f32();
+            let w2 = w[o + 2].to_f32();
+            let w3 = w[o + 3].to_f32();
+            let s0 = cols[o] as usize * width;
+            let s1 = cols[o + 1] as usize * width;
+            let s2 = cols[o + 2] as usize * width;
+            let s3 = cols[o + 3] as usize * width;
+            let a0 = &act[s0..s0 + width];
+            let a1 = &act[s1..s1 + width];
+            let a2 = &act[s2..s2 + width];
+            let a3 = &act[s3..s3 + width];
+            for l in 0..width {
+                let mut a = acc[l];
+                a += w0 * a0[l];
+                a += w1 * a1[l];
+                a += w2 * a2[l];
+                a += w3 * a3[l];
+                acc[l] = a;
+            }
+        }
+        let (low, high) = apply_get_range(neuron.squash);
+        let g = (ni + n) * width;
+        for (d, a) in act[g..g + width].iter_mut().zip(acc.iter()) {
+            *d = finish(neuron.squash, low, high, *a);
+        }
+    }
+}
+
+/// Push/scatter forward pass over source-sorted edges. `acc` holds one
+/// accumulator row per non-input neuron, re-initialised to the bias every group.
+#[inline(always)]
+fn run_coo<W: WeightRepr>(
+    neurons: &[SparseNeuron],
+    ni: usize,
+    src: &[u16],
+    dst: &[u16],
+    w: &[W],
+    width: usize,
+    act: &mut [f32],
+    acc: &mut [f32],
+) {
+    for (n, neuron) in neurons.iter().enumerate() {
+        acc[n * width..(n + 1) * width].fill(neuron.bias);
+    }
+    let mut next = ni; // every neuron below `next` is final
+    let finalise = |g: usize, act: &mut [f32], acc: &[f32]| {
+        let neuron = &neurons[g - ni];
+        let (low, high) = apply_get_range(neuron.squash);
+        let row = &acc[(g - ni) * width..(g - ni + 1) * width];
+        for (d, a) in act[g * width..(g + 1) * width].iter_mut().zip(row) {
+            *d = finish(neuron.squash, low, high, *a);
+        }
+    };
+    for e in 0..src.len() {
+        let s = src[e] as usize;
+        // Every in-edge of a neuron <= s has a smaller source, so it is already
+        // applied: the neuron is complete.
+        while next <= s {
+            finalise(next, act, acc);
+            next += 1;
+        }
+        let wt = w[e].to_f32();
+        let d = (dst[e] as usize - ni) * width;
+        let sa = s * width;
+        for l in 0..width {
+            acc[d + l] += wt * act[sa + l];
+        }
+    }
+    while next < ni + neurons.len() {
+        finalise(next, act, acc);
+        next += 1;
+    }
+}
+
+#[inline(always)]
+fn run_dispatch<W: WeightRepr>(
+    edges: &Edges<W>,
+    neurons: &[SparseNeuron],
+    ni: usize,
+    width: usize,
+    act: &mut [f32],
+    acc: &mut [f32],
+) {
+    // Literal widths let the inlined kernel constant-fold the lane loop.
+    match width {
+        1 => edges.run_group(neurons, ni, 1, act, acc),
+        8 => edges.run_group(neurons, ni, 8, act, acc),
+        32 => edges.run_group(neurons, ni, 32, act, acc),
+        w => edges.run_group(neurons, ni, w, act, acc),
+    }
+}
+
+impl SparseNet {
+    /// Convert `net` into `layout` and `precision`.
+    ///
+    /// With `active_only`, synapses whose weight is exactly `0.0` (or `-0.0`) are
+    /// dropped **before** precision encoding. A weight that merely rounds to zero
+    /// in a reduced precision is *not* dropped: it stays as a stored zero.
+    ///
+    /// Feed-forward only: any edge with `from >= destination` (global indices) is
+    /// refused for every layout. Non-constant aggregate-squash neurons are refused.
+    /// Biases and live weights must be finite; encoding overflow is refused.
+    pub fn from_network(
+        net: &CompiledNetwork,
+        layout: Layout,
+        precision: Precision,
+        active_only: bool,
+    ) -> Result<SparseNet, ConvertError> {
+        let ni = net.num_inputs();
+        let mut neurons = Vec::with_capacity(net.neurons().len());
+        let mut rows: Vec<Vec<(u16, f32)>> = Vec::with_capacity(net.neurons().len());
+        for (n, neuron_data) in net.neurons().iter().enumerate() {
+            let g = ni + n;
+            if !neuron_data.bias.is_finite() {
+                return Err(ConvertError::InvalidNumber {
+                    neuron: g,
+                    reason: "non-finite bias",
+                });
+            }
+            if neuron_data.is_constant {
+                neurons.push(SparseNeuron {
+                    bias: neuron_data.bias,
+                    squash: SquashType::Identity,
+                });
+                rows.push(Vec::new());
+                continue;
+            }
+            let squash = SquashType::from(neuron_data.squash_type);
+            if squash.is_aggregate() {
+                return Err(ConvertError::AggregateSquash {
+                    neuron: g,
+                    squash: neuron_data.squash_type,
+                });
+            }
+            let start = neuron_data.start_synapse as usize;
+            let mut row = Vec::with_capacity(neuron_data.num_synapses as usize);
+            for s in &net.synapses()[start..start + neuron_data.num_synapses as usize] {
+                if s.from_index as usize >= g {
+                    return Err(ConvertError::NotFeedForward {
+                        from: s.from_index as usize,
+                        to: g,
+                    });
+                }
+                if !s.weight.is_finite() {
+                    return Err(ConvertError::InvalidNumber {
+                        neuron: g,
+                        reason: "non-finite weight",
+                    });
+                }
+                let decoded = match precision {
+                    Precision::F32 => s.weight,
+                    Precision::Bf16 => bf16_to_f32(f32_to_bf16(s.weight)),
+                    Precision::F16 => f16_to_f32(f32_to_f16(s.weight)),
+                };
+                if !decoded.is_finite() {
+                    return Err(ConvertError::InvalidNumber {
+                        neuron: g,
+                        reason: "weight encoding overflow",
+                    });
+                }
+                if active_only && s.weight == 0.0 {
+                    continue;
+                }
+                row.push((s.from_index, s.weight));
+            }
+            neurons.push(SparseNeuron {
+                bias: neuron_data.bias,
+                squash,
+            });
+            rows.push(row);
+        }
+        let store = match precision {
+            Precision::F32 => EdgeStore::F32(Edges::build(layout, ni, &rows)),
+            Precision::Bf16 => EdgeStore::Bf16(Edges::build(layout, ni, &rows)),
+            Precision::F16 => EdgeStore::F16(Edges::build(layout, ni, &rows)),
+        };
+        Ok(SparseNet {
+            layout,
+            precision,
+            num_inputs: ni,
+            neurons,
+            store,
+        })
+    }
+
+    pub fn layout(&self) -> Layout {
+        self.layout
+    }
+
+    pub fn precision(&self) -> Precision {
+        self.precision
+    }
+
+    /// Memory from vector lengths times element sizes. `neuron_bytes` is
+    /// `size_of::<SparseNeuron>()` per non-input neuron; offsets and indices are
+    /// `u32` / `u16` as stored.
+    pub fn memory(&self) -> MemoryBreakdown {
+        let (weight_bytes, index_bytes, padding_slots, edges) = match &self.store {
+            EdgeStore::F32(e) => e.memory_parts(),
+            EdgeStore::Bf16(e) => e.memory_parts(),
+            EdgeStore::F16(e) => e.memory_parts(),
+        };
+        MemoryBreakdown {
+            weight_bytes,
+            index_bytes,
+            neuron_bytes: std::mem::size_of::<SparseNeuron>() * self.neurons.len(),
+            padding_slots,
+            edges,
+        }
+    }
+
+    /// Forward `records.len() / stride` records in groups of `width` lanes using a
+    /// record-interleaved activation buffer `act[neuron * width + lane]`.
+    ///
+    /// `out` is record-major with `num_outputs` per record; `num_outputs` is
+    /// `out.len() / record_count` (outputs are the last `num_outputs` neurons). A
+    /// partial final group works: lanes beyond the record count are computed on
+    /// zero inputs and never written to `out`. Inputs beyond `stride` are zero,
+    /// matching `CompiledNetwork`'s short-record fill.
+    ///
+    /// Every activation slot is rewritten for every group (inputs fully, then each
+    /// non-input neuron in order; COO accumulators are re-seeded to the bias), so
+    /// no state survives between groups or calls.
+    ///
+    /// # Panics
+    ///
+    /// On a non-finite record value, `width == 0`, `stride == 0`, a `records` length that is not a multiple of
+    /// `stride`, or an `out` length that is not a whole, non-zero number of outputs
+    /// per record no larger than the non-input neuron count.
+    pub fn forward_batch(
+        &self,
+        records: &[f32],
+        stride: usize,
+        width: usize,
+        scratch: &mut Scratch,
+        out: &mut [f32],
+    ) {
+        assert!(width > 0, "forward_batch: width must be at least 1");
+        assert!(stride > 0, "forward_batch: stride must be at least 1");
+        assert!(
+            records.len() % stride == 0,
+            "forward_batch: records length {} is not a multiple of stride {}",
+            records.len(),
+            stride
+        );
+        assert!(
+            records.iter().all(|x| x.is_finite()),
+            "forward_batch: non-finite record"
+        );
+        let nrec = records.len() / stride;
+        if nrec == 0 {
+            assert!(
+                out.is_empty(),
+                "forward_batch: out must be empty for no records"
+            );
+            return;
+        }
+        assert!(
+            out.len() % nrec == 0,
+            "forward_batch: out length {} is not a multiple of the record count {}",
+            out.len(),
+            nrec
+        );
+        let no = out.len() / nrec;
+        assert!(
+            no >= 1 && no <= self.neurons.len(),
+            "forward_batch: {no} outputs per record is outside 1..={}",
+            self.neurons.len()
+        );
+
+        let ni = self.num_inputs;
+        let total = ni + self.neurons.len();
+        let acc_len = match self.layout {
+            Layout::CooSrc => self.neurons.len() * width,
+            _ => width,
+        };
+        scratch.act.resize(total * width, 0.0);
+        scratch.acc.resize(acc_len, 0.0);
+        let copy = stride.min(ni);
+
+        let mut start = 0;
+        while start < nrec {
+            let lanes = width.min(nrec - start);
+            scratch.act[..ni * width].fill(0.0);
+            for l in 0..lanes {
+                let rec = &records[(start + l) * stride..(start + l + 1) * stride];
+                for i in 0..copy {
+                    scratch.act[i * width + l] = rec[i];
+                }
+            }
+            let (act, acc) = (&mut scratch.act[..], &mut scratch.acc[..]);
+            match &self.store {
+                EdgeStore::F32(e) => run_dispatch(e, &self.neurons, ni, width, act, acc),
+                EdgeStore::Bf16(e) => run_dispatch(e, &self.neurons, ni, width, act, acc),
+                EdgeStore::F16(e) => run_dispatch(e, &self.neurons, ni, width, act, acc),
+            }
+            for o in 0..no {
+                let g = (total - no + o) * width;
+                for l in 0..lanes {
+                    out[(start + l) * no + o] = scratch.act[g + l];
+                }
+            }
+            start += width;
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Sparsity
+// ---------------------------------------------------------------------------
+
+/// Rebuild `net` with exactly `round(fraction * synapses)` seeded-selected
+/// synapses set to weight `0.0`. Topology and every other value are unchanged.
+pub fn apply_sparsity(net: &CompiledNetwork, fraction: f64, seed: u64) -> CompiledNetwork {
+    let mut synapses = net.synapses().to_vec();
+    let n = synapses.len();
+    let k = ((fraction * n as f64).round() as usize).min(n);
+    let mut idx: Vec<usize> = (0..n).collect();
+    let mut rng = Lcg::new(seed);
+    for i in 0..k {
+        let j = i + rng.next_below(n - i);
+        idx.swap(i, j);
+        synapses[idx[i]].weight = 0.0;
+    }
+    CompiledNetwork::from_parts(net.num_inputs(), net.neurons().to_vec(), synapses)
+        .expect("zeroing weights cannot break the index invariant")
+}
+
+// ---------------------------------------------------------------------------
+// Independent f64 oracle
+// ---------------------------------------------------------------------------
+
+/// Plain f64 forward pass over `net.neurons()` / `net.synapses()`. Supports
+/// Identity, Tanh, ReLU and Logistic only; anything else is an `Err` naming the
+/// squash. It calls no crate squash or kernel, so it shares no code path with
+/// what it checks (AGENTS.md oracle rule 1). Range clamps mirror
+/// `squash_profile`: Tanh `[-1, 1]`, Logistic `[0, 1]`, ReLU `[0, +inf)`, Identity
+/// unbounded. A constant neuron yields its bias.
+pub fn reference_forward_f64(
+    net: &CompiledNetwork,
+    record: &[f32],
+    num_outputs: usize,
+) -> Result<Vec<f64>, String> {
+    let ni = net.num_inputs();
+    let mut act = vec![0.0f64; net.num_neurons()];
+    for i in 0..ni.min(record.len()) {
+        act[i] = record[i] as f64;
+    }
+    for (n, neuron_data) in net.neurons().iter().enumerate() {
+        if neuron_data.is_constant {
+            act[ni + n] = neuron_data.bias as f64;
+            continue;
+        }
+        let mut sum = neuron_data.bias as f64;
+        let start = neuron_data.start_synapse as usize;
+        for s in &net.synapses()[start..start + neuron_data.num_synapses as usize] {
+            sum += s.weight as f64 * act[s.from_index as usize];
+        }
+        act[ni + n] = match neuron_data.squash_type {
+            0 => sum,
+            1 => sum.max(0.0),
+            6 => (1.0 / (1.0 + (-sum).exp())).clamp(0.0, 1.0),
+            7 => sum.tanh().clamp(-1.0, 1.0),
+            other => {
+                return Err(format!(
+                    "reference_forward_f64 does not support squash {:?} ({other})",
+                    SquashType::from(other)
+                ));
+            }
+        };
+    }
+    if num_outputs > act.len() {
+        return Err(format!(
+            "num_outputs {num_outputs} exceeds neuron count {}",
+            act.len()
+        ));
+    }
+    Ok(act[act.len() - num_outputs..].to_vec())
+}
+
+// ---------------------------------------------------------------------------
+// Statistics
+// ---------------------------------------------------------------------------
+
+/// Median (mean of the two middle values for an even count). Panics when empty.
+pub fn median(values: &[f64]) -> f64 {
+    quantile(values, 0.5)
+}
+
+/// Quantile with linear interpolation between order statistics (the "type 7"
+/// definition): position `q * (n - 1)` in the sorted values, interpolated between
+/// the two neighbours. `q` is clamped to `[0, 1]`. Panics when empty.
+pub fn quantile(values: &[f64], q: f64) -> f64 {
+    assert!(!values.is_empty(), "quantile: no values");
+    let mut v = values.to_vec();
+    v.sort_by(|a, b| a.total_cmp(b));
+    let pos = q.clamp(0.0, 1.0) * (v.len() - 1) as f64;
+    let lo = pos.floor() as usize;
+    let hi = pos.ceil() as usize;
+    v[lo] + (v[hi] - v[lo]) * (pos - lo as f64)
+}
+
+/// Paired ratio summary: median of per-rep `variant / baseline` ratios and its
+/// bootstrap percentile 95% interval.
+#[derive(Clone, Copy, Debug, PartialEq, Serialize)]
+pub struct RatioSummary {
+    pub median_ratio: f64,
+    pub ci_low: f64,
+    pub ci_high: f64,
+}
+
+/// Ratios are formed per rep (rep `i` of the variant over rep `i` of the
+/// baseline), then the reps are resampled with replacement `resamples` times
+/// (indices drawn from `Lcg::new(seed)`); the interval is the 2.5th and 97.5th
+/// percentile of the resampled medians. Panics if the lengths differ or are empty.
+pub fn paired_ratio_ci(
+    variant_ns: &[f64],
+    baseline_ns: &[f64],
+    resamples: usize,
+    seed: u64,
+) -> RatioSummary {
+    assert_eq!(
+        variant_ns.len(),
+        baseline_ns.len(),
+        "paired_ratio_ci: variant and baseline must have the same number of reps"
+    );
+    assert!(!variant_ns.is_empty(), "paired_ratio_ci: no reps");
+    let ratios: Vec<f64> = variant_ns
+        .iter()
+        .zip(baseline_ns)
+        .map(|(v, b)| v / b)
+        .collect();
+    let mut rng = Lcg::new(seed);
+    let n = ratios.len();
+    let mut medians = Vec::with_capacity(resamples.max(1));
+    let mut buf = vec![0.0; n];
+    for _ in 0..resamples.max(1) {
+        for slot in buf.iter_mut() {
+            *slot = ratios[rng.next_below(n)];
+        }
+        medians.push(median(&buf));
+    }
+    RatioSummary {
+        median_ratio: median(&ratios),
+        ci_low: quantile(&medians, 0.025),
+        ci_high: quantile(&medians, 0.975),
+    }
+}
+
+/// Error of `got` against an f64 reference. A NaN difference counts as infinite
+/// so it can never pass a tolerance.
+#[derive(Clone, Copy, Debug, PartialEq, Serialize)]
+pub struct ErrorStats {
+    pub max_abs: f64,
+    pub rmse: f64,
+}
+
+pub fn error_stats(got: &[f32], reference: &[f64]) -> ErrorStats {
+    assert_eq!(got.len(), reference.len(), "error_stats: length mismatch");
+    let mut max_abs = 0.0f64;
+    let mut sq = 0.0f64;
+    for (g, r) in got.iter().zip(reference) {
+        let d = (*g as f64 - r).abs();
+        let d = if d.is_nan() { f64::INFINITY } else { d };
+        max_abs = max_abs.max(d);
+        sq += d * d;
+    }
+    let rmse = if got.is_empty() {
+        0.0
+    } else {
+        (sq / got.len() as f64).sqrt()
+    };
+    ErrorStats { max_abs, rmse }
+}
+
+// ---------------------------------------------------------------------------
+// Manifest
+// ---------------------------------------------------------------------------
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ShapeSpec {
+    pub label: String,
+    pub num_neurons: usize,
+    pub num_inputs: usize,
+    pub num_outputs: usize,
+    pub fan_in_kind: String,
+    pub fan_in: usize,
+}
+
+impl ShapeSpec {
+    /// Map `fan_in_kind` to a [`FanIn`]; an unknown kind is an error.
+    pub fn fan_in(&self) -> Result<FanIn, String> {
+        match self.fan_in_kind.as_str() {
+            "fixed" => Ok(FanIn::Fixed(self.fan_in)),
+            "varied_around" => Ok(FanIn::VariedAround(self.fan_in)),
+            "exact_total" => Ok(FanIn::ExactTotal(self.fan_in)),
+            other => Err(format!(
+                "shape {}: unknown fan_in_kind {other:?} (expected fixed, varied_around or exact_total)",
+                self.label
+            )),
+        }
+    }
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Criteria {
+    pub speed_win_ratio: f64,
+    pub tolerance_f32: f64,
+    pub tolerance_reduced: f64,
+    pub representative_shape: String,
+    pub adopt_rule: String,
+    pub platforms_required: Vec<String>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Manifest {
+    pub schema_version: u32,
+    pub issue: u32,
+    pub shapes: Vec<ShapeSpec>,
+    pub inactive_fractions: Vec<f64>,
+    pub batch_widths: Vec<usize>,
+    pub calibration_seed: u64,
+    pub validation_seed: u64,
+    pub validation_record_seed: u64,
+    pub shuffle_seed: u64,
+    pub bootstrap_seed: u64,
+    pub calibration_records: usize,
+    pub records_per_sample: usize,
+    pub reps: usize,
+    pub conversion_reps: usize,
+    pub bootstrap_resamples: usize,
+    pub max_cell_seconds: f64,
+    pub max_total_seconds: f64,
+    pub criteria: Criteria,
+}
+
+/// Parse and validate a manifest; every problem is an `Err` naming it.
+pub fn parse_manifest(text: &str) -> Result<Manifest, String> {
+    let m: Manifest = serde_json::from_str(text).map_err(|e| format!("invalid manifest: {e}"))?;
+    if m.schema_version != 1 {
+        return Err(format!(
+            "unsupported manifest schema_version {}",
+            m.schema_version
+        ));
+    }
+    if m.shapes.is_empty() || m.inactive_fractions.is_empty() || m.batch_widths.is_empty() {
+        return Err("manifest needs at least one shape, inactive fraction and batch width".into());
+    }
+    for s in &m.shapes {
+        s.fan_in()?;
+        if s.num_neurons > MAX_NODE_COUNT {
+            return Err(format!(
+                "shape {}: neuron count exceeds {MAX_NODE_COUNT}",
+                s.label
+            ));
+        }
+        if s.num_inputs == 0
+            || s.num_inputs >= s.num_neurons
+            || s.num_outputs == 0
+            || s.num_outputs > s.num_neurons - s.num_inputs
+        {
+            return Err(format!(
+                "shape {}: inconsistent neuron/input/output counts",
+                s.label
+            ));
+        }
+    }
+    let unique = |values: Vec<String>, field: &str| -> Result<(), String> {
+        let mut seen = std::collections::BTreeSet::new();
+        for value in values {
+            if value.trim().is_empty() {
+                return Err(format!("{field} must not be empty"));
+            }
+            if !seen.insert(value) {
+                return Err(format!("duplicate {field}"));
+            }
+        }
+        Ok(())
+    };
+    unique(
+        m.shapes.iter().map(|s| s.label.clone()).collect(),
+        "shape label",
+    )?;
+    unique(
+        m.batch_widths.iter().map(ToString::to_string).collect(),
+        "batch_widths",
+    )?;
+    unique(
+        m.inactive_fractions
+            .iter()
+            .map(ToString::to_string)
+            .collect(),
+        "inactive_fractions",
+    )?;
+    unique(m.criteria.platforms_required.clone(), "platforms_required")?;
+    for s in &m.shapes {
+        let non_inputs = s.num_neurons - s.num_inputs;
+        let max_fan = match s.fan_in_kind.as_str() {
+            "exact_total" => s.fan_in.div_ceil(non_inputs),
+            "varied_around" => s
+                .fan_in
+                .checked_mul(2)
+                .and_then(|n| n.checked_sub(1))
+                .ok_or_else(|| format!("shape {}: fan_in overflow", s.label))?,
+            _ => s.fan_in,
+        };
+        if max_fan > u16::MAX as usize {
+            return Err(format!("shape {}: fan_in exceeds u16", s.label));
+        }
+        // Bound the simultaneous live variants and conversion temporaries before allocating.
+        let bytes = (max_fan as u128 * non_inputs as u128 * 32 * 20)
+            + (s.num_neurons as u128 * *m.batch_widths.iter().max().unwrap() as u128 * 8 * 20)
+            + (m.records_per_sample.max(m.calibration_records) as u128
+                * s.num_neurons as u128
+                * 16);
+        if bytes > 512 * 1024 * 1024 {
+            return Err(format!(
+                "shape {}: estimated experiment memory exceeds 512 MiB",
+                s.label
+            ));
+        }
+        if s.fan_in_kind == "exact_total" {
+            let schedule = s.fan_in()?.exact_schedule(non_inputs).unwrap();
+            if schedule
+                .iter()
+                .enumerate()
+                .any(|(i, &n)| n > s.num_inputs + i)
+            {
+                return Err(format!(
+                    "shape {}: exact fan_in would be truncated",
+                    s.label
+                ));
+            }
+        }
+    }
+    if m.inactive_fractions.iter().any(|f| !(0.0..1.0).contains(f)) {
+        return Err("inactive_fractions must lie in [0, 1)".into());
+    }
+    if m.batch_widths.contains(&0) {
+        return Err("batch_widths must be at least 1".into());
+    }
+    if m.reps < 2
+        || m.records_per_sample == 0
+        || m.calibration_records == 0
+        || m.conversion_reps == 0
+    {
+        return Err(
+            "reps must be at least 2; records_per_sample, calibration_records and conversion_reps must be positive"
+                .into(),
+        );
+    }
+    if m.reps > 10_000 || m.conversion_reps > 100 || m.bootstrap_resamples > 1_000_000 {
+        return Err(
+            "reps/conversion_reps/bootstrap_resamples exceed experiment work limits".into(),
+        );
+    }
+    if m.shapes.len() as u128 * m.batch_widths.len() as u128 * m.inactive_fractions.len() as u128
+        > 10_000
+    {
+        return Err("manifest exceeds 10000 cells".into());
+    }
+    if m.bootstrap_resamples == 0 {
+        return Err("bootstrap_resamples must be positive".into());
+    }
+    for (name, value) in [
+        ("max_cell_seconds", m.max_cell_seconds),
+        ("max_total_seconds", m.max_total_seconds),
+    ] {
+        if !value.is_finite() || value <= 0.0 {
+            return Err(format!("{name} must be finite and positive"));
+        }
+    }
+    if !(0.0..1.0).contains(&m.criteria.speed_win_ratio) || m.criteria.speed_win_ratio == 0.0 {
+        return Err("speed_win_ratio must lie in (0, 1)".into());
+    }
+    for tol in [m.criteria.tolerance_f32, m.criteria.tolerance_reduced] {
+        if !tol.is_finite() || tol < 0.0 {
+            return Err("tolerance must be finite and non-negative".into());
+        }
+    }
+    if m.criteria.platforms_required.is_empty() {
+        return Err("platforms_required must not be empty".into());
+    }
+    if m.calibration_seed == m.validation_seed || m.calibration_seed == m.validation_record_seed {
+        return Err("calibration and validation seeds must differ".into());
+    }
+    if !m
+        .shapes
+        .iter()
+        .any(|s| s.label == m.criteria.representative_shape)
+    {
+        return Err(format!(
+            "representative_shape {:?} is not a declared shape",
+            m.criteria.representative_shape
+        ));
+    }
+    Ok(m)
+}
