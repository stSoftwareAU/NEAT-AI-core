+"""Validate the opt-in research job, not the ordinary CI jobs."""
+
+
+def validate(data):
+    job = data["jobs"]["sparse-precision-research"]
+    assert job["if"] == "github.event_name == 'workflow_dispatch' && inputs.sparse_precision"
+    triggers = data.get("on", data.get(True))
+    assert triggers["workflow_dispatch"]["inputs"]["sparse_precision"]["default"] is False
+    assert set(job["strategy"]["matrix"]["runner"]) == {"macos-15", "ubuntu-24.04"}
+    assert job["strategy"]["fail-fast"] is False
+    assert job["permissions"] == {"contents": "read"}
+    assert 30 <= job["timeout-minutes"] <= 60
+    steps = job["steps"]
+    run = next(s for s in steps if s.get("id") == "research")
+    assert run["run"] == 'deno run --allow-read --allow-write --allow-run --allow-env scripts/run_sparse_precision.ts docs/research/sparse-precision/manifest-v4.json sparse-precision-results < /dev/null'
+    upload = next(s for s in steps if s.get("uses", "").startswith("actions/upload-artifact@"))
+    assert upload["if"] == "always()"
+    assert upload["with"]["path"] == "sparse-precision-results/"
+    assert upload["with"]["if-no-files-found"] == "error"
