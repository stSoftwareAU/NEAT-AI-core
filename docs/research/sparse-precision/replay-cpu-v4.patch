+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn manifest() -> Manifest {
+        parse_manifest(include_str!(
+            "../../docs/research/sparse-precision/manifest.json"
+        ))
+        .unwrap()
+    }
+
+    fn run_small(m: &Manifest, quick: bool) -> Value {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("manifest.json");
+        std::fs::write(&path, serde_json::to_string(m).unwrap()).unwrap();
+        run_experiment(&Args {
+            manifest: path.to_str().unwrap().into(),
+            out: String::new(),
+            quick,
+            code_rev: "test".into(),
+            rustc: "test".into(),
+        })
+    }
+
+    #[test]
+    fn coverage_and_effective_protocol_describe_the_actual_run() {
+        let mut m = manifest();
+        m.shapes.truncate(1);
+        m.criteria.representative_shape = m.shapes[0].label.clone();
+        m.inactive_fractions = vec![0.0];
+        m.batch_widths = vec![1, 3];
+        m.reps = 2;
+        m.records_per_sample = 3;
+        m.conversion_reps = 1;
+        m.bootstrap_resamples = 20;
+        let result = run_small(&m, false);
+        assert_eq!(result["status"], "complete");
+        assert_eq!(result["coverage"]["cells_complete"], 2);
+        assert_eq!(result["coverage"]["variants_planned"], 22);
+        assert_eq!(result["coverage"]["variants_timed"], 22);
+        let host = format!("{}-{}", std::env::consts::ARCH, std::env::consts::OS);
+        let expected: Vec<_> = m
+            .criteria
+            .platforms_required
+            .iter()
+            .filter(|p| **p != host)
+            .collect();
+        assert_eq!(result["coverage"]["platforms_not_covered"], json!(expected));
+        for cell in result["cells"].as_array().unwrap() {
+            for row in cell["variants"].as_array().unwrap() {
+                assert_eq!(row["sample_ns"].as_array().unwrap().len(), 2);
+                assert_eq!(row["end_to_end_sample_ns"].as_array().unwrap().len(), 2);
+                assert_eq!(row["accuracy_pass"], true);
+            }
+        }
+        // Batch width must not change the generated topology or input records.
+        assert_eq!(
+            result["cells"][0]["data_identity"],
+            result["cells"][1]["data_identity"]
+        );
+        let smoke = run_small(&m, true);
+        assert_eq!(smoke["status"], "smoke");
+        assert_eq!(smoke["manifest"]["records_per_sample"], 16);
+        assert_eq!(smoke["requested_manifest"]["records_per_sample"], 3);
+        assert_eq!(smoke["manifest"]["reps"], 3);
+    }
+
+    #[test]
+    fn numerical_failures_are_retained_and_never_counted_as_timed() {
+        let mut m = manifest();
+        m.shapes.truncate(1);
+        m.criteria.representative_shape = m.shapes[0].label.clone();
+        m.criteria.tolerance_reduced = 0.0;
+        m.inactive_fractions = vec![0.0];
+        m.batch_widths = vec![1];
+        m.reps = 2;
+        m.records_per_sample = 3;
+        m.conversion_reps = 1;
+        m.bootstrap_resamples = 20;
+        let result = run_small(&m, false);
+        assert_eq!(result["status"], "completed_with_failures");
+        assert_eq!(result["coverage"]["variants_planned"], 11);
+        assert_eq!(result["coverage"]["variants_timed"], 5);
+        assert_eq!(result["failures"].as_array().unwrap().len(), 6);
+        for f in result["failures"].as_array().unwrap() {
+            assert_eq!(f["stage"], "calibration_accuracy");
+            assert!(
+                f["reason"]
+                    .as_str()
+                    .unwrap()
+                    .contains("exceeds tolerance 0")
+            );
+        }
+        assert_eq!(
+            result["tally"]["csr_dst/bf16/all_edges"]["representative_planned"],
+            1
+        );
+        assert_eq!(
+            result["tally"]["csr_dst/bf16/all_edges"].get("cells_timed"),
+            None
+        );
+    }
+
+    #[test]
+    fn an_unmeasured_host_is_not_reported_as_platform_coverage() {
+        let mut m = manifest();
+        m.max_total_seconds = f64::MIN_POSITIVE;
+        let result = run_small(&m, false);
+        assert_eq!(result["status"], "incomplete");
+        assert_eq!(result["coverage"]["variants_timed"], 0);
+        assert_eq!(result["coverage"]["platforms_covered"], json!([]));
+        assert_eq!(
+            result["coverage"]["platforms_not_covered"],
+            json!(m.criteria.platforms_required)
+        );
+        assert_eq!(result["not_run"].as_array().unwrap().len(), 54);
+    }
+
+    #[test]
+    fn an_incomplete_cell_never_receives_a_speed_verdict() {
+        let mut m = manifest();
+        m.max_cell_seconds = f64::MIN_POSITIVE;
+        let shape = &m.shapes[0];
+        let spec = NetSpec {
+            label: "tiny",
+            num_neurons: shape.num_neurons,
+            num_inputs: shape.num_inputs,
+            num_outputs: shape.num_outputs,
+            fan_in: shape.fan_in().unwrap(),
+        };
+        let o = run_cell(&m, 0, shape, &spec, 0.0, 1, 3, 2);
+        assert_eq!(o.json["reps_done"], 1);
+        for row in o.json["variants"].as_array().unwrap() {
+            if row["variant"] != "current" {
+                assert_eq!(row["verdict"], "incomplete");
+            }
+        }
+        assert!(o.failures.iter().any(|f| f["stage"] == "timing_budget"));
+    }
+}
diff --git a/neat-core/examples/sparse_precision_memory.rs b/neat-core/examples/sparse_precision_memory.rs
new file mode 100644
index 0000000000000000000000000000000000000000..23ab8b13ac87c1ab48364d9e039dead8f4ba361f
--- /dev/null
+++ b/neat-core/examples/sparse_precision_memory.rs
@@ -0,0 +1,233 @@
+//! Separate allocation probe: instrumentation never enters the timing executable.
+
+#[path = "../benches/sparse_precision/allocation.rs"]
+mod allocation;
+#[path = "../benches/common/mod.rs"]
+#[allow(dead_code)]
+mod common;
+#[path = "../benches/sparse_precision/mod.rs"]
+#[allow(dead_code)]
+mod sparse_precision;
+
+use allocation::CountingAllocator;
+use common::{NetSpec, build_network};
+use neat_core::network::CompiledNetwork;
+use serde_json::{Value, json};
+use sparse_precision::execution::*;
+use sparse_precision::*;
+
+#[global_allocator]
+static ALLOCATOR: CountingAllocator = CountingAllocator::new();
+
+fn memory_row(
+    net: &CompiledNetwork,
+    records: &[f32],
+    vs: VariantSpec,
+    width: usize,
+    outputs: usize,
+    tolerance: f64,
+) -> Result<Value, String> {
+    let (converted, conversion) = ALLOCATOR.measure(|| vs.convert(net));
+    let mut exec = converted?;
+    let oracle: Vec<_> = records
+        .chunks(net.num_inputs())
+        .map(|r| reference_forward_f64(net, r, outputs))
+        .collect::<Result<Vec<_>, _>>()?
+        .into_iter()
+        .flatten()
+        .collect();
+    let mut out = vec![0.0; records.len() / net.num_inputs() * outputs];
+    let (_, initialisation_and_scan) = ALLOCATOR.measure(|| {
+        exec.run(records, net.num_inputs(), width, outputs, &mut out);
+    });
+    let error = error_stats(&out, &oracle);
+    let memory = exec.memory();
+    drop(exec);
+    let (_, end_to_end) = ALLOCATOR.measure(|| {
+        let compiled = CompiledNetwork::from_parts(
+            net.num_inputs(),
+            net.neurons().to_vec(),
+            net.synapses().to_vec(),
+        )
+        .unwrap();
+        let mut fresh = if vs.config.is_none() {
+            vs.prepare_current(compiled)
+        } else {
+            vs.convert(&compiled).unwrap()
+        };
+        fresh.run(records, net.num_inputs(), width, outputs, &mut out);
+    });
+    Ok(json!({
+        "variant": vs.name(), "conversion": conversion,
+        "initialisation_and_scan": initialisation_and_scan,
+        "end_to_end": end_to_end, "memory": memory,
+        "error_vs_f64_oracle": error, "tolerance": tolerance,
+        "accuracy_pass": error.max_abs <= tolerance, "outputs": out,
+    }))
+}
+
+fn probe(m: &Manifest) -> Value {
+    let mut cells = Vec::new();
+    let mut failures = Vec::new();
+    for (shape_index, shape) in m.shapes.iter().enumerate() {
+        let spec = NetSpec {
+            label: "manifest",
+            num_neurons: shape.num_neurons,
+            num_inputs: shape.num_inputs,
+            num_outputs: shape.num_outputs,
+            fan_in: shape.fan_in().unwrap(),
+        };
+        for (fraction_index, &fraction) in m.inactive_fractions.iter().enumerate() {
+            let cell = shape_index * m.inactive_fractions.len() + fraction_index;
+            let parent = apply_sparsity(
+                &build_network(&spec, m.validation_seed.wrapping_add(cell as u64)),
+                fraction,
+                m.validation_seed.wrapping_add(77).wrapping_add(cell as u64),
+            );
+            let records = flat_records(
+                m.records_per_sample,
+                shape.num_inputs,
+                m.validation_record_seed,
+            );
+            let (compiled, compilation) = ALLOCATOR.measure(|| {
+                CompiledNetwork::from_parts(
+                    parent.num_inputs(),
+                    parent.neurons().to_vec(),
+                    parent.synapses().to_vec(),
+                )
+                .unwrap()
+            });
+            drop(compiled);
+            for &width in &m.batch_widths {
+                let mut rows = Vec::new();
+                for vs in variants(fraction) {
+                    let tolerance = if vs.precision() == Precision::F32 {
+                        m.criteria.tolerance_f32
+                    } else {
+                        m.criteria.tolerance_reduced
+                    };
+                    match memory_row(&parent, &records, vs, width, shape.num_outputs, tolerance) {
+                        Ok(mut row) => {
+                            // Output payload is checked above and omitted from the memory record.
+                            row.as_object_mut().unwrap().remove("outputs");
+                            if row["accuracy_pass"] == false {
+                                failures.push(json!({"shape": shape.label, "inactive_fraction": fraction,
+                                    "batch_width": width, "variant": vs.name(), "stage": "accuracy",
+                                    "error": row["error_vs_f64_oracle"], "tolerance": tolerance}));
+                            }
+                            rows.push(row);
+                        }
+                        Err(reason) => failures.push(json!({"shape": shape.label,
+                            "inactive_fraction": fraction, "batch_width": width,
+                            "variant": vs.name(), "stage": "conversion_or_oracle", "reason": reason})),
+                    }
+                }
+                cells.push(
+                    json!({"cell": {"shape": shape.label, "inactive_fraction": fraction,
+                    "batch_width": width}, "compilation": compilation, "variants": rows}),
+                );
+            }
+        }
+    }
+    json!({"schema_version": 1, "protocol": "sparse-precision-v4", "manifest": m,
+        "basis": "System allocator requested live bytes; includes conversion temporaries, excludes allocator metadata, internal realloc overlap, stacks and RSS; one variant live per scope",
+        "status": if failures.is_empty() { "complete" } else { "completed_with_failures" },
+        "cells": cells, "failures": failures})
+}
+
+fn main() {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    let result = (|| -> Result<(), String> {
+        if args.len() != 2 {
+            return Err("usage: sparse_precision_memory <manifest> <out>".into());
+        }
+        let text = std::fs::read_to_string(&args[0]).map_err(|e| e.to_string())?;
+        let manifest = parse_manifest(&text)?;
+        let results = probe(&manifest);
+        std::fs::write(&args[1], serde_json::to_string(&results).unwrap() + "\n")
+            .map_err(|e| e.to_string())?;
+        if results["status"] != "complete" {
+            return Err("[EXPERIMENT_FAILURE] memory rows saved with numerical failures".into());
+        }
+        Ok(())
+    })();
+    if let Err(e) = result {
+        eprintln!("sparse_precision_memory: {e}");
+        std::process::exit(1);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use common::FanIn;
+    use neat_core::squash::SquashType;
+    use std::sync::Mutex;
+
+    static PROBE_LOCK: Mutex<()> = Mutex::new(());
+
+    fn network() -> CompiledNetwork {
+        build_network(
+            &NetSpec {
+                label: "memory",
+                num_neurons: 6,
+                num_inputs: 2,
+                num_outputs: 1,
+                fan_in: FanIn::Fixed(2),
+            },
+            18,
+        )
+    }
+
+    #[test]
+    fn a_memory_probe_retains_outputs_and_counts_conversion_temporaries() {
+        let _guard = PROBE_LOCK.lock().unwrap();
+        let net = network();
+        let records = [0.5, -0.25, -0.75, 0.125];
+        let oracle: Vec<_> = records
+            .chunks(2)
+            .flat_map(|r| reference_forward_f64(&net, r, 1).unwrap())
+            .collect();
+        let row = memory_row(&net, &records, variants(0.0)[2], 1, 1, 0.001).unwrap();
+        assert_eq!(row["accuracy_pass"], true);
+        for (got, expected) in row["outputs"].as_array().unwrap().iter().zip(oracle) {
+            assert!((got.as_f64().unwrap() - expected).abs() < 0.001);
+        }
+        let conversion = &row["conversion"];
+        assert!(
+            conversion["additional_peak_bytes"].as_u64().unwrap()
+                > row["memory"]["weight_bytes"].as_u64().unwrap()
+        );
+        assert!(
+            conversion["peak_live_bytes"].as_u64().unwrap()
+                > conversion["live_after_bytes"].as_u64().unwrap()
+        );
+    }
+
+    #[test]
+    fn numerical_failure_remains_a_measured_memory_row() {
+        let _guard = PROBE_LOCK.lock().unwrap();
+        let net = network();
+        let row = memory_row(&net, &[0.3, -0.7], variants(0.0)[3], 1, 1, 0.0).unwrap();
+        assert_eq!(row["variant"], "csr_dst/bf16/all_edges");
+        assert_eq!(row["accuracy_pass"], false);
+        assert!(row["error_vs_f64_oracle"]["max_abs"].as_f64().unwrap() > 0.0);
+    }
+
+    #[test]
+    fn unsupported_topology_is_refused_by_the_same_conversion_entry_point() {
+        let _guard = PROBE_LOCK.lock().unwrap();
+        let net = network();
+        let vs = variants(0.0)[2];
+        assert!(memory_row(&net, &[0.3, -0.7], vs, 1, 1, 0.001).is_ok());
+        let mut neurons = net.neurons().to_vec();
+        neurons[0].squash_type = SquashType::Mean as u8;
+        let unsupported =
+            CompiledNetwork::from_parts(net.num_inputs(), neurons, net.synapses().to_vec())
+                .unwrap();
+        assert_eq!(
+            memory_row(&unsupported, &[0.3, -0.7], vs, 1, 1, 0.001).unwrap_err(),
+            "neuron 2 uses aggregate squash 37; the experiment covers standard weighted-sum neurons only"
+        );
+    }
+}
diff --git a/neat-core/tests/sparse_precision_experiment.rs b/neat-core/tests/sparse_precision_experiment.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6809da82af2f99884be91828744541b457a21f97
--- /dev/null
+++ b/neat-core/tests/sparse_precision_experiment.rs
@@ -0,0 +1,770 @@
+//! Deterministic correctness tests for the Issue #758 sparse-layout and
+//! reduced-precision experiment harness (`benches/sparse_precision/mod.rs`).
+//!
+//! These are "what" tests: every layout, precision and batch width is checked
+//! against an independent f64 oracle (and, for f32, against the scalar
+//! `CompiledNetwork::activate`), never against another sparse kernel.
+
+#[path = "../benches/common/mod.rs"]
+#[allow(dead_code)]
+mod common;
+#[path = "../benches/sparse_precision/mod.rs"]
+#[allow(dead_code)]
+mod sparse_precision;
+
+use common::{FanIn, Lcg, NetSpec, build_inputs, build_network};
+use neat_core::network::{CompiledNetwork, NeuronData, SynapseData};
+use neat_core::squash::SquashType;
+use sparse_precision::*;
+
+const TOL_F32: f64 = 1e-3;
+const TOL_REDUCED: f64 = 2e-2;
+
+fn tol(p: Precision) -> f64 {
+    if p == Precision::F32 {
+        TOL_F32
+    } else {
+        TOL_REDUCED
+    }
+}
+
+fn small_spec() -> NetSpec {
+    NetSpec {
+        label: "test_small",
+        num_neurons: 40,
+        num_inputs: 6,
+        num_outputs: 3,
+        fan_in: FanIn::Fixed(7),
+    }
+}
+
+fn records(count: usize, stride: usize, seed: u64) -> Vec<f32> {
+    (0..count)
+        .flat_map(|i| build_inputs(stride, seed + i as u64))
+        .collect()
+}
+
+fn neuron(bias: f32, start: u32, num: u16, squash: SquashType) -> NeuronData {
+    NeuronData {
+        bias,
+        start_synapse: start,
+        num_synapses: num,
+        squash_type: squash as u8,
+        is_constant: false,
+    }
+}
+
+fn syn(weight: f32, from: u16) -> SynapseData {
+    SynapseData {
+        weight,
+        from_index: from,
+        synapse_type: 0,
+    }
+}
+
+fn run(net: &SparseNet, recs: &[f32], stride: usize, width: usize, no: usize) -> Vec<f32> {
+    let mut out = vec![0.0f32; recs.len() / stride * no];
+    net.forward_batch(recs, stride, width, &mut Scratch::default(), &mut out);
+    out
+}
+
+// ---------------------------------------------------------------------------
+// Agreement with independent oracles
+// ---------------------------------------------------------------------------
+
+#[test]
+fn every_variant_agrees_with_the_f64_oracle_at_every_width() {
+    let spec = small_spec();
+    let net = apply_sparsity(&build_network(&spec, 11), 0.5, 7);
+    let stride = spec.num_inputs;
+    // 5 records: width 3 gives a full group of 3 plus a partial group of 2;
+    // width 8 is a single partial group; width 1 is five groups.
+    let recs = records(5, stride, 100);
+    let oracle: Vec<f64> = recs
+        .chunks(stride)
+        .flat_map(|r| reference_forward_f64(&net, r, spec.num_outputs).unwrap())
+        .collect();
+    for layout in Layout::ALL {
+        for precision in Precision::ALL {
+            for active_only in [false, true] {
+                let s = SparseNet::from_network(&net, layout, precision, active_only).unwrap();
+                for width in [1, 3, 8] {
+                    let out = run(&s, &recs, stride, width, spec.num_outputs);
+                    let e = error_stats(&out, &oracle);
+                    assert!(
+                        e.max_abs <= tol(precision),
+                        "{layout:?}/{precision:?}/active={active_only}/w{width}: max_abs {} > {}",
+                        e.max_abs,
+                        tol(precision)
+                    );
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn f32_layouts_agree_with_the_scalar_activate() {
+    let spec = small_spec();
+    let mut net = build_network(&spec, 21);
+    let stride = spec.num_inputs;
+    let recs = records(4, stride, 200);
+    let expected: Vec<f32> = recs
+        .chunks(stride)
+        .flat_map(|r| net.activate(r, spec.num_outputs))
+        .collect();
+    for layout in Layout::ALL {
+        let s = SparseNet::from_network(&net, layout, Precision::F32, false).unwrap();
+        let out = run(&s, &recs, stride, 3, spec.num_outputs);
+        for (g, e) in out.iter().zip(&expected) {
+            assert!((g - e).abs() <= 1e-3, "{layout:?}: {g} vs {e}");
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Active-edge-only and initialisation semantics
+// ---------------------------------------------------------------------------
+
+/// 2 inputs, 3 neurons (globals 2, 3, 4). Neuron 2 has weights [0.5, 0.0],
+/// neuron 3 has [0.0, -0.0, 0.25], neuron 4 has [1.0]. Zeros: 0.0, 0.0, -0.0 so
+/// k = 3 of 6 total.
+fn zero_weight_net() -> CompiledNetwork {
+    CompiledNetwork::from_parts(
+        2,
+        vec![
+            neuron(0.1, 0, 2, SquashType::Tanh),
+            neuron(0.2, 2, 3, SquashType::Tanh),
+            neuron(0.0, 5, 1, SquashType::Tanh),
+        ],
+        vec![
+            syn(0.5, 0),
+            syn(0.0, 1),
+            syn(0.0, 0),
+            syn(-0.0, 1),
+            syn(0.25, 2),
+            syn(1.0, 3),
+        ],
+    )
+    .unwrap()
+}
+
+#[test]
+fn active_only_drops_exactly_the_zero_weight_edges() {
+    let net = zero_weight_net();
+    let recs = vec![0.3f32, -0.7, 0.9, 0.1];
+    for layout in Layout::ALL {
+        let all = SparseNet::from_network(&net, layout, Precision::F32, false).unwrap();
+        let act = SparseNet::from_network(&net, layout, Precision::F32, true).unwrap();
+        assert_eq!(all.memory().edges, 6, "{layout:?}");
+        assert_eq!(act.memory().edges, 6 - 3, "{layout:?}");
+        let a = run(&all, &recs, 2, 2, 1);
+        let b = run(&act, &recs, 2, 2, 1);
+        for (x, y) in a.iter().zip(&b) {
+            assert!((x - y).abs() <= 1e-6, "{layout:?}: {x} vs {y}");
+        }
+    }
+}
+
+#[test]
+fn a_neuron_with_no_active_edges_outputs_tanh_of_its_bias() {
+    // Neuron 2: both edges zero, bias 0.4 -> with active_only it has no edges and
+    // must output tanh(0.4). Neuron 3 is a constant with bias 0.25 and a (never
+    // read) edge from neuron 2; output = bias. Outputs are the last two neurons.
+    let net = CompiledNetwork::from_parts(
+        2,
+        vec![
+            neuron(0.4, 0, 2, SquashType::Tanh),
+            NeuronData {
+                bias: 0.25,
+                start_synapse: 2,
+                num_synapses: 1,
+                squash_type: SquashType::Tanh as u8,
+                is_constant: true,
+            },
+        ],
+        vec![syn(0.0, 0), syn(0.0, 1), syn(3.0, 2)],
+    )
+    .unwrap();
+    let expected = [(0.4f64).tanh() as f32, 0.25];
+    for layout in Layout::ALL {
+        let s = SparseNet::from_network(&net, layout, Precision::F32, true).unwrap();
+        assert_eq!(s.memory().edges, 0);
+        let out = run(&s, &[5.0, -5.0], 2, 1, 2);
+        assert!(
+            (out[0] - expected[0]).abs() <= 1e-6,
+            "{layout:?}: {}",
+            out[0]
+        );
+        assert_eq!(out[1], expected[1], "{layout:?}");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// State leak
+// ---------------------------------------------------------------------------
+
+#[test]
+fn reused_scratch_leaks_no_state_between_records_or_widths() {
+    let spec = small_spec();
+    let net = build_network(&spec, 31);
+    let stride = spec.num_inputs;
+    let no = spec.num_outputs;
+    let a = build_inputs(stride, 1);
+    let b: Vec<f32> = build_inputs(stride, 2)
+        .iter()
+        .map(|v| v * 3.0 + 1.0)
+        .collect();
+    for layout in Layout::ALL {
+        let s = SparseNet::from_network(&net, layout, Precision::F32, false).unwrap();
+        let mut scratch = Scratch::default();
+        let (mut o1, mut o2, mut o3) = (vec![0.0; no], vec![0.0; no], vec![0.0; no]);
+        s.forward_batch(&a, stride, 1, &mut scratch, &mut o1);
+        s.forward_batch(&b, stride, 1, &mut scratch, &mut o2);
+        s.forward_batch(&a, stride, 1, &mut scratch, &mut o3);
+        assert_ne!(o1, o2, "fixture must make A and B differ");
+        assert_eq!(
+            o1.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+            o3.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+            "{layout:?}: A, B, A through one scratch"
+        );
+        // Batched (width 8, B then A then B lanes) equals each record alone.
+        let mut both = a.clone();
+        both.extend(&b);
+        both.extend(&a);
+        let mut out = vec![0.0; 3 * no];
+        s.forward_batch(&both, stride, 8, &mut scratch, &mut out);
+        assert_eq!(&out[..no], &o1[..], "{layout:?}: lane 0");
+        assert_eq!(&out[no..2 * no], &o2[..], "{layout:?}: lane 1");
+        assert_eq!(&out[2 * no..], &o1[..], "{layout:?}: lane 2");
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Codecs
+// ---------------------------------------------------------------------------
+
+#[test]
+fn codec_anchor_bit_patterns() {
+    assert_eq!(f32_to_bf16(1.0), 0x3F80);
+    assert_eq!(f32_to_f16(1.0), 0x3C00);
+    assert_eq!(f32_to_f16(65504.0), 0x7BFF); // largest finite binary16
+    assert_eq!(f32_to_f16(70000.0), 0x7C00); // beyond 65520 rounds to +inf
+    assert_eq!(f32_to_f16(-70000.0), 0xFC00);
+    // 2^-24 is the smallest binary16 subnormal.
+    let tiny = 2.0f32.powi(-24);
+    assert_eq!(f32_to_f16(tiny), 0x0001);
+    assert_eq!(f16_to_f32(0x0001), tiny);
+    assert_eq!(f16_to_f32(0x7BFF), 65504.0);
+    assert_eq!(f16_to_f32(0x7C00), f32::INFINITY);
+    assert_eq!(f32_to_bf16(f32::INFINITY), 0x7F80);
+    assert_eq!(f32_to_bf16(f32::NEG_INFINITY), 0xFF80);
+}
+
+#[test]
+fn codecs_round_ties_to_even() {
+    // bf16 keeps 7 stored bits; 1 + 2^-8 is exactly half an ulp above 1.0
+    // (0x3F808000: discarded half is 0x8000). 0x3F80 is even, so it stays.
+    assert_eq!(f32_to_bf16(1.0 + 2.0f32.powi(-8)), 0x3F80);
+    // 1 + 3*2^-8 = 0x3F818000 is a tie between 0x3F81 (odd) and 0x3F82 (even).
+    assert_eq!(f32_to_bf16(1.0 + 3.0 * 2.0f32.powi(-8)), 0x3F82);
+    // binary16 keeps 10 stored bits; 1 + 2^-11 ties between 0x3C00 (even) and 0x3C01.
+    assert_eq!(f32_to_f16(1.0 + 2.0f32.powi(-11)), 0x3C00);
+    // 1 + 3*2^-11 ties between 0x3C01 (odd) and 0x3C02 (even).
+    assert_eq!(f32_to_f16(1.0 + 3.0 * 2.0f32.powi(-11)), 0x3C02);
+    // Subnormal tie: 2^-25 is exactly half the smallest subnormal -> 0 (even);
+    // 1.5 * 2^-24 ties between 1 (odd) and 2 (even) -> 2.
+    assert_eq!(f32_to_f16(2.0f32.powi(-25)), 0x0000);
+    assert_eq!(f32_to_f16(1.5 * 2.0f32.powi(-24)), 0x0002);
+    // 65520 is the tie between 65504 (0x7BFF, odd) and 2^16 (even): rounds to inf.
+    assert_eq!(f32_to_f16(65520.0), 0x7C00);
+}
+
+#[test]
+fn codecs_keep_nan_as_nan() {
+    assert!(bf16_to_f32(f32_to_bf16(f32::NAN)).is_nan());
+    assert!(f16_to_f32(f32_to_f16(f32::NAN)).is_nan());
+    // A NaN whose payload sits only in the discarded low bits must not become inf.
+    let low_payload = f32::from_bits(0x7F80_0001);
+    assert!(low_payload.is_nan());
+    assert!(bf16_to_f32(f32_to_bf16(low_payload)).is_nan());
+    assert!(f16_to_f32(f32_to_f16(low_payload)).is_nan());
+}
+
+#[test]
+fn codec_round_trip_error_is_within_half_an_ulp() {
+    // Relative error of round-to-nearest is at most half an ulp over the
+    // significand: 2^-8 for bfloat16 (7 stored bits) and 2^-11 for binary16
+    // (10 stored bits). The brief's 2^-9 for bf16 is unattainable near 1.0.
+    let mut rng = Lcg::new(99);
+    for _ in 0..20_000 {
+        let mag = 2.0f32.powf(rng.next_signed() * 10.0); // 2^-10 ..= 2^10, normal in both
+        let v = mag * if rng.next_signed() < 0.0 { -1.0 } else { 1.0 };
+        let b = bf16_to_f32(f32_to_bf16(v));
+        let h = f16_to_f32(f32_to_f16(v));
+        assert!(((b - v) / v).abs() <= 2.0f32.powi(-8), "bf16 {v} -> {b}");
+        assert!(((h - v) / v).abs() <= 2.0f32.powi(-11), "f16 {v} -> {h}");
+    }
+}
+
+#[test]
+fn f16_decode_inverts_every_encoded_pattern() {
+    // Every finite binary16 value is exactly representable in f32, so encoding the
+    // decode of any non-NaN pattern must give the pattern back.
+    for bits in 0..=u16::MAX {
+        let v = f16_to_f32(bits);
+        if v.is_nan() {
+            assert_eq!(bits & 0x7C00, 0x7C00);
+            continue;
+        }
+        assert_eq!(f32_to_f16(v), bits, "pattern {bits:#06x}");
+    }
+}
