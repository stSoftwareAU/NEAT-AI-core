--- /dev/null
+++ b/tests/scripts/sparse_precision_resources.bats
@@ -0,0 +1,19 @@
+#!/usr/bin/env bats
+
+@test "RSS is the real child high-water mark and a child failure stays nonzero" {
+  run python3 - "${BATS_TEST_DIRNAME}/../../scripts/sparse_precision_resources.py" <<'PY'
+import json, os, subprocess, sys, tempfile
+with tempfile.TemporaryDirectory() as root:
+    for code in [0, 7]:
+        path = os.path.join(root, f"rss-{code}.json")
+        child = "import resource, sys; data = bytearray(32 * 1024 * 1024); del data; print(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss); sys.exit(int(sys.argv[1]))"
+        observed = subprocess.run([sys.executable, sys.argv[1], path, sys.executable,
+                                   "-c", child, str(code)], capture_output=True, text=True)
+        assert observed.returncode == code, observed.stderr
+        with open(path) as source:
+            rss = json.load(source)
+        assert rss["platform"] == sys.platform
+        assert rss["max_rss"] == int(observed.stdout.strip()), (rss, observed.stdout)
+PY
+  [ "$status" -eq 0 ]
+}
