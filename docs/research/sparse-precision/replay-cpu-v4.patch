+//! Issue #758 runner: opt-in, paired, interleaved benchmark of sparse layouts and
+//! reduced-precision weight storage against the real `CompiledNetwork`.
+//!
+//! ```text
+//! cargo run --release -p neat-core --example sparse_precision_experiment -- \
+//!     --manifest docs/research/sparse-precision/manifest.json --out results.json \
+//!     [--quick] [--code-rev <sha>] [--rustc <version string>]
+//! ```
+//!
+//! Calibration results are never reported as performance. Validation runs on a
+//! fresh network and fresh records, with variants shuffled within every rep.
+
+#[path = "../benches/common/mod.rs"]
+#[allow(dead_code)]
+mod common;
+#[path = "../benches/sparse_precision/mod.rs"]
+#[allow(dead_code)]
+mod sparse_precision;
+
+use common::{Lcg, NetSpec, build_network};
+use neat_core::network::CompiledNetwork;
+use serde_json::{Value, json};
+use sparse_precision::execution::*;
+use sparse_precision::*;
+use std::collections::BTreeMap;
+use std::hint::black_box;
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+/// Whole nanoseconds, rounded; timings are stored as integers to keep the file compact.
+fn ns_u64(ns: f64) -> u64 {
+    ns.round().max(0.0) as u64
+}
+
+fn fail(msg: impl std::fmt::Display) -> ! {
+    eprintln!("sparse_precision_experiment: {msg}");
+    std::process::exit(1);
+}
+
+struct Args {
+    manifest: String,
+    out: String,
+    quick: bool,
+    code_rev: String,
+    rustc: String,
+}
+
+fn parse_args() -> Args {
+    let mut manifest = None;
+    let mut out = None;
+    let mut quick = false;
+    let mut code_rev = "unknown".to_string();
+    let mut rustc = "unknown".to_string();
+    let mut it = std::env::args().skip(1);
+    while let Some(a) = it.next() {
+        match a.as_str() {
+            "--manifest" => manifest = it.next(),
+            "--out" => out = it.next(),
+            "--code-rev" => {
+                code_rev = it
+                    .next()
+                    .unwrap_or_else(|| fail("--code-rev needs a value"))
+            }
+            "--rustc" => rustc = it.next().unwrap_or_else(|| fail("--rustc needs a value")),
+            "--quick" => quick = true,
+            other => fail(format!("unknown argument {other:?}")),
+        }
+    }
+    Args {
+        manifest: manifest.unwrap_or_else(|| fail("--manifest <path> is required")),
+        out: out.unwrap_or_else(|| fail("--out <path> is required")),
+        quick,
+        code_rev,
+        rustc,
+    }
+}
+
+fn oracle(
+    net: &CompiledNetwork,
+    recs: &[f32],
+    stride: usize,
+    no: usize,
+) -> Result<Vec<f64>, String> {
+    let mut all = Vec::new();
+    for r in recs.chunks(stride) {
+        all.extend(reference_forward_f64(net, r, no)?);
+    }
+    Ok(all)
+}
+
+fn tolerance(m: &Manifest, p: Precision) -> f64 {
+    if p == Precision::F32 {
+        m.criteria.tolerance_f32
+    } else {
+        m.criteria.tolerance_reduced
+    }
+}
+
+struct CellOutcome {
+    json: Value,
+    failures: Vec<Value>,
+    planned: usize,
+    timed: usize,
+    /// (variant, verdict, accuracy_pass) per timed variant.
+    verdicts: Vec<(String, String, bool)>,
+}
+
+#[allow(clippy::too_many_arguments)]
+fn run_cell(
+    m: &Manifest,
+    cell: usize,
+    shape: &ShapeSpec,
+    spec: &NetSpec,
+    inactive: f64,
+    width: usize,
+    reps: usize,
+    rps: usize,
+) -> CellOutcome {
+    let prep_start = Instant::now();
+    let stride = shape.num_inputs;
+    let no = shape.num_outputs;
+    let cell_id =
+        json!({"shape": shape.label, "inactive_fraction": inactive, "batch_width": width});
+    let specs = variants(inactive);
+    let planned = specs.len();
+    let mut failures: Vec<Value> = Vec::new();
+    let mut note_failure = |variant: &str, stage: &str, reason: String| {
+        failures
+            .push(json!({"cell": cell_id, "variant": variant, "stage": stage, "reason": reason}));
+    };
+
+    // 1. Calibration (never reported as performance).
+    let cal_net = apply_sparsity(
+        &build_network(spec, m.calibration_seed.wrapping_add(cell as u64)),
+        inactive,
+        m.calibration_seed
+            .wrapping_add(77)
+            .wrapping_add(cell as u64),
+    );
+    let cal_recs = flat_records(m.calibration_records, stride, m.calibration_seed ^ 0xCA11);
+    let cal_ref = match oracle(&cal_net, &cal_recs, stride, no) {
+        Ok(r) => r,
+        Err(e) => {
+            note_failure("*", "calibration_oracle", e);
+            return CellOutcome {
+                json: json!({"cell": cell_id, "skipped": "oracle failed"}),
+                failures,
+                planned,
+                timed: 0,
+                verdicts: vec![],
+            };
+        }
+    };
+    let mut viable: Vec<VariantSpec> = Vec::new();
+    for vs in &specs {
+        let name = vs.name();
+        let mut exec = match vs.convert(&cal_net) {
+            Ok(e) => e,
+            Err(e) => {
+                note_failure(&name, "calibration_convert", e);
+                continue;
+            }
+        };
+        let mut out = vec![0.0f32; m.calibration_records * no];
+        exec.run(&cal_recs, stride, width, no, &mut out); // also the warm-up
+        let e = error_stats(&out, &cal_ref);
+        let tol = tolerance(m, vs.precision());
+        if e.max_abs > tol {
+            note_failure(
+                &name,
+                "calibration_accuracy",
+                format!("max_abs {} exceeds tolerance {tol}", e.max_abs),
+            );
+            continue;
+        }
+        viable.push(*vs);
+    }
+    if !viable.iter().any(|v| v.is_baseline()) {
+        note_failure(
+            "current",
+            "baseline",
+            "baseline unavailable; cell not timed".into(),
+        );
+        return CellOutcome {
+            json: json!({"cell": cell_id, "skipped": "no baseline"}),
+            failures,
+            planned,
+            timed: 0,
+            verdicts: vec![],
+        };
+    }
+
+    // 2. Validation on a fresh network and fresh records.
+    let val_net = apply_sparsity(
+        &build_network(spec, m.validation_seed.wrapping_add(cell as u64)),
+        inactive,
+        m.validation_seed.wrapping_add(77).wrapping_add(cell as u64),
+    );
+    let val_recs = flat_records(rps, stride, m.validation_record_seed);
+    let val_ref = match oracle(&val_net, &val_recs, stride, no) {
+        Ok(r) => r,
+        Err(e) => {
+            note_failure("*", "validation_oracle", e);
+            return CellOutcome {
+                json: json!({"cell": cell_id, "skipped": "oracle failed"}),
+                failures,
+                planned,
+                timed: 0,
+                verdicts: vec![],
+            };
+        }
+    };
+
+    let network_identity = val_net.to_topology_json(no);
+    let fingerprint = |bytes: &[u8]| {
+        bytes.iter().fold(0xcbf29ce484222325u64, |hash, &byte| {
+            (hash ^ u64::from(byte)).wrapping_mul(0x100000001b3)
+        })
+    };
+    let record_bytes: Vec<u8> = val_recs
+        .iter()
+        .flat_map(|x| x.to_bits().to_le_bytes())
+        .collect();
+    let data_identity = json!({
+        "network_topology_fnv1a64": format!("{:016x}", fingerprint(network_identity.as_bytes())),
+        "records_f32_le_fnv1a64": format!("{:016x}", fingerprint(&record_bytes)),
+        "network_seed": m.validation_seed.wrapping_add(cell as u64),
+        "record_seed": m.validation_record_seed,
+        "synapses": val_net.num_synapses(),
+        "zero_weights": val_net.synapses().iter().filter(|s| s.weight == 0.0).count(),
+    });
+
+    struct Live {
+        spec: VariantSpec,
+        exec: Exec,
+        conversion_samples: Vec<f64>,
+        first_run_ns: f64,
+        error: ErrorStats,
+        samples: Vec<f64>,
+        end_to_end_samples: Vec<f64>,
+    }
+    let mut live: Vec<Live> = Vec::new();
+    let mut out = vec![0.0f32; rps * no];
+    for vs in &viable {
+        let name = vs.name();
+        let mut times = Vec::new();
+        let mut exec = None;
+        for _ in 0..m.conversion_reps {
+            let t = Instant::now();
+            match vs.convert(&val_net) {
+                Ok(e) => {
+                    times.push(t.elapsed().as_nanos() as f64);
+                    exec = Some(e);
+                }
+                Err(e) => {
+                    note_failure(&name, "validation_convert", e);
+                    exec = None;
+                    break;
+                }
+            }
+        }
+        let Some(mut exec) = exec else { continue };
+        let first_run_start = Instant::now();
+        exec.run(&val_recs, stride, width, no, &mut out); // warm-up + accuracy capture
+        let first_run_ns = first_run_start.elapsed().as_nanos() as f64;
+        let error = error_stats(&out, &val_ref);
+        let tol = tolerance(m, vs.precision());
+        if error.max_abs > tol {
+            note_failure(
+                &name,
+                "validation_accuracy",
+                format!("max_abs {} exceeds tolerance {tol}", error.max_abs),
+            );
+            continue;
+        }
+        live.push(Live {
+            spec: *vs,
+            exec,
+            conversion_samples: times,
+            first_run_ns,
+            error,
+            samples: Vec::new(),
+            end_to_end_samples: Vec::new(),
+        });
+    }
+    let compilation_samples: Vec<u64> = (0..m.conversion_reps)
+        .map(|_| {
+            let t = Instant::now();
+            black_box(
+                CompiledNetwork::from_parts(
+                    val_net.num_inputs(),
+                    val_net.neurons().to_vec(),
+                    val_net.synapses().to_vec(),
+                )
+                .unwrap(),
+            );
+            t.elapsed().as_nanos() as u64
+        })
+        .collect();
+    let preparation_seconds = prep_start.elapsed().as_secs_f64();
+    if !live.iter().any(|l| l.spec.is_baseline()) {
+        note_failure(
+            "current",
+            "baseline",
+            "baseline failed validation; cell not timed".into(),
+        );
+        return CellOutcome {
+            json: json!({"cell": cell_id, "skipped": "no baseline"}),
+            failures,
+            planned,
+            timed: 0,
+            verdicts: vec![],
+        };
+    }
+
+    // 3. Paired, interleaved timing.
+    let timing_start = Instant::now();
+    let mut reps_done = 0;
+    for rep in 0..reps {
+        let mut order: Vec<usize> = (0..live.len()).collect();
+        let mut rng = Lcg::new(
+            m.shuffle_seed
+                .wrapping_add((cell as u64).wrapping_mul(1_000_003))
+                .wrapping_add(rep as u64),
+        );
+        for i in (1..order.len()).rev() {
+            order.swap(i, rng.next_below(i + 1));
+        }
+        for &i in &order {
+            let t = Instant::now();
+            live[i].exec.run(&val_recs, stride, width, no, &mut out);
+            let ns = t.elapsed().as_nanos() as f64;
+            black_box(&out);
+            live[i].samples.push(ns);
+            let t = Instant::now();
+            // Typed-parts compilation, conversion, scratch initialisation and one corpus scan.
+            let compiled = CompiledNetwork::from_parts(
+                val_net.num_inputs(),
+                val_net.neurons().to_vec(),
+                val_net.synapses().to_vec(),
+            )
+            .unwrap();
+            let mut fresh = if live[i].spec.config.is_none() {
+                live[i].spec.prepare_current(compiled)
+            } else {
+                live[i].spec.convert(&compiled).unwrap()
+            };
+            fresh.run(&val_recs, stride, width, no, &mut out);
+            black_box(&out);
+            live[i]
+                .end_to_end_samples
+                .push(t.elapsed().as_nanos() as f64);
+        }
+        reps_done += 1;
+        if prep_start.elapsed().as_secs_f64() > m.max_cell_seconds {
+            break;
+        }
+    }
+
+    if reps_done < reps {
+        note_failure(
+            "*",
+            "timing_budget",
+            format!("completed {reps_done} of {reps} paired repetitions"),
+        );
+    }
+
+    // 4. Summaries and verdicts.
+    let base_idx = live.iter().position(|l| l.spec.is_baseline()).unwrap();
+    let base_samples = live[base_idx].samples.clone();
+    let base_end_to_end = live[base_idx].end_to_end_samples.clone();
+    let whole_scan = live.iter().find(|l| l.spec.whole_scan);
+    let mut verdicts = Vec::new();
+    let mut rows = Vec::new();
+    for l in &live {
+        let name = l.spec.name();
+        let mem = l.exec.memory();
+        let tol = tolerance(m, l.spec.precision());
+        let accuracy_pass = l.error.max_abs <= tol;
+        let (ratio, verdict) = if l.spec.is_baseline() {
+            (None, "baseline".to_string())
+        } else {
+            let r = paired_ratio_ci(
+                &l.samples,
+                &base_samples,
+                m.bootstrap_resamples,
+                m.bootstrap_seed,
+            );
+            let v = if reps_done < reps {
+                "incomplete"
+            } else if r.ci_high <= m.criteria.speed_win_ratio {
+                "faster"
+            } else if r.ci_low > 1.0 {
+                "slower"
+            } else {
+                "inconclusive"
+            };
+            (Some(r), v.to_string())
+        };
+        verdicts.push((name.clone(), verdict.clone(), accuracy_pass));
+        let end_to_end_ratio = if l.spec.is_baseline() {
+            None
+        } else {
+            Some(paired_ratio_ci(
+                &l.end_to_end_samples,
+                &base_end_to_end,
+                m.bootstrap_resamples,
+                m.bootstrap_seed,
+            ))
+        };
+        let scratch = match &l.exec {
+            Exec::Sparse(_, s) => {
+                json!({"allocated_payload_bytes": s.allocated_bytes(), "basis": "actual vector capacities after warm-up"})
+            }
+            Exec::Current(_) | Exec::CurrentWholeScan(_) => {
+                let nn = val_net.num_neurons();
+                let non_inputs = val_net.neurons().len();
+                let trace = (non_inputs / 10).max(1) * 2 + 1;
+                let resident =
+                    (nn * (5 + neat_core::loss::MSE_TILE_LANES) + non_inputs * 5 + trace * 5) * 4;
+                json!({"resident_payload_bytes_model": resident,
+                    "batch_scratch_bytes_model": if width > 1 { nn * 16 * 4 } else { 0 },
+                    "basis": "length model of CompiledNetwork::assemble and BatchScratch::new; excludes allocator rounding and Vec headers"})
+            }
+        };
+        rows.push(json!({
+            "variant": name,
+            "conversion_ns_median": ns_u64(median(&l.conversion_samples)),
+            "conversion_sample_ns": l.conversion_samples.iter().map(|&s| ns_u64(s)).collect::<Vec<_>>(),
+            "first_run_ns": ns_u64(l.first_run_ns),
+            "scratch_memory": scratch,
+            "end_to_end_sample_ns": l.end_to_end_samples.iter().map(|&s| ns_u64(s)).collect::<Vec<_>>(),
+            "end_to_end_ratio_vs_current": end_to_end_ratio,
+            "end_to_end_verdict": if l.spec.is_baseline() { "baseline" } else if reps_done < reps { "incomplete" }
+                else if end_to_end_ratio.unwrap().ci_high <= m.criteria.speed_win_ratio { "faster" }
+                else if end_to_end_ratio.unwrap().ci_low > 1.0 { "slower" } else { "inconclusive" },
+            "ratio_vs_current_whole_scan": whole_scan.map(|control| paired_ratio_ci(
+                &l.samples, &control.samples, m.bootstrap_resamples, m.bootstrap_seed)),
+            "end_to_end_ratio_vs_current_whole_scan": whole_scan.map(|control| paired_ratio_ci(
+                &l.end_to_end_samples, &control.end_to_end_samples, m.bootstrap_resamples, m.bootstrap_seed)),
+            "memory": mem,
+            "error_vs_f64_oracle": l.error,
+            "tolerance": tol,
+            "accuracy_pass": accuracy_pass,
+            "sample_ns": l.samples.iter().map(|&s| ns_u64(s)).collect::<Vec<u64>>(),
+            "median_sample_ns": ns_u64(median(&l.samples)),
+            "ratio_vs_current": ratio,
+            "verdict": verdict,
+        }));
+    }
+    let timed = live.len();
+    CellOutcome {
+        json: json!({
+            "cell": cell_id,
+            "data_identity": data_identity,
+            "reps_planned": reps,
+            "reps_done": reps_done,
+            "records_per_sample": rps,
+            "preparation_seconds": preparation_seconds,
+            "compilation_sample_ns": compilation_samples,
+            "timing_seconds": timing_start.elapsed().as_secs_f64(),
+            "complete": reps_done == reps,
+            "variants_planned": planned,
+            "variants_timed": timed,
+            "variant_failures": failures,
+            "variants": rows,
+        }),
+        failures,
+        planned,
+        timed,
+        verdicts,
+    }
+}
+
+fn command_output(program: &str, args: &[&str]) -> String {
+    let output = std::process::Command::new(program)
+        .args(args)
+        .output()
+        .unwrap_or_else(|e| fail(format!("cannot run {program}: {e}")));
+    if !output.status.success() {
+        fail(format!(
+            "{program} failed: {}",
+            String::from_utf8_lossy(&output.stderr)
+        ));
+    }
+    String::from_utf8(output.stdout)
+        .unwrap_or_else(|e| fail(e))
+        .trim()
+        .to_string()
+}
+
+fn run_identity(args: &Args) -> Value {
+    let revision = command_output("git", &["rev-parse", "HEAD"]);
+    let compiler = command_output("rustc", &["--version"]);
+    let diff = command_output("git", &["diff", "HEAD", "--stat"]);
+    if !diff.is_empty() {
+        fail(
+            "tracked working tree differs from HEAD; commit the protocol and code before measurement",
+        );
+    }
+    if args.code_rev != "unknown" && args.code_rev != revision {
+        fail("--code-rev disagrees with git HEAD");
+    }
+    if args.rustc != "unknown" && args.rustc != compiler {
+        fail("--rustc disagrees with the installed compiler");
+    }
+    json!({
+        "git_head": revision,
+        "tracked_diff": diff,
+        "rustc_vv": command_output("rustc", &["-vV"]),
+        "cargo": command_output("cargo", &["--version"]),
+        "manifest_git_blob": command_output("git", &["hash-object", &args.manifest]),
+        "source_git_blobs": command_output("git", &["hash-object", "Cargo.toml", "neat-core/Cargo.toml",
+            "neat-core/benches/common/mod.rs", "neat-core/benches/sparse_precision/mod.rs",
+            "neat-core/examples/sparse_precision_experiment.rs",
+            "neat-core/benches/sparse_precision/execution.rs",
+            "neat-core/benches/sparse_precision/allocation.rs",
+            "neat-core/examples/sparse_precision_memory.rs",
+            "scripts/run_sparse_precision.ts", "scripts/sparse_precision_resources.py"]),
+        "lockfile_git_blob": command_output("git", &["hash-object", "Cargo.lock"]),
+        "kernel": command_output("uname", &["-a"]),
+        "cpu": if cfg!(target_os = "linux") {
+            std::fs::read_to_string("/proc/cpuinfo").unwrap_or_else(|e| fail(e))
+        } else { command_output("sysctl", &["-n", "machdep.cpu.brand_string"]) },
+        "rustflags": std::env::var("RUSTFLAGS").unwrap_or_default(),
+        "cargo_encoded_rustflags": std::env::var("CARGO_ENCODED_RUSTFLAGS").unwrap_or_default(),
+    })
+}
+
+fn run_experiment(args: &Args) -> Value {
+    let text = std::fs::read_to_string(&args.manifest)
+        .unwrap_or_else(|e| fail(format!("cannot read manifest {}: {e}", args.manifest)));
+    let mut m = parse_manifest(&text).unwrap_or_else(|e| fail(e));
+    let manifest_echo = serde_json::to_value(&m).unwrap_or_else(|e| fail(e));
+    if args.quick {
+        m.reps = 3;
+        m.records_per_sample = 16;
+        m.shapes.truncate(2);
+    }
+
+    let effective_manifest = serde_json::to_value(&m).unwrap();
+    let started = Instant::now();
+    let started_unix = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_secs());
+
+    let mut cell_json = Vec::new();
+    let mut failures = Vec::new();
+    let mut not_run = Vec::new();
+    let mut tally: BTreeMap<String, BTreeMap<&'static str, u64>> = BTreeMap::new();
+    let (mut cells_planned, mut cells_run, mut variants_planned, mut variants_timed) =
+        (0usize, 0usize, 0usize, 0usize);
+
+    let mut cell = 0usize;
+    for (shape_index, shape) in m.shapes.iter().enumerate() {
+        let spec = NetSpec {
+            label: "manifest",
+            num_neurons: shape.num_neurons,
+            num_inputs: shape.num_inputs,
+            num_outputs: shape.num_outputs,
+            fan_in: shape.fan_in().unwrap_or_else(|e| fail(e)),
+        };
+        for (fraction_index, &inactive) in m.inactive_fractions.iter().enumerate() {
+            for &width in &m.batch_widths {
+                cells_planned += 1;
+                variants_planned += variants(inactive).len();
+                if shape.label == m.criteria.representative_shape {
+                    for variant in variants(inactive) {
+                        *tally
+                            .entry(variant.name())
+                            .or_default()
+                            .entry("representative_planned")
+                            .or_default() += 1;
+                    }
+                }
+                if started.elapsed().as_secs_f64() > m.max_total_seconds {
+                    not_run.push(json!({
+                        "shape": shape.label, "inactive_fraction": inactive, "batch_width": width,
+                        "reason": format!("max_total_seconds {} exceeded", m.max_total_seconds),
+                    }));
+                    cell += 1;
+                    continue;
+                }
+                let mut cell_manifest = m.clone();
+                cell_manifest.max_cell_seconds = m.max_cell_seconds.min(
+                    (m.max_total_seconds - started.elapsed().as_secs_f64()).max(f64::MIN_POSITIVE),
+                );
+                let o = run_cell(
+                    &cell_manifest,
+                    shape_index * m.inactive_fractions.len() + fraction_index,
+                    shape,
+                    &spec,
+                    inactive,
+                    width,
+                    m.reps,
+                    m.records_per_sample,
+                );
+                cell += 1;
+                eprintln!(
+                    "cell {cell}: {} frac={inactive} w={width}: {}/{} variants timed",
+                    shape.label, o.timed, o.planned
+                );
+                cells_run += 1;
+                variants_timed += o.timed;
+                failures.extend(o.failures);
+                let representative = shape.label == m.criteria.representative_shape;
+                for (name, verdict, acc) in &o.verdicts {
+                    if verdict == "baseline" {
+                        continue;
+                    }
+                    let t = tally.entry(name.clone()).or_default();
+                    *t.entry("cells_timed").or_default() += 1;
+                    *t.entry(match verdict.as_str() {
+                        "faster" => "faster",
+                        "slower" => "slower",
+                        "incomplete" => "incomplete",
+                        _ => "inconclusive",
+                    })
+                    .or_default() += 1;
+                    if *acc {
+                        *t.entry("accuracy_pass").or_default() += 1;
+                    }
+                    if representative {
+                        *t.entry("representative_cells").or_default() += 1;
+                        if verdict == "faster" && *acc {
+                            *t.entry("representative_faster_accurate").or_default() += 1;
+                        }
+                    }
+                }
+                cell_json.push(o.json);
+            }
+        }
+    }
+
+    let (arch, os) = (std::env::consts::ARCH, std::env::consts::OS);
+    let apple = arch == "aarch64" && os == "macos";
+    let cells_complete = cell_json.iter().filter(|c| c["complete"] == true).count();
+    let status = if args.quick {
+        "smoke"
+    } else if !not_run.is_empty() || cells_complete < cells_planned {
+        "incomplete"
+    } else if !failures.is_empty() {
+        "completed_with_failures"
+    } else {
+        "complete"
+    };
+    json!({
+        "schema_version": 2,
+        "protocol": "sparse-precision-v4",
+        "status": status,
+        "issue": 758,
+        "requested_manifest": manifest_echo,
+        "manifest": effective_manifest,
+        "quick": args.quick,
+        "code_rev": args.code_rev,
+        "crate_version": env!("CARGO_PKG_VERSION"),
+        "host": {
+            "os": os,
+            "arch": arch,
+            "available_parallelism": std::thread::available_parallelism().map_or(0, |n| n.get()),
+            "rustc": args.rustc,
+        },
+        "profile": if cfg!(debug_assertions) { "debug" } else { "release" },
+        "started_unix": started_unix,
+        "wall_seconds": started.elapsed().as_secs_f64(),
+        "cells": cell_json,
+        "failures": failures,
+        "not_run": not_run,
+        "coverage": {
+            "cells_planned": cells_planned,
+            "cells_run": cells_run,
+            "cells_complete": cells_complete,
+            "variants_planned": variants_planned,
+            "variants_timed": variants_timed,
+            "platforms_covered": if variants_timed > 0 { vec![format!("{arch}-{os}")] } else { vec![] },
+            "platforms_not_covered": m.criteria.platforms_required.iter().filter(|p| variants_timed == 0 || **p != format!("{arch}-{os}")).collect::<Vec<_>>(),
+            "metal": {"status": "not_run", "reason": if apple { "no factorial adapter for the scorer GPU backend" } else { "requires an Apple Metal host; this process runs on another OS" }},
+            "skipped_by_design": "active_only variants are skipped when inactive_fraction == 0 (identical to all_edges)",
+        },
+        "tally": tally,
+    })
+}
+
+fn main() {
+    let args = parse_args();
+    let identity = run_identity(&args);
+    let mut results = run_experiment(&args);
+    results["identity"] = identity;
+    let body = serde_json::to_string(&results).unwrap_or_else(|e| fail(e));
+    std::fs::write(&args.out, format!("{body}\n"))
+        .unwrap_or_else(|e| fail(format!("cannot write {}: {e}", args.out)));
+    eprintln!("wrote {}", args.out);
+    if results["status"] == "incomplete" || !results["failures"].as_array().unwrap().is_empty() {
+        fail(format!(
+            "[EXPERIMENT_FAILURE] status={} failures={}; raw results saved",
+            results["status"],
+            results["failures"].as_array().unwrap().len()
+        ));
+    }
+}
