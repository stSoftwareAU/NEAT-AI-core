--- /dev/null
+++ b/tests/sparse_precision_runner_test.ts
@@ -0,0 +1,41 @@
+import { assertEquals, assertThrows } from "@std/assert";
+import {
+  checkResearchExit,
+  peakRssBytes,
+} from "../scripts/run_sparse_precision.ts";
+
+Deno.test("RSS uses the platform's documented units and refuses missing data", () => {
+  assertEquals(peakRssBytes("linux", 1536), 1536 * 1024);
+  assertEquals(peakRssBytes("darwin", 1572864), 1572864);
+  for (const os of ["linux", "darwin"] as const) {
+    for (
+      const value of [undefined, 0, -1, "1536", Number.MAX_SAFE_INTEGER + 1]
+    ) {
+      assertThrows(() => peakRssBytes(os, value), Error, "RSS");
+    }
+  }
+});
+
+Deno.test("only recorded numerical failures explain a failed research command", () => {
+  checkResearchExit(0, { status: "complete", failures: [] });
+  checkResearchExit(1, {
+    status: "completed_with_failures",
+    failures: [{ stage: "validation_accuracy", reason: "exceeds tolerance" }],
+  });
+  for (
+    const result of [
+      {},
+      { status: "complete", failures: [] },
+      { status: "completed_with_failures", failures: [] },
+      { status: "incomplete", failures: [{ stage: "timing_budget" }] },
+    ]
+  ) {
+    assertThrows(() => checkResearchExit(1, result), Error, "research command");
+  }
+  assertThrows(
+    () => checkResearchExit(2, { status: "complete", failures: [] }),
+    Error,
+    "research command",
+  );
+  assertThrows(() => checkResearchExit(0, {}), Error, "research command");
+});
