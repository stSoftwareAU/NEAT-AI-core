+#[test]
+fn aggregate_squash_neurons_are_refused() {
+    let bad = two_neuron_net(SquashType::Maximum, 1);
+    for layout in Layout::ALL {
+        match SparseNet::from_network(&bad, layout, Precision::F32, false) {
+            Err(ConvertError::AggregateSquash { neuron, squash }) => {
+                assert_eq!(neuron, 2); // 1 input + second non-input
+                assert_eq!(squash, SquashType::Maximum as u8);
+            }
+            other => panic!("expected AggregateSquash, got {:?}", other.err()),
+        }
+    }
+    let ok = two_neuron_net(SquashType::Tanh, 1);
+    assert!(SparseNet::from_network(&ok, Layout::CsrDst, Precision::F32, false).is_ok());
