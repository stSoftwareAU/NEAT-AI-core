+// Opt-in v4 research driver. Peak RSS is collected outside the timed executable.
+export function peakRssBytes(os: "linux" | "darwin", raw: unknown): number {
+  if (typeof raw !== "number" || !Number.isSafeInteger(raw) || raw <= 0) {
+    throw new Error(`RSS missing or malformed for ${os}`);
+  }
+  const bytes = raw * (os === "linux" ? 1024 : 1);
+  if (!Number.isSafeInteger(bytes)) {
+    throw new Error(`RSS outside supported range for ${os}`);
+  }
+  return bytes;
+}
+
+export function checkResearchExit(
+  code: number,
+  result: Record<string, unknown>,
+) {
+  if (
+    code === 0 && result.status === "complete" &&
+    Array.isArray(result.failures) &&
+    result.failures.length === 0
+  ) return;
+  if (
+    code === 1 && result.status === "completed_with_failures" &&
+    Array.isArray(result.failures) && result.failures.length > 0
+  ) return;
+  throw new Error(
+    `research command failed unexpectedly: exit=${code}, status=${result.status}`,
+  );
+}
+
+async function output(args: string[]) {
+  const result = await new Deno.Command(args[0], {
+    args: args.slice(1),
+    stdin: "null",
+    stdout: "piped",
+    stderr: "piped",
+    signal: AbortSignal.timeout(30_000),
+  }).output();
+  if (!result.success) {
+    throw new Error(`${args[0]}: ${new TextDecoder().decode(result.stderr)}`);
+  }
+  return new TextDecoder().decode(result.stdout).trim();
+}
+
+async function main() {
+  const [manifest, outDir] = Deno.args;
+  if (Deno.args.length !== 2) {
+    throw new Error(
+      "usage: run_sparse_precision.ts <committed-manifest> <new-output-directory>",
+    );
+  }
+  if (Deno.build.os !== "linux" && Deno.build.os !== "darwin") {
+    throw new Error(`unsupported RSS platform: ${Deno.build.os}`);
+  }
+  const os = Deno.build.os;
+  await output(["git", "ls-files", "--error-unmatch", manifest]);
+  if (await output(["git", "diff", "HEAD", "--stat"])) {
+    throw new Error("commit source and protocol before measurement");
+  }
+  await Deno.mkdir(outDir); // Refuse an existing directory; preserve earlier evidence.
+  const execution: Record<string, unknown> = {
+    schema_version: 1,
+    protocol: "sparse-precision-v4",
+    code_rev: await output(["git", "rev-parse", "HEAD"]),
+    compiler: await output(["rustc", "-vV"]),
+    host: await output(["uname", "-a"]),
+    gpu_inventory: os === "darwin"
+      ? await output(["system_profiler", "SPDisplaysDataType", "-json"])
+      : "Metal is unavailable on Linux",
+    manifest,
+    manifest_git_blob: await output(["git", "hash-object", manifest]),
+    cache_state: "no cache purge; fresh hosted runner or existing local cache",
+    commands: [],
+  };
+  const commands = execution.commands as Record<string, unknown>[];
+  const save = () =>
+    Deno.writeTextFile(
+      `${outDir}/execution.json`,
+      JSON.stringify(execution, null, 2) + "\n",
+    );
+  await save();
+  async function measured(name: string, command: string[]) {
+    const rssPath = `${outDir}/${name}-rss.json`;
+    const start = performance.now();
+    const result = await new Deno.Command("python3", {
+      args: ["scripts/sparse_precision_resources.py", rssPath, ...command],
+      stdin: "null",
+      stdout: "piped",
+      stderr: "piped",
+      signal: AbortSignal.timeout(900_000),
+    }).output();
+    const stderr = new TextDecoder().decode(result.stderr);
+    await Deno.writeFile(`${outDir}/${name}-stdout.txt`, result.stdout);
+    await Deno.writeTextFile(`${outDir}/${name}-stderr.txt`, stderr);
+    const rss = JSON.parse(await Deno.readTextFile(rssPath));
+    commands.push({
+      name,
+      command,
+      exit_code: result.code,
+      wall_seconds: (performance.now() - start) / 1000,
+      peak_process_rss_bytes: peakRssBytes(os, rss.max_rss),
+    });
+    await save();
+    return result.code;
+  }
+  const buildCode = await measured("build", [
+    "cargo",
+    "build",
+    "--locked",
+    "--release",
+    "-p",
+    "neat-core",
+    "--example",
+    "sparse_precision_experiment",
+    "--example",
+    "sparse_precision_memory",
+  ]);
+  if (buildCode !== 0) {
+    throw new Error(
+      `build failed: exit ${buildCode}; see ${outDir}/build-stderr.txt`,
+    );
+  }
+  const metadata = JSON.parse(
+    await output(["cargo", "metadata", "--no-deps", "--format-version", "1"]),
+  );
+  const binaryDir = `${metadata.target_directory}/release/examples`;
+  const timingCode = await measured("validation", [
+    `${binaryDir}/sparse_precision_experiment`,
+    "--manifest",
+    manifest,
+    "--out",
+    `${outDir}/results.json`,
+    "--code-rev",
+    execution.code_rev as string,
+    "--rustc",
+    await output(["rustc", "--version"]),
+  ]);
+  const timing = JSON.parse(await Deno.readTextFile(`${outDir}/results.json`));
+  checkResearchExit(timingCode, timing);
+  const memoryCode = await measured("memory", [
+    `${binaryDir}/sparse_precision_memory`,
+    manifest,
+    `${outDir}/memory.json`,
+  ]);
+  const memory = JSON.parse(await Deno.readTextFile(`${outDir}/memory.json`));
+  checkResearchExit(memoryCode, memory);
+  memory.identity = timing.identity;
+  await Deno.writeTextFile(
+    `${outDir}/memory.json`,
+    JSON.stringify(memory) + "\n",
+  );
+  execution.status = timingCode || memoryCode
+    ? "completed_with_failures"
+    : "complete";
+  await save();
+  if (timingCode || memoryCode) {
+    throw new Error(
+      `[EXPERIMENT_FAILURE] numerical failures retained in ${outDir}`,
+    );
+  }
+}
+
+if (import.meta.main) {
+  await main();
+}
diff --git a/scripts/sparse_precision_resources.py b/scripts/sparse_precision_resources.py
new file mode 100644
index 0000000000000000000000000000000000000000..7ea894704c06d7e4aa117f402ca9f518be8f8db2
--- /dev/null
+++ b/scripts/sparse_precision_resources.py
@@ -0,0 +1,20 @@
+"""Collect the OS child high-water RSS; Deno's subprocess API has no rusage."""
+
+import json
+import resource
+import subprocess
+import sys
+
+
+def main():
+    if len(sys.argv) < 3:
+        raise SystemExit("usage: sparse_precision_resources.py <rss.json> <command> [args...]")
+    result = subprocess.run(sys.argv[2:], stdin=subprocess.DEVNULL, check=False)
+    usage = resource.getrusage(resource.RUSAGE_CHILDREN)
+    with open(sys.argv[1], "x", encoding="utf-8") as output:
+        json.dump({"max_rss": usage.ru_maxrss, "platform": sys.platform}, output)
+    raise SystemExit(result.returncode if result.returncode >= 0 else 128 - result.returncode)
+
+
+if __name__ == "__main__":
+    main()
