+fn two_neuron_net(squash: SquashType, from: u16) -> CompiledNetwork {
+    // 1 input; neuron 1 (global) reads input 0; neuron 2 reads `from` with `squash`.
+    CompiledNetwork::from_parts(
+        1,
+        vec![
+            neuron(0.0, 0, 1, SquashType::Tanh),
+            neuron(0.0, 1, 1, squash),
+        ],
+        vec![syn(0.5, 0), syn(0.5, from)],
+    )
+    .unwrap()
+}
