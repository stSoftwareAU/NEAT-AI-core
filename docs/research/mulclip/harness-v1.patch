+#[test]
+fn lanes_forward_matches_independent_f64_forward() {
+    // Fixed seeds (graph 5, records 9); if a pre-activation ever lands within
+    // 1e-4 of +/-c and flips the branch, change the seed rather than the bound.
+    let g = Graph::generate(&heavy_spec(), 5);
+    let mut rng = Rng::new(9);
+    let recs: Vec<Vec<f32>> = (0..8)
+        .map(|_| {
+            (0..16)
+                .map(|_| (rng.next_f64() * 2.0 - 1.0) as f32)
+                .collect()
+        })
+        .collect();
+    let arr: [&[f32]; 8] = std::array::from_fn(|i| recs[i].as_slice());
+    for name in ["mulclip_d2", "mulclip_d3", "relu", "hard_tanh"] {
+        let p = Prepared::from_name(name).unwrap();
+        let mut la = Vec::new();
+        forward_lanes::<8>(&g, &p, 1.5, &arr, &mut la);
+        for l in 0..8 {
+            let want = forward_ref(&g, name, 1.5, &recs[l]);
+            for i in g.inputs..g.inputs + g.hidden {
+                assert!(
+                    (la[i][l] as f64 - want[i]).abs() < 1e-4,
+                    "{name} lane {l} node {i}: {} vs {}",
+                    la[i][l],
+                    want[i]
+                );
+            }
+        }
+    }
+}
