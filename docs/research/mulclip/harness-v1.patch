+#[test]
+fn derivative_matches_finite_difference() {
+    for d in [2, 3] {
+        let m = mc(d);
+        let f = |x: f64| {
+            let (b, d) = (m.b as f64, m.d as i32);
+            x * (1.0 - b * x.abs().powi(d - 1))
+        };
+        for i in -9..=9 {
+            let x = m.c as f64 * 0.99 * i as f64 / 9.0;
+            let h = 1e-5;
+            let fd = (f(x + h) - f(x - h)) / (2.0 * h);
+            assert!(
+                (m.derivative(x as f32) as f64 - fd).abs() < 1e-3,
+                "d={d} x={x}"
+            );
+        }
+        assert_eq!(m.derivative(m.c * 1.01), 0.0);
+        assert_eq!(m.derivative(-m.c * 1.01), 0.0);
+    }
+}
