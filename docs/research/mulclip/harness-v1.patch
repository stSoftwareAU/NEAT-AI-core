+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Manifest {
+    pub protocol_version: u32,
+    pub issue: u32,
+    pub source: String,
+    pub activations: Vec<String>,
+    pub control: String,
+    pub graph_specs: Vec<GraphSpec>,
+    pub timing: Timing,
+    pub fitness: Fitness,
+    pub bootstrap: Bootstrap,
+    pub criteria: Criteria,
+}
+
+pub fn parse_manifest(text: &str) -> Result<Manifest, String> {
+    let m: Manifest = serde_json::from_str(text).map_err(|e| format!("manifest: {e}"))?;
+    if m.protocol_version != 1 {
+        return Err(format!(
+            "manifest: protocol_version must be 1, got {}",
+            m.protocol_version
+        ));
+    }
+    if m.activations.is_empty() {
+        return Err("manifest: activations is empty".into());
+    }
+    for a in &m.activations {
+        Act::parse(a).map_err(|e| format!("manifest: {e}"))?;
+    }
+    if !m.activations.contains(&m.control) {
+        return Err(format!(
+            "manifest: control '{}' is not in activations",
+            m.control
+        ));
+    }
+    if m.graph_specs.is_empty() {
+        return Err("manifest: graph_specs is empty".into());
+    }
+    for s in &m.graph_specs {
+        s.validate().map_err(|e| format!("manifest: {e}"))?;
+    }
+    let f = &m.fitness;
+    if f.tasks.is_empty() || f.input_scales.is_empty() {
+        return Err("manifest: fitness needs tasks and input_scales".into());
+    }
+    for t in &f.tasks {
+        t.validate().map_err(|e| format!("manifest: {e}"))?;
+    }
+    if f.input_scales.iter().any(|s| !(*s > 0.0 && s.is_finite())) {
+        return Err("manifest: input_scales must be positive and finite".into());
+    }
+    if f.calibration_seeds.is_empty() || f.validation_seeds.is_empty() {
+        return Err("manifest: calibration_seeds and validation_seeds must be non-empty".into());
+    }
+    if let Some(s) = f
+        .calibration_seeds
+        .iter()
+        .find(|s| f.validation_seeds.contains(s))
+    {
+        return Err(format!(
+            "manifest: seed {s} is in both calibration_seeds and validation_seeds"
+        ));
+    }
+    if f.hidden_override == 0
+        || f.train == 0
+        || f.test == 0
+        || f.ridge_lambda.is_nan()
+        || f.ridge_lambda < 0.0
+    {
+        return Err("manifest: fitness sizes must be >= 1 and ridge_lambda >= 0".into());
+    }
+    let t = &m.timing;
+    if t.records == 0 || t.micro_len == 0 || t.repetitions == 0 {
+        return Err("manifest: timing records, micro_len and repetitions must be >= 1".into());
+    }
+    Ok(m)
+}
