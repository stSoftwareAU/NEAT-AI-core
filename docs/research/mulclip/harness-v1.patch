+fn ridge_recovers_known_weights_and_rejects_singular() {
+    // y = 2 a - 3 b + 0.5, noiseless.
+    let mut rng = Rng::new(4);
+    let rows: Vec<Vec<f64>> = (0..50)
+        .map(|_| vec![rng.normal(), rng.normal(), 1.0])
+        .collect();
+    let y: Vec<f64> = rows.iter().map(|r| 2.0 * r[0] - 3.0 * r[1] + 0.5).collect();
+    let w = ridge_fit(&rows, &y, 0.0).unwrap();
+    for (got, want) in w.iter().zip([2.0, -3.0, 0.5]) {
