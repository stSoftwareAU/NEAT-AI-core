+#[test]
+fn quick_run_completes_every_planned_cell() {
+    // Shrink the committed manifest so the debug build stays fast.
+    let mut m = parse_manifest(&committed()).unwrap();
+    for s in m.graph_specs.iter_mut() {
+        s.hidden = 16;
+    }
+    m.fitness.hidden_override = 12;
+    let r = run_experiment(&m, true);
+    assert!(r.quick);
+    assert_eq!(r.coverage.completed_cells, r.coverage.planned_cells);
+    assert!(r.coverage.planned_cells > 0);
+    assert!(r.failures.is_empty(), "{:?}", r.failures);
+    assert_eq!(r.assessment.status, "not-assessable-quick");
+    // Option fields legitimately serialise as null; every float must be finite.
+    for t in r.micro.iter().chain(&r.end_to_end) {
+        let all = t.samples_ns.iter().chain(&t.ratio_to_control);
+        assert!(
+            all.chain([&t.median_ratio, &t.ci_lo, &t.ci_hi])
+                .all(|v| v.is_finite())
+        );
+    }
+    assert!(
+        r.fitness_validation
+            .iter()
+            .all(|v| v.per_seed.iter().all(|x| x.is_finite()))
+    );
+}
