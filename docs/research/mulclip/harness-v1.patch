+#[test]
+fn assessment_statuses() {
+    let c = parse_manifest(&committed()).unwrap().criteria;
+    let a = assess(&synthetic(0.9, 0.05, false), &c);
+    assert_eq!(a.status, "candidate-pending-platforms");
+    assert!(a.per_variant.iter().all(|v| v.local_candidate));
