+/// Independent f64 forward pass over the CSR fields, using the closed-form
+/// reference rather than any harness activation.
+fn forward_ref(g: &Graph, name: &str, scale: f64, input: &[f32]) -> Vec<f64> {
+    let act = |x: f64| -> f64 {
+        match name {
+            "mulclip_d2" => mulclip_ref(x, 2),
+            "mulclip_d3" => mulclip_ref(x, 3),
+            "relu" => x.max(0.0),
+            "hard_tanh" => x.clamp(-1.0, 1.0),
+            _ => unreachable!("{name}"),
+        }
+    };
+    let mut a = vec![0.0f64; g.inputs + g.hidden];
+    for i in 0..g.inputs {
+        a[i] = input[i] as f64 * scale;
+    }
+    for j in 0..g.hidden {
+        let s = g.start[j] as usize;
+        let mut sum = g.bias[j] as f64;
+        for e in s..s + g.len[j] as usize {
+            sum += g.weight[e] as f64 * a[g.from[e] as usize];
+        }
+        a[g.inputs + j] = act(sum);
+    }
+    a
+}
