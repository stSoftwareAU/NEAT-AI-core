+    let a = assess(&synthetic(1.0, 0.05, false), &c);
+    assert_eq!(a.status, "no-candidate");
+    assert!(a.reasons.iter().any(|r| r.contains("speed")));
+
+    // Margin 0.02: -0.05 is worse than allowed.
+    let a = assess(&synthetic(0.9, -0.05, false), &c);
+    assert_eq!(a.status, "no-candidate");
+    assert!(a.reasons.iter().any(|r| r.contains("fitness")));
+
+    let a = assess(&synthetic(0.9, 0.05, true), &c);
+    assert_eq!(a.status, "not-assessable-quick");
+}
