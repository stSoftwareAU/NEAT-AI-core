+#[test]
+fn assessment_rules_are_isolated() {
+    let base = parse_manifest(&committed()).unwrap().criteria;
+    let strict = Criteria {
+        fitness_better_required: true,
+        ..base.clone()
+    };
+    let lax = Criteria {
+        fitness_better_required: false,
+        ..base.clone()
+    };
+    // Baseline: passes under the strict criteria.
+    let a = assess(&synthetic(0.9, 0.05, false), &strict);
+    assert_eq!(a.status, "candidate-pending-platforms");
+
+    // (a) Only median_ratio changes: above the limit while ci_hi stays < 1.0.
+    let mut r = synthetic(0.9, 0.05, false);
+    for t in r.end_to_end.iter_mut() {
+        t.median_ratio = strict.speed_ratio_max + 0.01;
+    }
+    let a = assess(&r, &strict);
+    assert_eq!(a.status, "no-candidate");
+    assert!(
+        a.reasons.iter().any(|x| x.contains("speed")),
+        "{:?}",
+        a.reasons
+    );
+
+    // (b) Only ci_lo changes: every row within margin, none with ci_lo > 0.
+    let mut r = synthetic(0.9, 0.05, false);
+    for v in r.fitness_validation.iter_mut() {
+        v.paired_vs_control.as_mut().unwrap().ci_lo = 0.0;
+    }
+    let a = assess(&r, &strict);
+    assert_eq!(a.status, "no-candidate");
+    assert!(
+        a.reasons
+            .iter()
+            .any(|x| x.contains("CI lower bound above 0")),
+        "{:?}",
+        a.reasons
+    );
+    let a = assess(&r, &lax);
+    assert_eq!(a.status, "candidate-pending-platforms");
+
+    // (c) Only `excluded` changes on one candidate's row.
+    let mut r = synthetic(0.9, 0.05, false);
+    r.fitness_validation[0].excluded = Some("probe".into());
+    let a = assess(&r, &strict);
+    assert!(
+        a.reasons.iter().any(|x| x.contains("excluded")),
+        "{:?}",
+        a.reasons
+    );
+    assert!(!a.per_variant[0].local_candidate);
+    assert!(a.per_variant[1].local_candidate);
+    let mut r = synthetic(0.9, 0.05, false);
+    for v in r.fitness_validation.iter_mut() {
+        v.excluded = Some("probe".into());
+    }
+    let a = assess(&r, &strict);
+    assert_eq!(a.status, "no-candidate");
+    assert!(a.reasons.iter().any(|x| x.contains("excluded")));
+}
