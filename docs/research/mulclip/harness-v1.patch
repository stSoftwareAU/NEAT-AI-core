+// ------------------------------------------------------------- assessment
+
+pub const CANDIDATES: [&str; 2] = ["mulclip_d2", "mulclip_d3"];
+
+pub fn assess(r: &Results, c: &Criteria) -> Assessment {
+    if r.quick {
+        return Assessment {
+            status: "not-assessable-quick".into(),
+            per_variant: vec![],
+            reasons: vec!["quick run: scaled-down sizes cannot be assessed".into()],
+        };
+    }
+    let mut specs: Vec<&str> = r.end_to_end.iter().map(|t| t.spec.as_str()).collect();
+    specs.sort();
+    specs.dedup();
+    let mut reasons = Vec::new();
+    let mut per_variant = Vec::new();
+    for v in CANDIDATES {
+        let mut speed_pass = !specs.is_empty();
+        if specs.is_empty() {
+            reasons.push(format!("{v}: speed: no end-to-end rows"));
+        }
+        for spec in &specs {
+            let row = r
+                .end_to_end
+                .iter()
+                .find(|t| t.spec == *spec && t.path == "lanes8" && t.activation == v);
+            match row {
+                None => {
+                    speed_pass = false;
+                    reasons.push(format!("{v}: speed: no lanes8 row for spec {spec}"));
+                }
+                Some(t) => {
+                    if !(t.median_ratio <= c.speed_ratio_max && t.ci_hi < 1.0) {
+                        speed_pass = false;
+                        reasons.push(format!(
+                            "{v}: speed: spec {spec} median ratio {:.3}, CI upper {:.3} \
+                             (needs median <= {} and CI upper < 1.0)",
+                            t.median_ratio, t.ci_hi, c.speed_ratio_max
+                        ));
+                    }
+                }
+            }
+        }
+        let rows: Vec<&ValidationRow> = r
+            .fitness_validation
+            .iter()
+            .filter(|x| x.activation == v)
+            .collect();
+        let mut fitness_pass = !rows.is_empty();
+        if rows.is_empty() {
+            reasons.push(format!("{v}: fitness: no validation rows"));
+        }
+        let mut better = false;
+        for row in &rows {
+            let cell = format!("{v}: fitness: {} x {}", row.task, row.spec);
+            if let Some(why) = &row.excluded {
+                fitness_pass = false;
+                reasons.push(format!("{cell} excluded ({why})"));
+                continue;
+            }
+            let Some(p) = &row.paired_vs_control else {
+                fitness_pass = false;
+                reasons.push(format!("{cell} has no paired difference"));
+                continue;
+            };
+            let margin = if row.metric == "accuracy" {
+                c.fitness_margin_accuracy
+            } else {
+                c.fitness_margin_nmse
+            };
+            if p.median.is_nan() || p.median <= -margin {
+                fitness_pass = false;
+                reasons.push(format!(
+                    "{cell} median paired difference {:.4} is not above -{margin}",
+                    p.median
+                ));
+            }
+            if p.ci_lo > 0.0 {
+                better = true;
+            }
+        }
+        if c.fitness_better_required && !better && !rows.is_empty() {
+            fitness_pass = false;
+            reasons.push(format!(
+                "{v}: fitness: no task x spec with CI lower bound above 0"
+            ));
+        }
+        per_variant.push(VariantAssessment {
+            activation: v.to_string(),
+            speed_pass,
+            fitness_pass,
+            local_candidate: speed_pass && fitness_pass,
+        });
+    }
+    let any = per_variant.iter().any(|v| v.local_candidate);
+    let status = if any {
+        let me = platform();
+        let missing: Vec<&String> = c.required_platforms.iter().filter(|p| **p != me).collect();
+        reasons.push(format!(
+            "local candidate on {me}; still needs results from {missing:?}"
+        ));
+        "candidate-pending-platforms"
+    } else {
+        "no-candidate"
+    };
+    Assessment {
+        status: status.into(),
+        per_variant,
+        reasons,
+    }
+}
