+// ------------------------------------------------------------- experiment
+
+fn boundary_inputs(mc: &MulClip) -> Vec<f32> {
+    let ulp = |x: f32, up: bool| f32::from_bits(if up { x.to_bits() + 1 } else { x.to_bits() - 1 });
+    vec![
+        0.0,
+        -0.0,
+        1e-40,
+        mc.peak,
+        mc.c,
+        ulp(mc.c, false),
+        ulp(mc.c, true),
+        1e6,
+        f32::MAX,
+        f32::INFINITY,
+        f32::NEG_INFINITY,
+        f32::NAN,
+    ]
+}
+
+fn boundaries(acts: &[Prepared]) -> Vec<BoundaryRow> {
+    let default = MulClip::new(2).expect("order 2 is valid");
+    let mut rows = Vec::new();
+    for p in acts {
+        let mc = p.mc.unwrap_or(default);
+        for x in boundary_inputs(&mc) {
+            rows.push(BoundaryRow {
+                activation: p.act.name(),
+                input: fmt_f32(x),
+                output: fmt_f32(p.apply(x)),
+            });
+        }
+    }
+    rows
+}
+
+/// Scale the manifest down for `--quick`.
+pub fn quick_manifest(m: &Manifest) -> Manifest {
+    let mut q = m.clone();
+    q.timing.repetitions = 3;
+    q.timing.warmup = 1;
+    q.timing.records = 64;
+    q.timing.micro_len = 512;
+    q.fitness.validation_seeds.truncate(2);
+    q.fitness.calibration_seeds.truncate(1);
+    q.fitness.train = 256;
+    q.fitness.test = 128;
+    q.bootstrap.iters = 200;
+    q
+}
+
+fn shuffle(order: &mut [usize], rng: &mut Rng) {
+    for i in (1..order.len()).rev() {
+        order.swap(i, rng.below(i + 1));
+    }
+}
+
+struct TimingScratch {
+    s: Vec<f32>,
+    l: Vec<[f32; 8]>,
+    out: Vec<f32>,
+    sink: f32,
+}
+
+fn micro_scalar(p: &Prepared, buf: &[f32], out: &mut [f32]) {
+    for (o, &x) in out.iter_mut().zip(buf) {
+        *o = p.apply(x);
+    }
+}
+
+fn micro_lanes(p: &Prepared, buf: &[f32], out: &mut [f32]) {
+    let (bc, brem) = buf.as_chunks::<8>();
+    let (oc, orem) = out.as_chunks_mut::<8>();
+    for (b, o) in bc.iter().zip(oc.iter_mut()) {
+        *o = p.apply_lanes(*b);
+    }
+    for (o, &x) in orem.iter_mut().zip(brem) {
+        *o = p.apply(x);
+    }
+}
+
+fn e2e_scalar(g: &Graph, p: &Prepared, recs: &[Vec<f32>], sc: &mut TimingScratch) {
+    for r in recs {
+        forward_scalar(g, p, 1.0, r, &mut sc.s);
+        sc.sink += sc.s[sc.s.len() - 1];
+    }
+}
+
+fn e2e_lanes8(g: &Graph, p: &Prepared, recs: &[Vec<f32>], sc: &mut TimingScratch) {
+    let (chunks, rem) = recs.as_chunks::<8>();
+    for c in chunks {
+        let arr: [&[f32]; 8] = std::array::from_fn(|i| c[i].as_slice());
+        forward_lanes::<8>(g, p, 1.0, &arr, &mut sc.l);
+        sc.sink += sc.l[sc.l.len() - 1][0];
+    }
+    for r in rem {
+        forward_scalar(g, p, 1.0, r, &mut sc.s);
+        sc.sink += sc.s[sc.s.len() - 1];
+    }
+}
+
+const PATHS: [&str; 2] = ["scalar", "lanes8"];
+
+fn run_timing(m: &Manifest, acts: &[Prepared], control: usize) -> (Vec<TimingRow>, Vec<TimingRow>) {
+    let t = &m.timing;
+    let na = acts.len();
+    let mut rng = Rng::new(t.seed);
+    let micro_buf: Vec<f32> = (0..t.micro_len)
+        .map(|_| (rng.normal() * 3.0) as f32)
+        .collect();
+    let graphs: Vec<Graph> = m
+        .graph_specs
+        .iter()
+        .enumerate()
+        .map(|(i, s)| Graph::generate(s, t.seed + 1 + i as u64))
+        .collect();
+    let records: Vec<Vec<Vec<f32>>> = m
+        .graph_specs
+        .iter()
+        .map(|s| {
+            (0..t.records)
+                .map(|_| {
+                    (0..s.inputs)
+                        .map(|_| (rng.next_f64() * 2.0 - 1.0) as f32)
+                        .collect()
+                })
+                .collect()
+        })
+        .collect();
+    let units = 1 + graphs.len();
+    let mut samples: Vec<Vec<f64>> = vec![Vec::new(); units * 2 * na];
+    let mut sc = TimingScratch {
+        s: Vec::new(),
+        l: Vec::new(),
+        out: vec![0.0; t.micro_len],
+        sink: 0.0,
+    };
+    let mut order: Vec<usize> = (0..na).collect();
+    let mut shuffle_rng = Rng::new(t.seed ^ 0xA5A5_A5A5);
+    for pass in 0..t.warmup + t.repetitions {
+        let record = pass >= t.warmup;
+        shuffle(&mut order, &mut shuffle_rng);
+        for &a in &order {
+            let p = &acts[a];
+            for path in 0..2 {
+                let t0 = Instant::now();
+                if path == 0 {
+                    micro_scalar(p, black_box(&micro_buf), &mut sc.out);
+                } else {
+                    micro_lanes(p, black_box(&micro_buf), &mut sc.out);
+                }
+                black_box(&sc.out);
+                let ns = t0.elapsed().as_nanos() as f64 / t.micro_len as f64;
+                if record {
+                    samples[path * na + a].push(ns);
+                }
+            }
+            for (gi, g) in graphs.iter().enumerate() {
+                for path in 0..2 {
+                    let recs = &records[gi];
+                    let t0 = Instant::now();
+                    if path == 0 {
+                        e2e_scalar(g, p, black_box(recs), &mut sc);
+                    } else {
+                        e2e_lanes8(g, p, black_box(recs), &mut sc);
+                    }
+                    black_box(sc.sink);
+                    let ns = t0.elapsed().as_nanos() as f64 / recs.len() as f64;
+                    if record {
+                        samples[((gi + 1) * 2 + path) * na + a].push(ns);
+                    }
+                }
+            }
+        }
+    }
+    let mut counter = 0u64;
+    let mut rows_for = |unit: usize, bench: &str, spec: &str| -> Vec<TimingRow> {
+        let mut rows = Vec::new();
+        for path in 0..2 {
+            let ctl = samples[(unit * 2 + path) * na + control].clone();
+            for a in 0..na {
+                let s = samples[(unit * 2 + path) * na + a].clone();
+                let ratios: Vec<f64> = s.iter().zip(&ctl).map(|(x, c)| x / c.max(1e-9)).collect();
+                counter += 1;
+                let (lo, hi) = bootstrap_median_ci(
+                    &ratios,
+                    m.bootstrap.iters,
+                    m.bootstrap.seed + counter,
+                    0.95,
+                );
+                rows.push(TimingRow {
+                    bench: bench.into(),
+                    spec: spec.into(),
+                    path: PATHS[path].into(),
+                    activation: acts[a].act.name(),
+                    median_ratio: median(&ratios),
+                    ratio_to_control: ratios,
+                    samples_ns: s,
+                    ci_lo: lo,
+                    ci_hi: hi,
+                });
+            }
+        }
+        rows
+    };
+    let micro = rows_for(0, "micro", "micro");
+    let mut e2e = Vec::new();
+    for (gi, s) in m.graph_specs.iter().enumerate() {
+        e2e.extend(rows_for(gi + 1, "end_to_end", &s.name));
+    }
+    (micro, e2e)
+}
+
+fn fitness_graph(task: &Task, spec: &GraphSpec, hidden: u32, seed: u64, si: usize) -> Graph {
+    let s = GraphSpec {
+        name: spec.name.clone(),
+        inputs: task.input_count(),
+        hidden,
+        degree: spec.degree.clone(),
+    };
+    Graph::generate(&s, seed + 1000 * si as u64)
+}
+
+fn fitness_data(task: &Task, f: &Fitness, seed: u64, ti: usize) -> Dataset {
+    make_dataset(task, seed + 7_000_000 + 100 * ti as u64, f.train, f.test)
+}
+
+struct FitnessOut {
+    calib: Vec<CalibRow>,
+    valid: Vec<ValidationRow>,
+    search_fits: u64,
+    validation_fits: u64,
+}
+
+fn run_fitness(
+    m: &Manifest,
+    acts: &[Prepared],
+    control: usize,
+    failures: &mut Vec<FailureRow>,
+) -> FitnessOut {
+    let f = &m.fitness;
+    let (nt, ns, na, nk) = (
+        f.tasks.len(),
+        m.graph_specs.len(),
+        acts.len(),
+        f.input_scales.len(),
+    );
+    let cell = |t: usize, s: usize, a: usize| (t * ns + s) * na + a;
+    let mut metrics: Vec<Vec<Vec<f64>>> = vec![vec![Vec::new(); nk]; nt * ns * na];
+    let mut failed: Vec<Vec<bool>> = vec![vec![false; nk]; nt * ns * na];
+    let mut search_fits = 0u64;
+    for &seed in &f.calibration_seeds {
+        for (ti, task) in f.tasks.iter().enumerate() {
+            let ds = fitness_data(task, f, seed, ti);
+            for (si, spec) in m.graph_specs.iter().enumerate() {
+                let g = fitness_graph(task, spec, f.hidden_override, seed, si);
+                for (ai, p) in acts.iter().enumerate() {
+                    for (k, &scale) in f.input_scales.iter().enumerate() {
+                        search_fits += 1;
+                        match evaluate(task, &g, &ds, p, scale as f32, f.ridge_lambda) {
+                            Ok(v) => metrics[cell(ti, si, ai)][k].push(v),
+                            Err(e) => {
+                                failed[cell(ti, si, ai)][k] = true;
+                                failures.push(FailureRow {
+                                    phase: "calibration".into(),
+                                    task: task.name(),
+                                    spec: spec.name.clone(),
+                                    activation: p.act.name(),
+                                    seed,
+                                    reason: format!("scale {scale}: {}", e.reason()),
+                                });
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    let mut calib = Vec::new();
+    let mut chosen: Vec<Option<f32>> = vec![None; nt * ns * na];
+    for (ti, task) in f.tasks.iter().enumerate() {
+        let higher = task.metric() == "accuracy";
+        for (si, spec) in m.graph_specs.iter().enumerate() {
+            for (ai, p) in acts.iter().enumerate() {
+                let c = cell(ti, si, ai);
+                let means: Vec<ScaleMean> = (0..nk)
+                    .map(|k| ScaleMean {
+                        scale: f.input_scales[k],
+                        mean: if failed[c][k] || metrics[c][k].is_empty() {
+                            None
+                        } else {
+                            Some(metrics[c][k].iter().sum::<f64>() / metrics[c][k].len() as f64)
+                        },
+                    })
+                    .collect();
+                let mut best: Option<(f64, f64)> = None;
+                for sm in &means {
+                    if let Some(v) = sm.mean {
+                        let better = match best {
+                            None => true,
+                            Some((_, b)) => (higher && v > b) || (!higher && v < b),
+                        };
+                        if better {
+                            best = Some((sm.scale, v));
+                        }
+                    }
+                }
+                chosen[c] = best.map(|(s, _)| s as f32);
+                calib.push(CalibRow {
+                    task: task.name(),
+                    spec: spec.name.clone(),
+                    activation: p.act.name(),
+                    chosen_scale: best.map(|(s, _)| s),
+                    per_scale_mean: means,
+                });
+            }
+        }
+    }
+    let mut per_seed: Vec<Vec<f64>> = vec![Vec::new(); nt * ns * na];
+    let mut excluded: Vec<Option<String>> = vec![None; nt * ns * na];
+    let mut validation_fits = 0u64;
+    for &seed in &f.validation_seeds {
+        for (ti, task) in f.tasks.iter().enumerate() {
+            let ds = fitness_data(task, f, seed, ti);
+            for (si, spec) in m.graph_specs.iter().enumerate() {
+                let g = fitness_graph(task, spec, f.hidden_override, seed, si);
+                for (ai, p) in acts.iter().enumerate() {
+                    let c = cell(ti, si, ai);
+                    if excluded[c].is_some() {
+                        continue;
+                    }
+                    let Some(scale) = chosen[c] else {
+                        excluded[c] =
+                            Some("no calibration scale completed without a failure".into());
+                        continue;
+                    };
+                    validation_fits += 1;
+                    match evaluate(task, &g, &ds, p, scale, f.ridge_lambda) {
+                        Ok(v) => per_seed[c].push(v),
+                        Err(e) => {
+                            excluded[c] = Some(format!("seed {seed}: {}", e.reason()));
+                            failures.push(FailureRow {
+                                phase: "validation".into(),
+                                task: task.name(),
+                                spec: spec.name.clone(),
+                                activation: p.act.name(),
+                                seed,
+                                reason: e.reason(),
+                            });
+                        }
+                    }
+                }
+            }
+        }
+    }
+    let mut valid = Vec::new();
+    let mut counter = 0u64;
+    for (ti, task) in f.tasks.iter().enumerate() {
+        let higher = task.metric() == "accuracy";
+        for (si, spec) in m.graph_specs.iter().enumerate() {
+            for (ai, p) in acts.iter().enumerate() {
+                let c = cell(ti, si, ai);
+                let cc = cell(ti, si, control);
+                let mut why = excluded[c].clone();
+                if why.is_none() && excluded[cc].is_some() {
+                    why = Some("control cell excluded".into());
+                }
+                let paired = if why.is_none() && ai != control {
+                    let diffs: Vec<f64> = per_seed[c]
+                        .iter()
+                        .zip(&per_seed[cc])
+                        .map(|(a, t)| if higher { a - t } else { t - a })
+                        .collect();
+                    counter += 1;
+                    let (lo, hi) = bootstrap_median_ci(
+                        &diffs,
+                        m.bootstrap.iters,
+                        m.bootstrap.seed + 100_000 + counter,
+                        0.95,
+                    );
+                    Some(Paired {
+                        median: median(&diffs),
+                        ci_lo: lo,
+                        ci_hi: hi,
+                    })
+                } else {
+                    None
+                };
+                valid.push(ValidationRow {
+                    task: task.name(),
+                    metric: task.metric().into(),
+                    spec: spec.name.clone(),
+                    activation: p.act.name(),
+                    per_seed: if why.is_some() {
+                        Vec::new()
+                    } else {
+                        per_seed[c].clone()
+                    },
+                    paired_vs_control: paired,
+                    excluded: why,
+                });
+            }
+        }
+    }
+    FitnessOut {
+        calib,
+        valid,
+        search_fits,
+        validation_fits,
+    }
+}
+
+/// Run the whole experiment. `quick` scales the manifest down and makes the
+/// assessment "not-assessable-quick".
+pub fn run_experiment(manifest: &Manifest, quick: bool) -> Results {
+    let started = Instant::now();
+    let m = if quick {
+        quick_manifest(manifest)
+    } else {
+        manifest.clone()
+    };
+    let acts: Vec<Prepared> = m
+        .activations
+        .iter()
+        .map(|n| Prepared::from_name(n).expect("manifest was validated"))
+        .collect();
+    let control = m
+        .activations
+        .iter()
+        .position(|a| *a == m.control)
+        .expect("manifest was validated");
+    let mut r = Results::empty(m.clone(), quick);
+    r.boundaries = boundaries(&acts);
+    let (micro, e2e) = run_timing(&m, &acts, control);
+    r.micro = micro;
+    r.end_to_end = e2e;
+    let fout = run_fitness(&m, &acts, control, &mut r.failures);
+    r.fitness_calibration = fout.calib;
+    r.fitness_validation = fout.valid;
+    let na = acts.len() as u64;
+    let planned = na * 2
+        + m.graph_specs.len() as u64 * na * 2
+        + m.fitness.tasks.len() as u64 * m.graph_specs.len() as u64 * na;
+    let completed = (r.micro.len() + r.end_to_end.len()) as u64
+        + r.fitness_validation
+            .iter()
+            .filter(|v| v.excluded.is_none())
+            .count() as u64;
+    r.coverage = Coverage {
+        planned_cells: planned,
+        completed_cells: completed,
+        search_fits: fout.search_fits,
+        validation_fits: fout.validation_fits,
+        wall_seconds: started.elapsed().as_secs_f64(),
+    };
+    r.assessment = assess(&r, &m.criteria);
+    r
+}
+
+/// Short human-readable summary for the runner.
+pub fn summary_table(r: &Results) -> String {
+    let mut s = String::new();
+    s.push_str(&format!(
+        "platform {} quick {} wall {:.1}s\n",
+        r.platform, r.quick, r.coverage.wall_seconds
+    ));
+    s.push_str("end-to-end median ratio to control (CI)\n");
+    for t in &r.end_to_end {
+        s.push_str(&format!(
+            "  {:<12} {:<7} {:<18} {:.3} [{:.3}, {:.3}]\n",
+            t.spec, t.path, t.activation, t.median_ratio, t.ci_lo, t.ci_hi
+        ));
+    }
+    s.push_str("fitness paired median vs control, positive = better (CI)\n");
+    for v in &r.fitness_validation {
+        match (&v.paired_vs_control, &v.excluded) {
+            (Some(p), _) => s.push_str(&format!(
+                "  {:<9} {:<12} {:<18} {:+.4} [{:+.4}, {:+.4}]\n",
+                v.task, v.spec, v.activation, p.median, p.ci_lo, p.ci_hi
+            )),
+            (None, Some(why)) => s.push_str(&format!(
+                "  {:<9} {:<12} {:<18} excluded: {why}\n",
+                v.task, v.spec, v.activation
+            )),
+            _ => {}
+        }
+    }
+    s.push_str(&format!(
+        "cells {}/{} failures {}\nassessment: {}\n",
+        r.coverage.completed_cells,
+        r.coverage.planned_cells,
+        r.failures.len(),
+        r.assessment.status
+    ));
+    for reason in &r.assessment.reasons {
+        s.push_str(&format!("  - {reason}\n"));
+    }
+    s
+}
diff --git a/neat-core/examples/mulclip_experiment.rs b/neat-core/examples/mulclip_experiment.rs
new file mode 100644
index 0000000..d1f0a89
--- /dev/null
+++ b/neat-core/examples/mulclip_experiment.rs
@@ -0,0 +1,62 @@
+//! Issue #760: runs the opt-in MulClip benchmark and writes the results JSON.
+//!
+//! cargo run --release -p neat-core --example mulclip_experiment -- \
+//!   --manifest docs/research/mulclip/manifest.json --out results.json [--quick]
+#[path = "../benches/mulclip_experiment/mod.rs"]
+mod harness;
+
+const USAGE: &str = "usage: mulclip_experiment --manifest <path> --out <path> [--quick] \
+[--code-rev <s>] [--rustc <s>]";
+
+fn main() {
+    let mut manifest = None;
+    let mut out = None;
+    let mut quick = false;
+    let mut code_rev = "unknown".to_string();
+    let mut rustc = "unknown".to_string();
+    let mut args = std::env::args().skip(1);
+    while let Some(a) = args.next() {
+        let mut value = |name: &str| {
+            args.next().unwrap_or_else(|| {
+                eprintln!("{name} needs a value\n{USAGE}");
+                std::process::exit(2)
+            })
+        };
+        match a.as_str() {
+            "--manifest" => manifest = Some(value("--manifest")),
+            "--out" => out = Some(value("--out")),
+            "--code-rev" => code_rev = value("--code-rev"),
+            "--rustc" => rustc = value("--rustc"),
+            "--quick" => quick = true,
+            other => {
+                eprintln!("unknown argument '{other}'\n{USAGE}");
+                std::process::exit(2);
+            }
+        }
+    }
+    let (Some(manifest), Some(out)) = (manifest, out) else {
+        eprintln!("{USAGE}");
+        std::process::exit(2);
+    };
+    let text = std::fs::read_to_string(&manifest).unwrap_or_else(|e| {
+        eprintln!("cannot read manifest {manifest}: {e}");
+        std::process::exit(1)
+    });
+    let m = harness::parse_manifest(&text).unwrap_or_else(|e| {
+        eprintln!("{manifest}: {e}");
+        std::process::exit(1)
+    });
+    let mut r = harness::run_experiment(&m, quick);
+    r.code_rev = code_rev;
+    r.rustc = rustc;
+    let json = serde_json::to_string_pretty(&r).unwrap_or_else(|e| {
+        eprintln!("cannot serialise results: {e}");
+        std::process::exit(1)
+    });
+    std::fs::write(&out, json).unwrap_or_else(|e| {
+        eprintln!("cannot write {out}: {e}");
+        std::process::exit(1)
+    });
+    print!("{}", harness::summary_table(&r));
+    println!("wrote {out}");
+}
diff --git a/neat-core/tests/mulclip_experiment.rs b/neat-core/tests/mulclip_experiment.rs
new file mode 100644
index 0000000..9eee26e
--- /dev/null
+++ b/neat-core/tests/mulclip_experiment.rs
@@ -0,0 +1,627 @@
+//! Issue #760: behaviour tests for the MulClip experiment harness.
+#[path = "../benches/mulclip_experiment/mod.rs"]
+mod harness;
+
+use harness::*;
+
+fn mc(d: u32) -> MulClip {
+    MulClip::new(d).unwrap()
+}
+
+fn same(a: f32, b: f32) -> bool {
+    (a.is_nan() && b.is_nan()) || a.to_bits() == b.to_bits()
+}
+
+fn grid() -> Vec<f32> {
+    let mut v: Vec<f32> = (-1200..=1200).map(|i| i as f32 * 0.005).collect();
+    for d in 2..=8 {
+        let m = mc(d);
+        for x in [m.peak, m.c] {
+            v.push(x);
+            v.push(-x);
+            v.push(f32::from_bits(x.to_bits() - 1));
+            v.push(f32::from_bits(x.to_bits() + 1));
+        }
+    }
+    v.extend([
+        1e-40,
+        1e6,
+        f32::MAX,
+        f32::INFINITY,
+        f32::NEG_INFINITY,
+        f32::NAN,
+    ]);
+    v
+}
+
+#[test]
+fn coefficients_match_closed_forms() {
+    // d=2: b = 1/4, c = 2^2/1 = 4, peak 2. d=3: b = 4/27, c = 3^1.5/2, peak 3/2.
+    let a = mc(2);
+    assert!((a.b - 0.25).abs() < 1e-6 && (a.c - 4.0).abs() < 1e-6 && (a.peak - 2.0).abs() < 1e-6);
+    let b = mc(3);
+    assert!((b.b - 4.0 / 27.0).abs() < 1e-6);
+    assert!((b.c - 3.0 * 3f32.sqrt() / 2.0).abs() < 1e-6);
+    assert!((b.peak - 1.5).abs() < 1e-6);
+}
+
+#[test]
+fn slope_is_one_at_zero_and_peak_is_one() {
+    for d in 2..=5 {
+        let m = mc(d);
+        assert!((m.derivative(0.0) - 1.0).abs() < 1e-6, "slope d={d}");
+        assert!((m.apply(m.peak) - 1.0).abs() < 1e-6, "peak d={d}");
+    }
+}
+
+#[test]
+fn mulclip_is_odd() {
+    for d in [2, 3] {
+        for x in grid().into_iter().filter(|x| !x.is_nan()) {
+            assert_eq!(mc(d).apply(-x), -mc(d).apply(x), "d={d} x={x}");
+        }
+    }
+}
+
+#[test]
+fn regimes_rise_fall_and_clip() {
+    for d in [2, 3] {
+        let m = mc(d);
+        let mut prev = 0.0f32;
+        for i in 1..=100 {
+            let x = m.peak * 0.99 * i as f32 / 100.0;
+            let y = m.apply(x);
+            assert!(y > prev, "rising d={d} x={x}");
+            prev = y;
+        }
+        let mut prev = m.apply(m.peak * 1.001);
+        for i in 1..=99 {
+            let x = m.peak * 1.001 + (m.c * 0.999 - m.peak * 1.001) * i as f32 / 99.0;
+            let y = m.apply(x);
+            assert!(y < prev, "falling d={d} x={x}");
+            prev = y;
+        }
+        for x in [m.c, m.c * 1.5, 100.0] {
+            assert_eq!(m.apply(x), 0.0);
+            assert_eq!(m.apply(-x), 0.0);
+        }
+        for x in [m.peak, m.peak * 1.2, m.c, 50.0] {
+            assert_eq!(m.apply_mono(x), 1.0);
+            assert_eq!(m.apply_mono(-x), -1.0);
+        }
+        for x in [0.0f32, 0.3, -0.7, m.peak * 0.9] {
+            assert_eq!(m.apply_mono(x), m.apply(x));
+        }
+    }
+}
+
+#[test]
+fn hand_oracle_values() {
+    // d=2: x(1 - x/4): 1 -> 0.75; 3 -> 3 * 0.25 = 0.75 (same output, so the
+    // function is not injective and cannot be inverted from its output).
+    assert_eq!(mc(2).apply(1.0), 0.75);
+    assert_eq!(mc(2).apply(3.0), 0.75);
+    // d=3: 1 - (4/27) * 1.
+    assert!((mc(3).apply(1.0) - (1.0 - 4.0 / 27.0)).abs() < 1e-6);
+}
+
+#[test]
+fn non_finite_inputs() {
+    for d in [2, 3] {
+        let m = mc(d);
+        assert!(m.apply(f32::NAN).is_nan() && m.apply_mono(f32::NAN).is_nan());
+        assert!(m.apply_lanes([f32::NAN; 4])[0].is_nan());
+        assert!(m.apply_mono_lanes([f32::NAN; 4])[3].is_nan());
+        for x in [f32::INFINITY, f32::NEG_INFINITY, f32::MAX, f32::MIN] {
+            assert_eq!(m.apply(x), 0.0);
+            assert_eq!(m.apply_mono(x), x.signum());
+        }
+        for x in grid().into_iter().filter(|x| x.is_finite()) {
+            assert!(m.apply(x).is_finite() && m.apply_mono(x).is_finite());
+        }
+    }
+}
+
+#[test]
+fn lanes_pin_agreement_with_scalar_bit_for_bit() {
+    // Pins lane/scalar agreement only; the independent oracle is
+    // `lanes_match_independent_closed_form`.
+    let g = grid();
+    for d in 2..=8 {
+        let m = mc(d);
+        for a in g.as_chunks::<8>().0.iter().copied() {
+            let (l, lm) = (m.apply_lanes(a), m.apply_mono_lanes(a));
+            for i in 0..8 {
+                assert!(same(l[i], m.apply(a[i])), "d={d} x={}", a[i]);
+                assert!(same(lm[i], m.apply_mono(a[i])), "mono d={d} x={}", a[i]);
+            }
+        }
+        for a in g.as_chunks::<4>().0.iter().copied() {
+            let l = m.apply_lanes(a);
+            for i in 0..4 {
+                assert!(same(l[i], m.apply(a[i])));
+            }
+        }
+    }
+}
+
+/// Independent f64 oracle: closed form computed from scratch, sharing nothing
+/// with the harness. b = (d-1)^(d-1)/d^d, c = d^(d/(d-1))/(d-1), peak = d/(d-1).
+fn ref_consts(d: u32) -> (f64, f64, f64) {
+    let df = d as f64;
+    (
+        (df - 1.0).powf(df - 1.0) / df.powf(df),
+        df.powf(df / (df - 1.0)) / (df - 1.0),
+        df / (df - 1.0),
+    )
+}
+
+fn mulclip_ref(x: f64, d: u32) -> f64 {
+    if x.is_nan() {
+        return f64::NAN;
+    }
+    let (b, c, _) = ref_consts(d);
+    if x.abs() >= c {
+        0.0
+    } else {
+        x * (1.0 - b * x.abs().powf(d as f64 - 1.0))
+    }
+}
+
+fn mulclip_mono_ref(x: f64, d: u32) -> f64 {
+    if x.is_nan() {
+        return f64::NAN;
+    }
+    let (b, _, peak) = ref_consts(d);
+    if x.abs() >= peak {
+        x.signum()
+    } else {
+        x * (1.0 - b * x.abs().powf(d as f64 - 1.0))
+    }
+}
+
+#[test]
+fn lanes_match_independent_closed_form() {
+    // 2001 points on [-6, 6] plus seven specials = 2008 = 251 chunks of 8.
+    let mut xs: Vec<f32> = (0..2001)
+        .map(|i| (-6.0 + 12.0 * i as f64 / 2000.0) as f32)
+        .collect();
+    xs.extend([
+        f32::NAN,
+        f32::INFINITY,
+        f32::NEG_INFINITY,
+        f32::MAX,
+        f32::MIN,
+        0.0,
+        -0.0,
+    ]);
+    assert_eq!(xs.len() % 8, 0);
+    let mut compared = 0usize;
+    for d in [2u32, 3, 4] {
+        let m = mc(d);
+        let (_, c, peak) = ref_consts(d);
+        for chunk in xs.as_chunks::<8>().0 {
+            let (l, lm) = (m.apply_lanes(*chunk), m.apply_mono_lanes(*chunk));
+            for i in 0..8 {
+                let x = chunk[i] as f64;
+                // f32 rounding of the threshold may legitimately flip the branch.
+                if x.is_finite() && (x.abs() - c).abs() < 1e-4 {
+                    continue;
+                }
+                let (want, got) = (mulclip_ref(x, d), l[i] as f64);
+                if want.is_nan() {
+                    assert!(got.is_nan(), "d={d} x={x}");
+                } else {
+                    assert!((got - want).abs() < 1e-5, "d={d} x={x} {got} vs {want}");
+                    compared += 1;
+                }
+                if x.is_finite() && (x.abs() - peak).abs() < 1e-4 {
+                    continue;
+                }
+                let (want, got) = (mulclip_mono_ref(x, d), lm[i] as f64);
+                if want.is_nan() {
+                    assert!(got.is_nan(), "mono d={d} x={x}");
+                } else {
+                    assert!(
+                        (got - want).abs() < 1e-5,
+                        "mono d={d} x={x} {got} vs {want}"
+                    );
+                }
+            }
+        }
+    }
+    assert!(
+        compared > 3 * 1900,
