+fn e2e(act: &str, spec: &str, median_ratio: f64, ci_hi: f64) -> TimingRow {
+    TimingRow {
+        bench: "end_to_end".into(),
+        spec: spec.into(),
+        path: "lanes8".into(),
+        activation: act.into(),
+        samples_ns: vec![1.0; 21],
+        ratio_to_control: vec![median_ratio; 21],
+        median_ratio,
+        ci_lo: 0.0,
+        ci_hi,
+    }
+}
+
+fn fit(act: &str, median: f64, ci_lo: f64) -> ValidationRow {
+    ValidationRow {
+        task: "parity6".into(),
+        metric: "accuracy".into(),
+        spec: "s".into(),
+        activation: act.into(),
+        per_seed: vec![0.8; 10],
+        paired_vs_control: Some(Paired {
+            median,
+            ci_lo,
+            ci_hi: median + 0.1,
+        }),
+        excluded: None,
+    }
+}
+
+fn synthetic(speed_hi: f64, fit_median: f64, quick: bool) -> Results {
+    let m = parse_manifest(&committed()).unwrap();
+    let mut r = Results::empty(m.clone(), quick);
+    for act in &m.activations {
+        for path in ["scalar", "lanes8"] {
+            for distribution in ["wide", "narrow"] {
+                let mut t = e2e(act, distribution, 0.8, speed_hi);
+                t.path = path.into();
+                t.bench = "micro".into();
+                r.micro.push(t);
+            }
+            for spec in &m.graph_specs {
+                let mut t = e2e(act, &spec.name, 0.8, speed_hi);
+                t.path = path.into();
+                r.end_to_end.push(t);
+            }
+        }
+        for task in &m.fitness.tasks {
+            for spec in &m.graph_specs {
+                let mut v = fit(act, fit_median, fit_median.max(0.0) * 0.5);
+                v.task = task.name();
+                v.spec = spec.name.clone();
+                v.metric = task.metric().into();
+                r.fitness_validation.push(v);
+                r.fitness_calibration.push(CalibRow {
+                    task: task.name(),
+                    spec: spec.name.clone(),
+                    activation: act.clone(),
+                    chosen_scale: Some(1.0),
+                    per_scale_mean: m
+                        .fitness
+                        .input_scales
+                        .iter()
+                        .map(|&scale| ScaleMean {
+                            scale,
+                            mean: Some(0.8),
+                        })
+                        .collect(),
+                });
+            }
+        }
+    }
+    let cells = r.fitness_validation.len() as u64;
+    let planned = (r.micro.len() + r.end_to_end.len()) as u64 + cells;
+    r.coverage = Coverage {
+        planned_cells: planned,
+        completed_cells: planned,
+        search_fits: cells
+            * m.fitness.input_scales.len() as u64
+            * m.fitness.calibration_seeds.len() as u64,
+        validation_fits: cells * m.fitness.validation_seeds.len() as u64,
+        wall_seconds: 1.0,
+        preparation_seconds: 0.0,
+        timing_seconds: 0.0,
+        fitness_seconds: 0.0,
+    };
+    r
+}
