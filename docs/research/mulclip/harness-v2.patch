+#[test]
+fn core_kernel_paths_agree_with_independent_graph_and_public_inference() {
+    for spec in [
+        heavy_spec(),
+        GraphSpec {
+            name: "wide".into(),
+            inputs: 2461,
+            hidden: 1673,
+            degree: Degree::CoreFixture {
+                label: "production".into(),
+            },
+        },
+    ] {
+        let g = Graph::generate(&spec, 5);
+        let recs: Vec<Vec<f32>> = (0..8)
+            .map(|lane| {
+                (0..g.inputs)
+                    .map(|i| ((i * 13 + lane * 7) % 17) as f32 / 17.0 - 0.5)
+                    .collect()
+            })
+            .collect();
+        let arr = std::array::from_fn(|i| recs[i].as_slice());
+        for name in ["mulclip_d2", "mulclip_d3", "relu", "hard_tanh", "tanh"] {
+            let squash = match name {
+                "relu" => neat_core::squash::SquashType::Relu,
+                "hard_tanh" => neat_core::squash::SquashType::HardTanh,
+                _ => neat_core::squash::SquashType::Tanh,
+            };
+            let mut net = g.compile(squash);
+            let p = Prepared::from_name(name).unwrap();
+            let mut lanes = Vec::new();
+            core_forward_lanes(&net, &p, &arr, &mut lanes);
+            if !name.starts_with("mulclip") {
+                let flat: Vec<f32> = recs.iter().flatten().copied().collect();
+                let scored = net.score_records_flat(&flat, g.inputs, 1);
+                for lane in 0..8 {
+                    assert!(
+                        (scored[lane] - lanes[(g.inputs + g.hidden - 1) * 8 + lane]).abs() < 1e-3,
+                        "public batch {name} lane {lane}"
+                    );
+                }
+            }
+            for lane in 0..8 {
+                let mut scalar = Vec::new();
+                core_forward_scalar(&net, &p, &recs[lane], &mut scalar);
+                let expected = if name == "tanh" {
+                    net.activate(&recs[lane], 1);
+                    net.activations().iter().map(|&x| x as f64).collect()
+                } else {
+                    forward_ref(&g, name, 1.0, &recs[lane])
+                };
+                for j in g.inputs..g.inputs + g.hidden {
+                    assert!(
+                        (scalar[j] as f64 - expected[j]).abs() < 1e-4,
+                        "scalar {name} {j}"
+                    );
+                    assert!(
+                        (lanes[j * 8 + lane] as f64 - expected[j]).abs() < 1e-3,
+                        "lanes {name} {j}"
+                    );
+                }
+            }
+        }
+    }
+}
