+#[test]
+fn published_float32_clips_input_then_subtracts_rounded_product() {
+    // Eq. (1)-(2), separate Float32 operations, round-to-nearest-even.
+    // For d3: c=0x402646e1, alpha=0x3e17b426; the rounded product
+    // at c is one ulp below c, so the residual is 2^-22, not exact zero.
+    for (d, x, bits) in [
+        (2, 0.7f32, 0x3f13d70a),
+        (3, 0.7f32, 0x3f263100),
+        (3, 3.0f32, 0x34800000),
+        (3, f32::MAX, 0x34800000),
+        (3, f32::INFINITY, 0x34800000),
+        (3, f32::NEG_INFINITY, 0xb4800000),
+    ] {
+        let m = mc(d);
+        assert_eq!(m.apply(x).to_bits(), bits, "d={d} x={x}");
+        assert_eq!(m.apply_lanes([x; 8])[7].to_bits(), bits);
+    }
+}
