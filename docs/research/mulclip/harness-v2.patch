+pub const CANDIDATES: [&str; 2] = ["mulclip_d2", "mulclip_d3"];
+
+/// Refuse incomplete or failed runs before interpreting their statistical summaries.
+fn result_integrity(r: &Results) -> Result<(), String> {
+    if !r.failures.is_empty() {
+        return Err(format!("{} recorded failures", r.failures.len()));
+    }
+    let m = &r.manifest;
+    for (rows, specs, bench) in [
+        (&r.micro, vec!["wide", "narrow"], "micro"),
+        (
+            &r.end_to_end,
+            m.graph_specs.iter().map(|s| s.name.as_str()).collect(),
+            "end_to_end",
+        ),
+    ] {
+        if rows.len() != specs.len() * PATHS.len() * m.activations.len() {
+            return Err(format!("{bench}: missing or extra result cells"));
+        }
+        for spec in specs {
+            for path in PATHS {
+                for act in &m.activations {
+                    let matches: Vec<_> = rows
+                        .iter()
+                        .filter(|t| {
+                            t.spec == spec
+                                && t.path == path
+                                && t.activation == *act
+                                && t.bench == bench
+                        })
+                        .collect();
+                    if matches.len() != 1 {
+                        return Err(format!("{bench}: missing or duplicate {spec}/{path}/{act}"));
+                    }
+                    let t = matches[0];
+                    let n = m.timing.repetitions as usize;
+                    if t.samples_ns.len() != n
+                        || t.ratio_to_control.len() != n
+                        || t.samples_ns
+                            .iter()
+                            .chain(&t.ratio_to_control)
+                            .any(|x| !x.is_finite() || *x <= 0.0)
+                        || [t.median_ratio, t.ci_lo, t.ci_hi]
+                            .iter()
+                            .any(|x| !x.is_finite())
+                        || t.ci_lo > t.ci_hi
+                    {
+                        return Err(format!("{bench}: invalid samples for {spec}/{path}/{act}"));
+                    }
+                }
+            }
+        }
+    }
+    let cells = m.fitness.tasks.len() * m.graph_specs.len() * m.activations.len();
+    if r.fitness_validation.len() != cells || r.fitness_calibration.len() != cells {
+        return Err("fitness: missing or extra result cells".into());
+    }
+    for task in &m.fitness.tasks {
+        for spec in &m.graph_specs {
+            for act in &m.activations {
+                let valid: Vec<_> = r
+                    .fitness_validation
+                    .iter()
+                    .filter(|t| {
+                        t.task == task.name() && t.spec == spec.name && t.activation == *act
+                    })
+                    .collect();
+                let calib: Vec<_> = r
+                    .fitness_calibration
+                    .iter()
+                    .filter(|t| {
+                        t.task == task.name() && t.spec == spec.name && t.activation == *act
+                    })
+                    .collect();
+                if valid.len() != 1 || calib.len() != 1 {
+                    return Err(format!(
+                        "fitness: missing or duplicate {}/{}/{act}",
+                        task.name(),
+                        spec.name
+                    ));
+                }
+                let v = valid[0];
+                let c = calib[0];
+                if v.excluded.is_some() {
+                    return Err(format!(
+                        "fitness: excluded {}/{}/{act}",
+                        task.name(),
+                        spec.name
+                    ));
+                }
+                if v.metric != task.metric()
+                    || v.per_seed.len() != m.fitness.validation_seeds.len()
+                    || v.per_seed.iter().any(|x| !x.is_finite())
+                    || c.chosen_scale.is_none()
+                    || c.per_scale_mean.len() != m.fitness.input_scales.len()
+                    || c.per_scale_mean
+                        .iter()
+                        .any(|s| s.mean.is_none_or(|x| !x.is_finite()))
+                {
+                    return Err(format!(
+                        "fitness: incomplete samples for {}/{}/{act}",
+                        task.name(),
+                        spec.name
+                    ));
+                }
+                if *act != m.control
+                    && v.paired_vs_control.as_ref().is_none_or(|p| {
+                        !p.median.is_finite()
+                            || !p.ci_lo.is_finite()
+                            || !p.ci_hi.is_finite()
+                            || p.ci_lo > p.ci_hi
+                    })
+                {
+                    return Err(format!("fitness: invalid paired difference for {act}"));
+                }
+            }
+        }
+    }
+    let planned = (r.micro.len() + r.end_to_end.len() + cells) as u64;
+    let fits = cells as u64;
+    if r.coverage.planned_cells != planned
+        || r.coverage.completed_cells != planned
+        || r.coverage.search_fits
+            != fits * m.fitness.input_scales.len() as u64 * m.fitness.calibration_seeds.len() as u64
+        || r.coverage.validation_fits != fits * m.fitness.validation_seeds.len() as u64
+    {
+        return Err("coverage disagrees with manifest and completed cells".into());
+    }
+    Ok(())
+}
+
+pub fn assess(r: &Results, c: &Criteria) -> Assessment {
+    if r.quick {
+        return Assessment {
+            status: "not-assessable-quick".into(),
+            per_variant: vec![],
+            reasons: vec!["quick run: scaled-down sizes cannot be assessed".into()],
+        };
+    }
+    if let Err(reason) = result_integrity(r) {
+        return Assessment {
+            status: "invalid-results".into(),
+            per_variant: vec![],
+            reasons: vec![reason],
+        };
+    }
+    let mut specs: Vec<&str> = r.end_to_end.iter().map(|t| t.spec.as_str()).collect();
+    specs.sort();
+    specs.dedup();
+    let mut reasons = Vec::new();
+    let mut per_variant = Vec::new();
+    for v in CANDIDATES {
+        let mut speed_pass = !specs.is_empty();
+        if specs.is_empty() {
+            reasons.push(format!("{v}: speed: no end-to-end rows"));
+        }
+        for spec in &specs {
+            for path in PATHS {
+                let row = r
+                    .end_to_end
+                    .iter()
+                    .find(|t| t.spec == *spec && t.path == path && t.activation == v);
+                match row {
+                    None => {
+                        speed_pass = false;
+                        reasons.push(format!("{v}: speed: no {path} row for spec {spec}"));
+                    }
+                    Some(t) => {
+                        if !(t.median_ratio <= c.speed_ratio_max && t.ci_hi < 1.0) {
+                            speed_pass = false;
+                            reasons.push(format!(
+                                "{v}: speed: spec {spec} {path} median ratio {:.3}, CI upper {:.3} \
+                             (needs median <= {} and CI upper < 1.0)",
+                                t.median_ratio, t.ci_hi, c.speed_ratio_max
+                            ));
+                        }
+                    }
+                }
+            }
+        }
+        let rows: Vec<&ValidationRow> = r
+            .fitness_validation
+            .iter()
+            .filter(|x| x.activation == v)
+            .collect();
+        let mut fitness_pass = !rows.is_empty();
+        if rows.is_empty() {
+            reasons.push(format!("{v}: fitness: no validation rows"));
+        }
+        let mut better = false;
+        for row in &rows {
+            let cell = format!("{v}: fitness: {} x {}", row.task, row.spec);
+            if let Some(why) = &row.excluded {
+                fitness_pass = false;
+                reasons.push(format!("{cell} excluded ({why})"));
+                continue;
+            }
+            let Some(p) = &row.paired_vs_control else {
+                fitness_pass = false;
+                reasons.push(format!("{cell} has no paired difference"));
+                continue;
+            };
+            let margin = if row.metric == "accuracy" {
+                c.fitness_margin_accuracy
+            } else {
+                c.fitness_margin_nmse
+            };
+            if p.median.is_nan() || p.median <= -margin {
+                fitness_pass = false;
+                reasons.push(format!(
+                    "{cell} median paired difference {:.4} is not above -{margin}",
+                    p.median
+                ));
+            }
+            if p.ci_lo > 0.0 {
+                better = true;
+            }
+        }
+        if c.fitness_better_required && !better && !rows.is_empty() {
+            fitness_pass = false;
+            reasons.push(format!(
+                "{v}: fitness: no task x spec with CI lower bound above 0"
+            ));
+        }
+        per_variant.push(VariantAssessment {
+            activation: v.to_string(),
+            speed_pass,
+            fitness_pass,
+            local_candidate: speed_pass && fitness_pass,
+        });
+    }
+    let any = per_variant.iter().any(|v| v.local_candidate);
+    let status = if any {
+        let me = platform();
+        let missing: Vec<&String> = c.required_platforms.iter().filter(|p| **p != me).collect();
+        reasons.push(format!(
+            "local candidate on {me}; still needs results from {missing:?}"
+        ));
+        "candidate-pending-platforms"
+    } else {
+        "no-candidate"
+    };
+    Assessment {
+        status: status.into(),
+        per_variant,
+        reasons,
+    }
+}
