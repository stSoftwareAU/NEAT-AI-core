+pub struct Manifest {
+    pub protocol_version: u32,
+    pub issue: u32,
+    pub source: String,
+    pub activations: Vec<String>,
+    pub control: String,
+    pub graph_specs: Vec<GraphSpec>,
+    pub timing: Timing,
+    pub fitness: Fitness,
+    pub bootstrap: Bootstrap,
+    pub criteria: Criteria,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub limits: Option<Limits>,
+}
+
+pub fn parse_manifest(text: &str) -> Result<Manifest, String> {
+    let m: Manifest = serde_json::from_str(text).map_err(|e| format!("manifest: {e}"))?;
+    if ![1, 2].contains(&m.protocol_version) {
+        return Err(format!(
+            "manifest: protocol_version must be 1 or 2, got {}",
+            m.protocol_version
+        ));
+    }
+    if m.activations.is_empty() {
+        return Err("manifest: activations is empty".into());
+    }
+    for a in &m.activations {
+        Act::parse(a).map_err(|e| format!("manifest: {e}"))?;
+    }
+    if !m.activations.contains(&m.control) {
+        return Err(format!(
+            "manifest: control '{}' is not in activations",
+            m.control
+        ));
+    }
+    if m.graph_specs.is_empty() {
+        return Err("manifest: graph_specs is empty".into());
+    }
+    for s in &m.graph_specs {
+        s.validate().map_err(|e| format!("manifest: {e}"))?;
+    }
+    let f = &m.fitness;
+    if m.protocol_version == 2 {
+        let limits = m
+            .limits
+            .as_ref()
+            .ok_or("manifest: v2 requires compute limits")?;
+        let fits = m.activations.len() as u64
+            * m.graph_specs.len() as u64
+            * f.tasks.len() as u64
+            * (f.input_scales.len() as u64 * f.calibration_seeds.len() as u64
+                + f.validation_seeds.len() as u64);
+        if limits.max_fits == 0
+            || fits > limits.max_fits
+            || !(1..=900).contains(&limits.max_wall_seconds)
+        {
+            return Err("manifest: compute limits exceeded (fits or wall seconds)".into());
+        }
+    }
+    for (name, seeds) in [
+        ("calibration", &f.calibration_seeds),
+        ("validation", &f.validation_seeds),
+    ] {
+        let unique: std::collections::BTreeSet<_> = seeds.iter().collect();
+        if unique.len() != seeds.len() {
+            return Err(format!("manifest: duplicate {name} seeds"));
+        }
+    }
+    for (name, names) in [
+        ("activations", m.activations.clone()),
+        (
+            "graph specs",
+            m.graph_specs.iter().map(|s| s.name.clone()).collect(),
+        ),
+        ("tasks", f.tasks.iter().map(Task::name).collect()),
+    ] {
+        let unique: std::collections::BTreeSet<_> = names.iter().collect();
+        if unique.len() != names.len() {
+            return Err(format!("manifest: duplicate {name}"));
+        }
+    }
+    if f.tasks.is_empty() || f.input_scales.is_empty() {
+        return Err("manifest: fitness needs tasks and input_scales".into());
+    }
+    for t in &f.tasks {
+        t.validate().map_err(|e| format!("manifest: {e}"))?;
+    }
+    if f.input_scales.iter().any(|s| !(*s > 0.0 && s.is_finite())) {
+        return Err("manifest: input_scales must be positive and finite".into());
+    }
+    if f.calibration_seeds.is_empty() || f.validation_seeds.is_empty() {
+        return Err("manifest: calibration_seeds and validation_seeds must be non-empty".into());
+    }
+    if let Some(s) = f
+        .calibration_seeds
+        .iter()
+        .find(|s| f.validation_seeds.contains(s))
+    {
+        return Err(format!(
+            "manifest: seed {s} is in both calibration_seeds and validation_seeds"
+        ));
+    }
+    if f.hidden_override == 0
+        || f.train == 0
+        || f.test == 0
+        || !f.ridge_lambda.is_finite()
+        || f.ridge_lambda < 0.0
+    {
+        return Err("manifest: fitness sizes must be >= 1 and ridge_lambda >= 0".into());
+    }
+    let t = &m.timing;
+    if t.records == 0 || t.micro_len == 0 || t.repetitions == 0 {
+        return Err("manifest: timing records, micro_len and repetitions must be >= 1".into());
+    }
+    if m.bootstrap.iters == 0 || !(0.0 < m.bootstrap.level && m.bootstrap.level < 1.0) {
+        return Err("manifest: bootstrap needs positive iters and 0 < level < 1".into());
+    }
+    Ok(m)
+}
