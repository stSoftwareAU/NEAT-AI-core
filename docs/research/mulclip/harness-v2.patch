+#[test]
+fn graph_generation_is_deterministic_and_well_formed() {
+    let s = heavy_spec();
+    assert_eq!(Graph::generate(&s, 1), Graph::generate(&s, 1));
+    assert_ne!(Graph::generate(&s, 1), Graph::generate(&s, 2));
+    let g = Graph::generate(&s, 3);
+    for j in 0..g.hidden {
+        let (st, n) = (g.start[j] as usize, g.len[j] as usize);
+        let src = &g.from[st..st + n];
+        assert!(src.iter().all(|&f| (f as usize) < g.inputs + j));
+        let mut u = src.to_vec();
+        u.sort();
+        u.dedup();
+        assert_eq!(u.len(), n, "sources are distinct");
+        // fan-in is within [min, max] but capped by the nodes available.
+        assert!(n >= 2.min(g.inputs + j) && n <= 40);
+    }
+    let u = GraphSpec {
+        name: "u".into(),
+        inputs: 3,
+        hidden: 6,
+        degree: Degree::Uniform { fan_in: 4 },
+    };
+    let g = Graph::generate(&u, 1);
+    for j in 0..6 {
+        assert_eq!(g.len[j] as usize, 4.min(3 + j));
+    }
+}
