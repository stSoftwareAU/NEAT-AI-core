@@ -0,0 +1,1962 @@
+//! Issue #760: opt-in, research-only harness benchmarking "MulClip" against
+//! tanh, hard-tanh and ReLU. Included by the example and the integration test
+//! with `#[path]`; it is not a bench target and changes nothing in `src`.
+#![allow(dead_code)]
+
+use neat_core::network::{CompiledNetwork, NeuronData, SynapseData};
+use neat_core::simd::{weighted_sum_interleaved_unchecked, weighted_sum_simd_unchecked};
+use neat_core::squash::{SquashType, apply_squash};
+use neat_core::squash_simd::squash_xn;
+use serde::{Deserialize, Serialize};
+use std::hint::black_box;
+use std::time::Instant;
+
+#[path = "../common/mod.rs"]
+mod common;
+
+// ---------------------------------------------------------------- MulClip
+
+/// MulClip from arXiv:2610.39343v1, Section II equations (1)-(3) and
+/// Appendix A: clip the input, then subtract `b * |xc|^(d-1) * xc`.
+/// Coefficients are rounded once from f64 to f32; operations stay separate
+/// (no FMA). A rounded clipping threshold can leave a small non-zero residual.
+#[derive(Clone, Copy, Debug)]
+pub struct MulClip {
+    pub d: u32,
+    pub b: f32,
+    pub c: f32,
+    pub peak: f32,
+}
+
+impl MulClip {
+    pub fn new(d: u32) -> Result<MulClip, String> {
+        if !(2..=8).contains(&d) {
+            return Err(format!(
+                "MulClip order {d} is outside the allowed range 2..=8"
+            ));
+        }
+        let df = d as f64;
+        let b = (df - 1.0).powi(d as i32 - 1) / df.powi(d as i32);
+        let c = df.powf(df / (df - 1.0)) / (df - 1.0);
+        let peak = df / (df - 1.0);
+        Ok(MulClip {
+            d,
+            b: b as f32,
+            c: c as f32,
+            peak: peak as f32,
+        })
+    }
+
+    /// |x|^(d-1) by repeated multiplication.
+    #[inline(always)]
+    fn pow_abs(&self, a: f32) -> f32 {
+        match self.d {
+            2 => a,
+            3 => a * a,
+            _ => {
+                let mut p = a;
+                for _ in 1..self.d - 1 {
+                    p *= a;
+                }
+                p
+            }
+        }
+    }
+
+    #[inline(always)]
+    fn poly(&self, x: f32) -> f32 {
+        x - (self.b * self.pow_abs(x.abs())) * x
+    }
+
+    /// NaN propagates; infinities clip to a finite endpoint before evaluation.
+    #[inline(always)]
+    pub fn apply(&self, x: f32) -> f32 {
+        self.poly(x.clamp(-self.c, self.c))
+    }
+
+    /// Ablation: clipped at the peak (saturates at +/-1) instead of the zero.
+    #[inline(always)]
+    pub fn apply_mono(&self, x: f32) -> f32 {
+        self.poly(x.clamp(-self.peak, self.peak))
+    }
+
+    /// Lane polynomial; generated SIMD must be inspected for each measured build.
+    #[inline(always)]
+    pub fn apply_lanes<const N: usize>(&self, x: [f32; N]) -> [f32; N] {
+        let mut o = [0.0f32; N];
+        for i in 0..N {
+            o[i] = self.apply(x[i]);
+        }
+        o
+    }
+
+    #[inline(always)]
+    pub fn apply_mono_lanes<const N: usize>(&self, x: [f32; N]) -> [f32; N] {
+        let mut o = [0.0f32; N];
+        for i in 0..N {
+            o[i] = self.apply_mono(x[i]);
+        }
+        o
+    }
+
+    /// `1 - d*b*|x|^(d-1)` inside `|x| < c`, else 0.
+    pub fn derivative(&self, x: f32) -> f32 {
+        if x.abs() >= self.c {
+            0.0
+        } else {
+            1.0 - self.d as f32 * self.b * self.pow_abs(x.abs())
+        }
+    }
+}
+
+// ------------------------------------------------------------ activations
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Act {
+    Tanh,
+    HardTanh,
+    Relu,
+    MulClip(u32),
+    MulClipMono(u32),
+}
+
+impl Act {
+    pub fn name(&self) -> String {
+        match self {
+            Act::Tanh => "tanh".into(),
+            Act::HardTanh => "hard_tanh".into(),
+            Act::Relu => "relu".into(),
+            Act::MulClip(d) => format!("mulclip_d{d}"),
+            Act::MulClipMono(d) => format!("mulclip_mono_d{d}"),
+        }
+    }
+
+    pub fn parse(s: &str) -> Result<Act, String> {
+        let order = |rest: &str| -> Result<u32, String> {
+            let d: u32 = rest
+                .parse()
+                .map_err(|_| format!("unknown activation '{s}'"))?;
+            MulClip::new(d)?;
+            Ok(d)
+        };
+        match s {
+            "tanh" => Ok(Act::Tanh),
+            "hard_tanh" => Ok(Act::HardTanh),
+            "relu" => Ok(Act::Relu),
+            _ => {
+                if let Some(rest) = s.strip_prefix("mulclip_mono_d") {
+                    Ok(Act::MulClipMono(order(rest)?))
+                } else if let Some(rest) = s.strip_prefix("mulclip_d") {
+                    Ok(Act::MulClip(order(rest)?))
+                } else {
+                    Err(format!("unknown activation '{s}'"))
+                }
+            }
+        }
+    }
+}
+
+/// An activation with its coefficients built once, for the hot loops.
+#[derive(Clone, Copy, Debug)]
+pub struct Prepared {
+    pub act: Act,
+    pub mc: Option<MulClip>,
+}
+
+impl Prepared {
+    pub fn new(act: Act) -> Result<Prepared, String> {
+        let mc = match act {
+            Act::MulClip(d) | Act::MulClipMono(d) => Some(MulClip::new(d)?),
+            _ => None,
+        };
+        Ok(Prepared { act, mc })
+    }
+
+    pub fn from_name(s: &str) -> Result<Prepared, String> {
+        Prepared::new(Act::parse(s)?)
+    }
+
+    #[inline]
+    pub fn apply(&self, x: f32) -> f32 {
+        match self.act {
+            Act::Tanh => apply_squash(SquashType::Tanh, x),
+            Act::HardTanh => apply_squash(SquashType::HardTanh, x),
+            Act::Relu => apply_squash(SquashType::Relu, x),
+            Act::MulClip(_) => self.mc.as_ref().expect("prepared MulClip").apply(x),
+            Act::MulClipMono(_) => self.mc.as_ref().expect("prepared MulClip").apply_mono(x),
+        }
+    }
+
+    #[inline]
+    pub fn apply_lanes<const N: usize>(&self, x: [f32; N]) -> [f32; N] {
+        match self.act {
+            Act::Tanh => squash_xn::<N>(SquashType::Tanh, x).expect("squash_xn supports Tanh"),
+            Act::HardTanh => {
+                squash_xn::<N>(SquashType::HardTanh, x).expect("squash_xn supports HardTanh")
+            }
+            // squash_xn returns None for Relu, so use a per-lane apply_squash loop.
+            Act::Relu => {
+                let mut o = [0.0f32; N];
+                for i in 0..N {
+                    o[i] = apply_squash(SquashType::Relu, x[i]);
+                }
+                o
+            }
+            Act::MulClip(_) => self.mc.as_ref().expect("prepared MulClip").apply_lanes(x),
+            Act::MulClipMono(_) => self
+                .mc
+                .as_ref()
+                .expect("prepared MulClip")
+                .apply_mono_lanes(x),
+        }
+    }
+}
+
+// -------------------------------------------------------------------- Rng
+
+/// SplitMix64.
+#[derive(Clone, Debug)]
+pub struct Rng {
+    state: u64,
+}
+
+impl Rng {
+    pub fn new(seed: u64) -> Rng {
+        Rng { state: seed }
+    }
+
+    pub fn next_u64(&mut self) -> u64 {
+        self.state = self.state.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.state;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+
+    /// Uniform in [0, 1).
+    pub fn next_f64(&mut self) -> f64 {
+        (self.next_u64() >> 11) as f64 / (1u64 << 53) as f64
+    }
+
+    /// Standard normal by Box-Muller.
+    pub fn normal(&mut self) -> f64 {
+        let u1 = 1.0 - self.next_f64();
+        let u2 = self.next_f64();
+        (-2.0 * u1.ln()).sqrt() * (2.0 * std::f64::consts::PI * u2).cos()
+    }
+
+    fn below(&mut self, n: usize) -> usize {
+        (self.next_u64() % n as u64) as usize
+    }
+}
+
+// ----------------------------------------------------------------- graphs
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Degree {
+    Uniform { fan_in: u32 },
+    HeavyTail { min: u32, max: u32, alpha: f64 },
+    CoreFixture { label: String },
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct GraphSpec {
+    pub name: String,
+    pub inputs: u32,
+    pub hidden: u32,
+    pub degree: Degree,
+}
+
+impl GraphSpec {
+    pub fn validate(&self) -> Result<(), String> {
+        let n = &self.name;
+        if self.inputs == 0 || self.hidden == 0 {
+            return Err(format!("graph spec '{n}': inputs and hidden must be >= 1"));
+        }
+        if self.inputs as usize + self.hidden as usize > 65536 {
+            return Err(format!("graph spec '{n}': exceeds core node limit"));
+        }
+        if let Degree::CoreFixture { ref label } = self.degree {
+            let fixture = common::NETWORKS
+                .iter()
+                .find(|s| s.label == label)
+                .ok_or_else(|| format!("graph spec '{n}': unknown core fixture {label}"))?;
+            if self.inputs as usize != fixture.num_inputs
+                || self.hidden as usize != fixture.num_non_inputs()
+            {
+                return Err(format!(
+                    "graph spec '{n}': dimensions disagree with core fixture"
+                ));
+            }
+        }
+        match self.degree {
+            Degree::Uniform { fan_in: 0 } => Err(format!("graph spec '{n}': fan_in must be >= 1")),
+            Degree::HeavyTail { min, max, alpha } => {
+                if min == 0 || min > max || !(alpha > 1.0 && alpha.is_finite()) {
+                    Err(format!(
+                        "graph spec '{n}': heavy_tail needs 1 <= min <= max and alpha > 1"
+                    ))
+                } else {
+                    Ok(())
+                }
+            }
+            _ => Ok(()),
+        }
+    }
+}
+
+/// Forward-only DAG in CSR form. Ids `0..inputs` are inputs; hidden node `j`
+/// has id `inputs + j`.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Graph {
+    pub inputs: usize,
+    pub hidden: usize,
+    pub start: Vec<u32>,
+    pub len: Vec<u32>,
+    pub from: Vec<u32>,
+    pub weight: Vec<f32>,
+    pub bias: Vec<f32>,
+}
+
+impl Graph {
+    pub fn generate(spec: &GraphSpec, seed: u64) -> Graph {
+        if let Degree::CoreFixture { ref label } = spec.degree {
+            let fixture = common::NETWORKS
+                .iter()
+                .find(|s| s.label == label)
+                .expect("validated fixture label");
+            let net = common::build_network(fixture, seed);
+            return Self::from_network(&net);
+        }
+        let mut rng = Rng::new(seed);
+        let inputs = spec.inputs as usize;
+        let hidden = spec.hidden as usize;
+        let mut g = Graph {
+            inputs,
+            hidden,
+            start: Vec::with_capacity(hidden),
+            len: Vec::with_capacity(hidden),
+            from: Vec::new(),
+            weight: Vec::new(),
+            bias: Vec::with_capacity(hidden),
+        };
+        for j in 0..hidden {
+            let avail = inputs + j;
+            let k = match spec.degree {
+                Degree::Uniform { fan_in } => fan_in as usize,
+                Degree::HeavyTail { min, max, alpha } => {
+                    let v = 1.0 - rng.next_f64();
+                    let k = (min as f64 * v.powf(-1.0 / (alpha - 1.0))).floor();
+                    k.min(max as f64) as usize
+                }
+                Degree::CoreFixture { .. } => unreachable!("handled above"),
+            };
+            let fan_in = k.min(avail);
+            // Partial Fisher-Yates: `fan_in` distinct sources below this node.
+            let mut pool: Vec<u32> = (0..avail as u32).collect();
+            g.start.push(g.from.len() as u32);
+            g.len.push(fan_in as u32);
+            let scale = 1.0 / (fan_in.max(1) as f64).sqrt();
+            for i in 0..fan_in {
+                let r = i + rng.below(avail - i);
+                pool.swap(i, r);
+                g.from.push(pool[i]);
+                g.weight.push((rng.normal() * scale) as f32);
+            }
+            g.bias.push((rng.normal() * 0.1) as f32);
+        }
+        g
+    }
+
+    fn from_network(net: &CompiledNetwork) -> Graph {
+        Graph {
+            inputs: net.num_inputs(),
+            hidden: net.neurons().len(),
+            start: net.neurons().iter().map(|n| n.start_synapse).collect(),
+            len: net
+                .neurons()
+                .iter()
+                .map(|n| u32::from(n.num_synapses))
+                .collect(),
+            from: net.hot_from().iter().map(|&x| u32::from(x)).collect(),
+            weight: net.hot_weights().to_vec(),
+            bias: net.neurons().iter().map(|n| n.bias).collect(),
+        }
+    }
+
+    /// Validate once, then use core's own scalar and record-interleaved kernels.
+    pub fn compile(&self, squash: SquashType) -> CompiledNetwork {
+        let neurons = (0..self.hidden)
+            .map(|j| NeuronData {
+                bias: self.bias[j],
+                start_synapse: self.start[j],
+                num_synapses: self.len[j].try_into().expect("fan-in fits u16"),
+                squash_type: squash as u8,
+                is_constant: false,
+            })
+            .collect();
+        let synapses = self
+            .from
+            .iter()
+            .zip(&self.weight)
+            .map(|(&from, &weight)| SynapseData {
+                from_index: from.try_into().expect("node index fits u16"),
+                weight,
+                synapse_type: 0,
+            })
+            .collect();
+        CompiledNetwork::from_parts(self.inputs, neurons, synapses).expect("valid forward graph")
+    }
+}
+
+pub fn core_forward_scalar(
+    net: &CompiledNetwork,
+    p: &Prepared,
+    input: &[f32],
+    acts: &mut Vec<f32>,
+) {
+    acts.resize(net.num_neurons(), 0.0);
+    acts.fill(0.0);
+    acts[..net.num_inputs()].copy_from_slice(input);
+    for (j, n) in net.neurons().iter().enumerate() {
+        let start = n.start_synapse as usize;
+        // SAFETY: CompiledNetwork::from_parts validated every index and span;
+        // acts has exactly num_neurons entries and the network is immutable.
+        let sum = unsafe {
+            weighted_sum_simd_unchecked(
+                net.synapses(),
+                acts,
+                start,
+                start + n.num_synapses as usize,
+                n.bias,
+            )
+        };
+        acts[net.num_inputs() + j] = p.apply(sum);
+    }
+}
+
+pub fn core_forward_lanes(
+    net: &CompiledNetwork,
+    p: &Prepared,
+    input: &[&[f32]; 8],
+    inter: &mut Vec<f32>,
+) {
+    inter.resize(net.num_neurons() * 8, 0.0);
+    inter.fill(0.0);
+    for i in 0..net.num_inputs() {
+        for lane in 0..8 {
+            inter[i * 8 + lane] = input[lane][i];
+        }
+    }
+    for (j, n) in net.neurons().iter().enumerate() {
+        let start = n.start_synapse as usize;
+        // SAFETY: CompiledNetwork::from_parts validated indices and spans;
+        // inter has num_neurons complete 8-record tiles.
+        let sum = unsafe {
+            weighted_sum_interleaved_unchecked::<8>(
+                net.hot_weights(),
+                net.hot_from(),
+                inter,
+                start,
+                start + n.num_synapses as usize,
+                n.bias,
+            )
+        };
+        let out = p.apply_lanes(sum);
+        let base = (net.num_inputs() + j) * 8;
+        inter[base..base + 8].copy_from_slice(&out);
+    }
+}
+
+pub fn forward_scalar(
+    g: &Graph,
+    p: &Prepared,
+    input_scale: f32,
+    input: &[f32],
+    acts: &mut Vec<f32>,
+) {
+    acts.clear();
+    acts.resize(g.inputs + g.hidden, 0.0);
+    for i in 0..g.inputs {
+        acts[i] = input.get(i).copied().unwrap_or(0.0) * input_scale;
+    }
+    for j in 0..g.hidden {
+        let s = g.start[j] as usize;
+        let mut sum = g.bias[j];
+        for e in s..s + g.len[j] as usize {
+            sum += g.weight[e] * acts[g.from[e] as usize];
+        }
+        acts[g.inputs + j] = p.apply(sum);
+    }
+}
+
+pub fn forward_lanes<const N: usize>(
+    g: &Graph,
+    p: &Prepared,
+    input_scale: f32,
+    records: &[&[f32]; N],
+    acts: &mut Vec<[f32; N]>,
+) {
+    acts.clear();
+    acts.resize(g.inputs + g.hidden, [0.0; N]);
+    for i in 0..g.inputs {
+        for l in 0..N {
+            acts[i][l] = records[l].get(i).copied().unwrap_or(0.0) * input_scale;
+        }
+    }
+    for j in 0..g.hidden {
+        let s = g.start[j] as usize;
+        let mut sum = [g.bias[j]; N];
+        for e in s..s + g.len[j] as usize {
+            let w = g.weight[e];
+            let a = acts[g.from[e] as usize];
+            for l in 0..N {
+                sum[l] += w * a[l];
+            }
+        }
+        acts[g.inputs + j] = p.apply_lanes(sum);
+    }
+}
+
+// ------------------------------------------------------------- statistics
+
+/// Type-7 quantile of an ascending slice.
+pub fn quantile(sorted: &[f64], p: f64) -> f64 {
+    let n = sorted.len();
+    if n == 0 {
+        return 0.0;
+    }
+    let h = (n - 1) as f64 * p;
+    let lo = h.floor() as usize;
+    let hi = (lo + 1).min(n - 1);
+    sorted[lo] + (h - lo as f64) * (sorted[hi] - sorted[lo])
+}
+
+pub fn median(values: &[f64]) -> f64 {
+    let mut v = values.to_vec();
+    v.sort_by(|a, b| a.total_cmp(b));
+    quantile(&v, 0.5)
+}
+
+/// Percentile bootstrap CI of the median; `(0, 0)` for empty input.
+pub fn bootstrap_median_ci(values: &[f64], iters: u32, seed: u64, level: f64) -> (f64, f64) {
+    if values.is_empty() {
+        return (0.0, 0.0);
+    }
+    let mut rng = Rng::new(seed);
+    let mut meds = Vec::with_capacity(iters as usize);
+    let mut buf = vec![0.0; values.len()];
+    for _ in 0..iters {
+        for b in buf.iter_mut() {
+            *b = values[rng.below(values.len())];
+        }
+        meds.push(median(&buf));
+    }
+    meds.sort_by(|a, b| a.total_cmp(b));
+    let tail = (1.0 - level) / 2.0;
+    (quantile(&meds, tail), quantile(&meds, 1.0 - tail))
+}
+
+// ------------------------------------------------------------------ ridge
+
+/// Ridge regression by the normal equations `(XtX + lambda I) w = Xty`,
+/// solved by Cholesky.
+pub fn ridge_fit(x_rows: &[Vec<f64>], y: &[f64], lambda: f64) -> Result<Vec<f64>, String> {
+    if x_rows.is_empty() || x_rows.len() != y.len() {
+        return Err("ridge_fit: need equal, non-empty rows and targets".into());
+    }
+    let p = x_rows[0].len();
+    let mut a = vec![0.0f64; p * p];
+    let mut b = vec![0.0f64; p];
+    for (r, &t) in x_rows.iter().zip(y) {
+        for i in 0..p {
+            b[i] += r[i] * t;
+            for j in 0..=i {
+                a[i * p + j] += r[i] * r[j];
+            }
+        }
+    }
+    for i in 0..p {
+        a[i * p + i] += lambda;
+    }
+    for i in 0..p {
+        for j in 0..=i {
+            let mut s = a[i * p + j];
+            for k in 0..j {
+                s -= a[i * p + k] * a[j * p + k];
+            }
+            if i == j {
+                if !(s > 0.0 && s.is_finite()) {
+                    return Err(format!(
+                        "ridge_fit: matrix is not positive definite (pivot {i} = {s})"
+                    ));
+                }
+                a[i * p + i] = s.sqrt();
+            } else {
+                a[i * p + j] = s / a[j * p + j];
+            }
+        }
+    }
+    let mut z = b;
+    for i in 0..p {
+        let mut s = z[i];
+        for k in 0..i {
+            s -= a[i * p + k] * z[k];
+        }
+        z[i] = s / a[i * p + i];
+    }
+    for i in (0..p).rev() {
+        let mut s = z[i];
+        for k in i + 1..p {
+            s -= a[k * p + i] * z[k];
+        }
+        z[i] = s / a[i * p + i];
+    }
+    Ok(z)
+}
+
+// ------------------------------------------------------------------ tasks
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub enum Task {
+    Parity { bits: u32 },
+    Smooth { inputs: u32 },
+}
+
+impl Task {
+    pub fn name(&self) -> String {
+        match self {
+            Task::Parity { bits } => format!("parity{bits}"),
+            Task::Smooth { inputs } => format!("smooth{inputs}"),
+        }
+    }
+
+    pub fn input_count(&self) -> u32 {
+        match self {
+            Task::Parity { bits } => *bits,
+            Task::Smooth { inputs } => *inputs,
+        }
+    }
+
+    /// "accuracy" (higher is better) or "nmse" (lower is better).
+    pub fn metric(&self) -> &'static str {
+        match self {
+            Task::Parity { .. } => "accuracy",
+            Task::Smooth { .. } => "nmse",
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), String> {
+        match self {
+            Task::Parity { bits } if *bits == 0 || *bits > 20 => {
+                Err(format!("parity task needs 1..=20 bits, got {bits}"))
+            }
+            Task::Smooth { inputs } if *inputs < 3 => {
+                Err(format!("smooth task needs inputs >= 3, got {inputs}"))
+            }
+            _ => Ok(()),
+        }
+    }
+
+    fn sample(&self, rng: &mut Rng) -> (Vec<f32>, f64) {
+        match self {
+            Task::Parity { bits } => {
+                let x: Vec<f32> = (0..*bits)
+                    .map(|_| if rng.next_u64() & 1 == 0 { -1.0 } else { 1.0 })
+                    .collect();
+                let t = x.iter().fold(1.0f64, |a, &v| a * v as f64);
+                (x, t)
+            }
+            Task::Smooth { inputs } => {
+                let x: Vec<f32> = (0..*inputs)
+                    .map(|_| (rng.next_f64() * 2.0 - 1.0) as f32)
+                    .collect();
+                let (x0, x1, x2) = (x[0] as f64, x[1] as f64, x[2] as f64);
+                let t = (std::f64::consts::PI * x0).sin() * x1 + 0.5 * x2 * x2;
+                (x, t)
+            }
+        }
+    }
+}
+
+pub struct Dataset {
+    pub train_x: Vec<Vec<f32>>,
+    pub train_y: Vec<f64>,
+    pub test_x: Vec<Vec<f32>>,
+    pub test_y: Vec<f64>,
+}
+
+pub fn make_dataset(task: &Task, seed: u64, train: usize, test: usize) -> Dataset {
+    let mut rng = Rng::new(seed);
+    let mut ds = Dataset {
+        train_x: Vec::new(),
+        train_y: Vec::new(),
+        test_x: Vec::new(),
+        test_y: Vec::new(),
+    };
+    for _ in 0..train {
+        let (x, y) = task.sample(&mut rng);
+        ds.train_x.push(x);
+        ds.train_y.push(y);
+    }
+    for _ in 0..test {
+        let (x, y) = task.sample(&mut rng);
+        ds.test_x.push(x);
+        ds.test_y.push(y);
+    }
+    ds
+}
+
+#[derive(Debug)]
+pub enum EvalError {
+    NonFinite(String),
+    Fit(String),
+}
+
+impl EvalError {
+    pub fn reason(&self) -> String {
+        match self {
+            EvalError::NonFinite(s) | EvalError::Fit(s) => s.clone(),
+        }
+    }
+}
+
+pub fn fmt_f32(x: f32) -> String {
+    if x.is_nan() {
+        "NaN".into()
+    } else if x == f32::INFINITY {
+        "inf".into()
+    } else if x == f32::NEG_INFINITY {
+        "-inf".into()
+    } else {
+        format!("{x:?}")
+    }
+}
+
+fn features(
+    g: &Graph,
+    p: &Prepared,
+    scale: f32,
+    x: &[f32],
+    acts: &mut Vec<f32>,
+) -> Result<Vec<f64>, EvalError> {
+    forward_scalar(g, p, scale, x, acts);
+    let h = &acts[g.inputs..];
+    if let Some(i) = h.iter().position(|v| !v.is_finite()) {
+        return Err(EvalError::NonFinite(format!(
+            "hidden node {i} produced {} for a finite input",
+            fmt_f32(h[i])
+        )));
+    }
+    let mut f: Vec<f64> = h.iter().map(|&v| v as f64).collect();
+    f.push(1.0);
+    Ok(f)
+}
+
+/// Fit the readout on the train split and score the test split.
+pub fn evaluate(
+    task: &Task,
+    g: &Graph,
+    ds: &Dataset,
+    p: &Prepared,
+    scale: f32,
+    lambda: f64,
+) -> Result<f64, EvalError> {
+    let mut acts = Vec::new();
+    let mut rows = Vec::with_capacity(ds.train_x.len());
+    for x in &ds.train_x {
+        rows.push(features(g, p, scale, x, &mut acts)?);
+    }
+    let w = ridge_fit(&rows, &ds.train_y, lambda).map_err(EvalError::Fit)?;
+    let mut preds = Vec::with_capacity(ds.test_x.len());
+    for x in &ds.test_x {
+        let f = features(g, p, scale, x, &mut acts)?;
+        preds.push(f.iter().zip(&w).map(|(a, b)| a * b).sum::<f64>());
+    }
+    let n = preds.len() as f64;
+    match task {
+        Task::Parity { .. } => {
+            let ok = preds
+                .iter()
+                .zip(&ds.test_y)
+                .filter(|(p, t)| (if **p >= 0.0 { 1.0 } else { -1.0 }) == **t)
+                .count();
+            Ok(ok as f64 / n)
+        }
+        Task::Smooth { .. } => {
+            let mean = ds.test_y.iter().sum::<f64>() / n;
+            let var = ds.test_y.iter().map(|t| (t - mean).powi(2)).sum::<f64>() / n;
+            let mse = preds
+                .iter()
+                .zip(&ds.test_y)
+                .map(|(p, t)| (p - t).powi(2))
+                .sum::<f64>()
+                / n;
+            Ok(mse / var.max(1e-12))
+        }
+    }
+}
